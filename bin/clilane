TMUX_VERSION_PATTERN = re.compile(r"(\d+)\.(\d+)")


class CliLaneError(Exception):
    pass


class FleetSignal(Exception):
    def __init__(self, signum: int) -> None:
        self.signum = signum


@dataclass(frozen=True)
class Task:
    session: str
    pane: str
    id: str
    name: str
    command: list[str]
    cwd: str
    created: str
    log: str
    committed: bool
    process_started: str | None
    stop_requested: bool
    dead: bool
    exit_code: int | None
    signal_name: str | None
    pid: int | None
    attached: bool

    @property
    def state(self) -> str:
        if not self.committed:
            return TASK_STATE_INITIALIZING
        if not self.dead:
            return TASK_STATE_RUNNING
        if self.stop_requested:
            return TASK_STATE_STOPPED
        if self.signal_name:
            return TASK_STATE_FAILED
        if self.exit_code == 0:
            return TASK_STATE_SUCCEEDED
        return TASK_STATE_FAILED

    @property
    def result_code(self) -> int:
        if self.signal_name:
            number = getattr(signal, self.signal_name, None)
            if isinstance(number, int):
                return 128 + number
            return 1
        return self.exit_code if self.exit_code is not None else 1

    def as_dict(self) -> dict[str, object]:
        return {
            "id": self.id,
            "name": self.name,
            "state": self.state,
            "command": self.command,
            "cwd": self.cwd,
            "created": self.created,
            "log": self.log,
            "pid": self.pid if not self.dead else None,
            "attached": self.attached,
            "exit_code": self.exit_code if self.dead else None,
            "signal": self.signal_name if self.dead else None,
        }


@dataclass(frozen=True)
class RunSpec:
    cwd: str
    wait: bool
    timeout: float | None
    on_exit: str | None
    command: list[str]


@dataclass(frozen=True)
class FleetHost:
    name: str
    transport: str
    destination: str | None


@dataclass(frozen=True)
class FleetResult:
    name: str
    status: str
    clilane_version: str | None
    tasks: list[dict[str, object]]
    error_kind: str | None
    error_message: str | None

    def as_dict(self) -> dict[str, object]:
        error = None
        if self.error_kind and self.error_message:
            error = {"kind": self.error_kind, "message": self.error_message}
        return {
            "name": self.name,
            "status": self.status,
            "clilane_version": self.clilane_version,
            "tasks": self.tasks,
            "error": error,
        }


def tmux_binary() -> str:
    binary = shutil.which("tmux")
    if not binary:
        raise CliLaneError("tmux is required")
    return binary


def ensure_tmux_version() -> None:
    completed = subprocess.run(
        [tmux_binary(), "-V"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=tmux_client_environment(),
        check=False,
    )
    reported = completed.stdout.decode(errors="replace").strip()
    matched = TMUX_VERSION_PATTERN.search(reported)
    if completed.returncode != 0 or not matched:
        raise CliLaneError(f"could not determine the tmux version: {reported!r}")
    version = (int(matched.group(1)), int(matched.group(2)))
    if version < TMUX_MIN_VERSION:
        floor = ".".join(str(part) for part in TMUX_MIN_VERSION)
        raise CliLaneError(
            f"tmux {floor} or newer is required for exit-status reporting; "
            f"found {reported}"
        )


def tmux_client_environment() -> dict[str, str]:
    return {
        key: value
        for key, value in os.environ.items()
        if key in TMUX_ENV_KEYS or key.startswith("LC_")
    }


def tmux(
    arguments: Sequence[str],
    *,
    input_data: bytes | None = None,
    check: bool = True,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[bytes]:
    try:
        completed = subprocess.run(
            [tmux_binary(), "-L", SOCKET, "-f", "/dev/null", *arguments],
            input=input_data,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=tmux_client_environment(),
            check=False,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise CliLaneError(f"tmux timed out after {timeout:g} seconds") from error
    if check and completed.returncode != 0:
        detail = completed.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or f"tmux exited {completed.returncode}")
    return completed


def tmux_server_absent(completed: subprocess.CompletedProcess[bytes]) -> bool:
    detail = completed.stderr.decode(errors="replace").lower()
    return "no server running" in detail or (
        "error connecting to " in detail and "no such file or directory" in detail
    )


def state_root() -> Path:
    configured = os.environ.get("CLILANE_STATE_HOME") or os.environ.get("AGT_STATE_HOME")
    if configured:
        root = Path(configured).expanduser()
    elif os.environ.get("XDG_STATE_HOME"):
        root = Path(os.environ["XDG_STATE_HOME"]).expanduser() / PROGRAM
    else:
        root = Path.home() / ".local" / "state" / PROGRAM
    if not root.is_absolute():
        raise CliLaneError(
            "CLILANE_STATE_HOME, AGT_STATE_HOME, and XDG_STATE_HOME must be absolute"
        )
    root = root.resolve()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    return root


def fleet_config_path(configured: str | None) -> Path:
    if configured:
        return Path(configured).expanduser().resolve()
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        root = Path(xdg).expanduser()
        if not root.is_absolute():
            raise CliLaneError("XDG_CONFIG_HOME must be absolute")
    else:
        root = Path.home() / ".config"
    return (root / PROGRAM / "fleet.json").resolve()


def fleet_name(value: object, field: str) -> str:
    if not isinstance(value, str) or not NAME_PATTERN.fullmatch(value):
        raise CliLaneError(
            f"{field} must be 1-64 characters, beginning with a letter or number "
            "and using only letters, numbers, dot, dash, or underscore"
        )
    return value


def reject_json_constant(value: str) -> object:
    raise ValueError(f"invalid JSON constant: {value}")


def finite_json_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed):
        raise ValueError(f"non-finite JSON number: {value}")
    return parsed


def bounded_json_int(value: str) -> int:
    if len(value.removeprefix("-")) > FLEET_MAX_INTEGER_DIGITS:
        raise ValueError("JSON integer is too large")
    return int(value)


def load_fleet_hosts(configured: str | None) -> list[FleetHost]:
    path = fleet_config_path(configured)
    if not path.is_file():
        raise CliLaneError(
            f"fleet config not found: {str(path)!r}; create it or pass --config FILE"
        )
    try:
        document = json.loads(
            path.read_text(encoding="utf-8"),
            parse_constant=reject_json_constant,
            parse_float=finite_json_float,
            parse_int=bounded_json_int,
        )
    except UnicodeDecodeError as error:
        raise CliLaneError(f"fleet config is not UTF-8: {str(path)!r}") from error
    except (json.JSONDecodeError, RecursionError, ValueError) as error:
        raise CliLaneError(
            f"invalid fleet config JSON: {str(path)!r}: {error}"
        ) from error
    if not isinstance(document, dict):
        raise CliLaneError("fleet config must be a JSON object")
    expected_root = {"schema_version", "hosts"}
    unexpected_root = set(document) - expected_root
    if unexpected_root:
        raise CliLaneError(
            f"unexpected fleet config field: {sorted(unexpected_root)[0]!r}"
        )
    if set(document) != expected_root:
        missing = sorted(expected_root - set(document))[0]
        raise CliLaneError(f"missing fleet config field: {missing}")
    schema_version = document["schema_version"]
    if (
        type(schema_version) is not int
        or schema_version != FLEET_CONFIG_SCHEMA_VERSION
    ):
        raise CliLaneError(
            f"unsupported fleet config schema_version: {schema_version!r}"
        )
    entries = document["hosts"]
    if not isinstance(entries, list) or not entries:
        raise CliLaneError("fleet config hosts must be a non-empty array")
    if len(entries) > FLEET_MAX_HOSTS:
        raise CliLaneError(f"fleet config supports at most {FLEET_MAX_HOSTS} hosts")
    hosts: list[FleetHost] = []
    names: set[str] = set()
    local_count = 0
    for index, entry in enumerate(entries):
        if not isinstance(entry, dict):
            raise CliLaneError(f"fleet host {index + 1} must be a JSON object")
        transport = entry.get("transport")
        expected = {"name", "transport"}
        if transport == "ssh":
            expected.add("destination")
        elif transport != "local":
            raise CliLaneError(f"unsupported fleet transport for host {index + 1}")
        unexpected = set(entry) - expected
        if unexpected:
            raise CliLaneError(
                f"unexpected field for fleet host {index + 1}: {sorted(unexpected)[0]!r}"
            )
        if set(entry) != expected:
            missing = sorted(expected - set(entry))[0]
            raise CliLaneError(f"missing field for fleet host {index + 1}: {missing}")
        name = fleet_name(entry["name"], f"fleet host {index + 1} name")
        if name in names:
            raise CliLaneError(f"duplicate fleet host name: {name}")
        names.add(name)
        destination = None
        if transport == "local":
            local_count += 1
        else:
            destination = fleet_name(
                entry["destination"], f"fleet host {index + 1} destination"
            )
        hosts.append(FleetHost(name, transport, destination))
    if local_count != 1:
        raise CliLaneError("fleet config must contain exactly one local host")
    return hosts


def legacy_state_roots() -> tuple[Path, ...]:
    roots = [Path.home() / ".local" / "state" / "agt"]
    configured = os.environ.get("AGT_STATE_HOME")
    if configured:
        candidate = Path(configured).expanduser()
        if candidate.is_absolute():
            roots.append(candidate)
    xdg = os.environ.get("XDG_STATE_HOME")
    if xdg:
        candidate = Path(xdg).expanduser()
        if candidate.is_absolute():
            roots.append(candidate / "agt")
    return tuple(root.resolve() for root in roots)


def control_root() -> Path:
    root = (state_root() / "control").resolve()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    return root


def socket_digest() -> str:
    return hashlib.sha256(SOCKET.encode()).hexdigest()[:16]


def registry_root() -> Path:
    root = (state_root() / "registry" / socket_digest()).resolve()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    return root


@dataclass(frozen=True)
class TaskRecord:
    id: str
    name: str
    command: list[str]
    cwd: str
    created: str
    log: str
    session: str
    socket: str
    phase: str
    path: str


def write_record(
    task_id: str,
    name: str,
    command: Sequence[str],
    cwd: str,
    created: str,
    log: str,
    session: str,
    phase: str,
) -> None:
    payload = {
        "schema_version": RECORD_SCHEMA_VERSION,
        "socket": SOCKET,
        "session": session,
        "id": task_id,
        "name": name,
        "command": list(command),
        "cwd": cwd,
        "created": created,
        "log": log,
        "phase": phase,
    }
    root = registry_root()
    final = root / f"{task_id}.json"
    temp = root / f".{task_id}.{uuid.uuid4().hex}.tmp"
    descriptor = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), allow_nan=False))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, final)
    finally:
        temp.unlink(missing_ok=True)
    directory = os.open(root, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def delete_record(task_id: str) -> None:
    root = registry_root()
    (root / f"{task_id}.json").unlink(missing_ok=True)
    for leftover in root.glob(f".{task_id}.*.tmp"):
        leftover.unlink(missing_ok=True)


def read_record(path: Path) -> TaskRecord:
    try:
        decoded = json.loads(
            path.read_text(encoding="utf-8"),
            parse_constant=reject_json_constant,
            parse_float=finite_json_float,
            parse_int=bounded_json_int,
        )
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RecursionError, ValueError) as error:
        raise CliLaneError(f"damaged task record: {str(path)!r}") from error
    if not isinstance(decoded, dict) or set(decoded) != set(RECORD_FIELDS):
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    if decoded["schema_version"] != RECORD_SCHEMA_VERSION:
        raise CliLaneError(f"unsupported task record schema: {str(path)!r}")
    for field in ("socket", "session", "id", "name", "cwd", "created", "log", "phase"):
        if not isinstance(decoded[field], str):
            raise CliLaneError(f"damaged task record: {str(path)!r}")
    command = decoded["command"]
    if not isinstance(command, list) or not command or not all(
        isinstance(part, str) for part in command
    ):
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    if decoded["phase"] not in RECORD_PHASES:
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    if decoded["id"] != path.stem:
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    derived = f"{SESSION_PREFIX}{decoded['id'].replace('-', '')[:12]}"
    if decoded["session"] != derived:
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    return TaskRecord(
        id=decoded["id"],
        name=decoded["name"],
        command=command,
        cwd=decoded["cwd"],
        created=decoded["created"],
        log=decoded["log"],
        session=decoded["session"],
        socket=decoded["socket"],
        phase=decoded["phase"],
        path=str(path),
    )


def read_records() -> tuple[list[TaskRecord], list[Path]]:
    records: list[TaskRecord] = []
    damaged: list[Path] = []
    for path in sorted(registry_root().glob("*.json")):
        try:
            record = read_record(path)
        except CliLaneError:
            damaged.append(path)
            continue
        if record.socket == SOCKET:
            records.append(record)
    return records, damaged


def claimed_log_paths() -> set[Path]:
    claimed: set[Path] = set()
    registry = (state_root() / "registry").resolve()
    if not registry.is_dir():
        return claimed
    for path in registry.glob("*/*.json"):
        try:
            decoded = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError, RecursionError):
            continue
        if isinstance(decoded, dict) and isinstance(decoded.get("log"), str):
            claimed.add(Path(decoded["log"]).expanduser().resolve())
    return claimed


def record_from_task(task: Task, phase: str) -> None:
    write_record(
        task.id,
        task.name,
        task.command,
        task.cwd,
        task.created,
        task.log,
        task.session,
        phase,
    )


def backfill_records(tasks: Sequence[Task]) -> None:
    on_disk = {record.id: record for record in read_records()[0]}
    for task in tasks:
        if not task.committed or not task.id or not task.log:
            continue
        existing = on_disk.get(task.id)
        if existing is None or existing.phase == RECORD_PHASE_PENDING:
            record_from_task(task, RECORD_PHASE_LIVE)


@contextmanager
def registry_lock() -> Iterator[None]:
    digest = socket_digest()
    path = control_root() / f"{digest}.lock"
    with path.open("a+b") as handle:
        os.chmod(path, 0o600)
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def acquire_task_lock(task_id: str, exclusive: bool) -> BinaryIO:
    digest = hashlib.sha256(task_id.encode()).hexdigest()
    path = control_root() / f"task-{digest}.lock"
    handle = path.open("a+b")
    os.chmod(path, 0o600)
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
    return handle


def release_task_lock(handle: BinaryIO) -> None:
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    finally:
        handle.close()


def expected_log_paths(task_id: str) -> set[Path]:
    return {
        (root / "logs" / f"{task_id}.log").resolve()
        for root in (state_root(), *legacy_state_roots())
    }


def validated_log_path(task: Task) -> Path:
    actual = Path(task.log).expanduser().resolve()
    if actual not in expected_log_paths(task.id):
        raise CliLaneError(f"refusing unexpected log path for {task.name}")
    return actual


def validated_record_log_path(record: TaskRecord) -> Path:
    actual = Path(record.log).expanduser().resolve()
    if actual not in expected_log_paths(record.id):
        raise CliLaneError(f"refusing unexpected log path for {record.name}")
    return actual


def encode_meta(meta: dict[str, object]) -> str:
    raw = json.dumps(meta, separators=(",", ":"), ensure_ascii=False).encode()
    return base64.urlsafe_b64encode(raw).decode()


def decode_meta(value: str) -> dict[str, object]:
    try:
        raw = base64.urlsafe_b64decode(value.encode())
        decoded = json.loads(raw)
    except (ValueError, json.JSONDecodeError) as error:
        raise CliLaneError("corrupt task metadata") from error
    if not isinstance(decoded, dict):
        raise CliLaneError("corrupt task metadata")
    return decoded


def encode_launcher(
    command: Sequence[str],
    on_exit: str | None,
    name: str,
    task_id: str,
    log_path: str,
) -> str:
    return encode_meta(
        {
            "command": list(command),
            "on_exit": on_exit,
            "name": name,
            "id": task_id,
            "log": log_path,
        }
    )


def decode_launcher(value: str) -> dict[str, object]:
    decoded = decode_meta(value)
    command = decoded.get("command")
    if not isinstance(command, list) or not all(isinstance(part, str) for part in command):
        raise CliLaneError("corrupt launcher command")
    if not command:
        raise CliLaneError("empty launcher command")
    on_exit = decoded.get("on_exit")
    if on_exit is not None and not isinstance(on_exit, str):
        raise CliLaneError("corrupt launcher hook")
    for key in ("name", "id", "log"):
        if not isinstance(decoded.get(key), str):
            raise CliLaneError("corrupt launcher metadata")
    return decoded


def process_start_time(pid: int) -> str | None:
    if sys.platform == "linux":
        try:
            stat = Path(f"/proc/{pid}/stat").read_text(errors="replace")
        except OSError:
            return None
        _, separator, rest = stat.rpartition(")")
        if not separator:
            return None
        fields = rest.split()
        if len(fields) < 20:
            return None
        return fields[19]
    completed = subprocess.run(
        ["/bin/ps", "-p", str(pid), "-o", "lstart="],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=tmux_client_environment(),
        check=False,
    )
    if completed.returncode != 0:
        return None
    value = " ".join(completed.stdout.decode(errors="replace").split())
    return value or None


def all_pids() -> list[int]:
    if sys.platform == "linux":
        try:
            entries = os.listdir("/proc")
        except OSError as error:
            raise CliLaneError("unable to inspect managed process session") from error
        return [int(entry) for entry in entries if entry.isdigit()]
    completed = subprocess.run(
        ["/bin/ps", "-axo", "pid="],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=tmux_client_environment(),
        check=False,
    )
    if completed.returncode != 0:
        raise CliLaneError("unable to inspect managed process session")
    found = []
    for line in completed.stdout.decode(errors="replace").splitlines():
        pid = optional_int(line.strip())
        if pid is not None:
            found.append(pid)
    return found


def session_pids(session_id: int) -> list[int]:
    found: list[int] = []
    for pid in all_pids():
        with suppress(ProcessLookupError):
            if os.getsid(pid) == session_id:
                found.append(pid)
    return found


def signal_session(session_id: int, sent_signal: signal.Signals, include_leader: bool) -> None:
    pids = session_pids(session_id)
    pids.sort(key=lambda pid: pid == session_id)
    for pid in pids:
        if pid == session_id and not include_leader:
            continue
        with suppress(ProcessLookupError):
            if os.getsid(pid) == session_id:
                os.kill(pid, sent_signal)


def terminate_session_descendants(
    session_id: int,
    grace: float,
    leader_started: str | None = None,
) -> None:
    term_deadline = time.monotonic() + max(0, grace)
    kill_deadline = term_deadline + 2
    while True:
        descendants = [pid for pid in session_pids(session_id) if pid != session_id]
        if not descendants:
            return
        current_started = process_start_time(session_id)
        if leader_started and current_started and current_started != leader_started:
            raise CliLaneError("managed session leader changed with live descendants")
        now = time.monotonic()
        sent_signal = signal.SIGTERM if now < term_deadline else signal.SIGKILL
        if sent_signal == signal.SIGTERM:
            signal_session(session_id, signal.SIGCONT, include_leader=False)
        signal_session(session_id, sent_signal, include_leader=False)
        if now >= kill_deadline:
            raise CliLaneError("managed descendants survived SIGKILL")
        time.sleep(0.05)


def terminate_pane_process(
    pane: str,
    grace: float,
    leader_started: str | None = None,
) -> None:
    details = tmux(
        ["display-message", "-p", "-t", pane, f"#{{pane_dead}}{FIELD_SEPARATOR}#{{pane_pid}}"],
        check=False,
    )
    if details.returncode != 0:
        detail = details.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or f"could not inspect managed pane: {pane}")
    values = details.stdout.decode().strip().split(FIELD_SEPARATOR)
    if len(values) != 2:
        return
    pid = optional_int(values[1])
    if pid is None:
        raise CliLaneError("managed pane has no process id")
    if values[0] == "1":
        descendants = session_pids(pid)
        if not descendants:
            return
        current_started = process_start_time(pid)
        if current_started and not leader_started:
            return
        if leader_started and current_started and current_started != leader_started:
            return
        terminate_session_descendants(pid, grace, leader_started)
        return
    started = process_start_time(pid)
    if not started:
        return
    if leader_started and started != leader_started:
        raise CliLaneError("managed pane process identity changed")
    try:
        session_id = os.getsid(pid)
    except ProcessLookupError:
        return
    if session_id != pid:
        raise CliLaneError("refusing an unverified managed pane process")
    with suppress(ProcessLookupError):
        os.kill(pid, signal.SIGCONT)
        os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + max(0, grace)
    while time.monotonic() < deadline:
        if not session_pids(pid):
            return
        time.sleep(0.05)
    terminate_session_descendants(pid, 0, started)
    if process_start_time(pid) == started:
        with suppress(ProcessLookupError):
            if os.getsid(pid) == pid:
                os.kill(pid, signal.SIGKILL)
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        if not session_pids(pid):
            return
        time.sleep(0.05)
    raise CliLaneError("managed pane process did not terminate")


def terminate_incomplete_session(
    session: str,
    pane: str,
    grace: float,
    leader_started: str | None = None,
) -> None:
    panes = [pane] if pane else []
    if not panes:
        listed = tmux(["list-panes", "-t", session, "-F", "#{pane_id}"], check=False)
        if listed.returncode != 0:
            if tmux_session_absent(session):
                return
            detail = listed.stderr.decode(errors="replace").strip()
            raise CliLaneError(detail or f"could not inspect managed session: {session}")
        panes = listed.stdout.decode().split()
    for target in panes:
        terminate_pane_process(target, grace, leader_started)


def supervise(encoded_command: str) -> int:
    launcher = decode_launcher(encoded_command)
    command = launcher["command"]
    pending: list[signal.Signals] = []

    def remember(signum: int, _frame: object) -> None:
        pending.append(signal.Signals(signum))

    forwarded = (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM)
    for sent_signal in forwarded:
        signal.signal(sent_signal, remember)
    child = os.fork()
    if child == 0:
        for sent_signal in forwarded:
            signal.signal(sent_signal, signal.SIG_DFL)
        try:
            os.execvpe(command[0], command, os.environ)
        except OSError as error:
            print(f"{PROGRAM}: {error}", file=sys.stderr)
            os._exit(127)
    status = 0
    shutdown_deadline: float | None = None
    while True:
        while pending:
            sent_signal = pending.pop(0)
            if sent_signal == signal.SIGHUP and shutdown_deadline is None:
                shutdown_deadline = time.monotonic() + 0.5
            signal_session(os.getpid(), signal.SIGCONT, include_leader=False)
            signal_session(os.getpid(), sent_signal, include_leader=False)
        if shutdown_deadline is not None and time.monotonic() >= shutdown_deadline:
            signal_session(os.getpid(), signal.SIGKILL, include_leader=False)
        waited, status = os.waitpid(child, os.WNOHANG)
        if waited == child:
            break
        time.sleep(0.05)
    result = os.waitstatus_to_exitcode(status)
    exit_code = 128 - result if result < 0 else result
    signal_name = ""
    if result < 0:
        try:
            signal_name = signal.Signals(-result).name
        except ValueError:
            signal_name = f"SIG{-result}"
    record_result(exit_code, signal_name)
    terminate_session_descendants(os.getpid(), 0.2)
    try:
        if shutdown_deadline is None:
            run_exit_hook(launcher, exit_code, signal_name, pending)
    finally:
        terminate_session_descendants(os.getpid(), 0.2)
    return exit_code


def record_result(exit_code: int, signal_name: str) -> None:
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return
    tmux(
        ["set-option", "-p", "-t", pane, "@agt_result", f"{exit_code}:{signal_name}"],
        check=False,
    )


def report_hook(message: str) -> None:
    try:
        print(f"{PROGRAM}: {message}", file=sys.stderr)
    except OSError:
        pass


def run_exit_hook(
    launcher: dict[str, object],
    exit_code: int,
    signal_name: str,
    pending: list[signal.Signals],
) -> None:
    on_exit = launcher.get("on_exit")
    if not on_exit:
        return
    environment = dict(os.environ)
    environment.update(
        CLILANE_TASK_NAME=str(launcher["name"]),
        CLILANE_TASK_ID=str(launcher["id"]),
        CLILANE_LOG=str(launcher["log"]),
        CLILANE_EXIT_CODE=str(exit_code),
        CLILANE_SIGNAL=signal_name,
    )
    try:
        hook = subprocess.Popen(["/bin/sh", "-c", str(on_exit)], env=environment)
    except OSError as error:
        report_hook(f"on-exit hook failed to start: {error}")
        return
    deadline = time.monotonic() + ON_EXIT_TIMEOUT
    shutdown_deadline: float | None = None
    timed_out = False
    while True:
        while pending:
            sent_signal = pending.pop(0)
            if sent_signal == signal.SIGHUP and shutdown_deadline is None:
                shutdown_deadline = time.monotonic() + 0.5
            signal_session(os.getpid(), signal.SIGCONT, include_leader=False)
            signal_session(os.getpid(), sent_signal, include_leader=False)
        if hook.poll() is not None:
            break
        now = time.monotonic()
        if now >= deadline:
            timed_out = True
            signal_session(os.getpid(), signal.SIGKILL, include_leader=False)
        elif shutdown_deadline is not None and now >= shutdown_deadline:
            signal_session(os.getpid(), signal.SIGKILL, include_leader=False)
        time.sleep(0.05)
    if timed_out:
        report_hook(f"on-exit hook killed after {int(ON_EXIT_TIMEOUT)}s")
    elif hook.returncode != 0:
        report_hook(f"on-exit hook exited {hook.returncode}")


def sink_log(path_value: str, max_bytes: int, session: str) -> int:
    if max_bytes <= 0:
        raise CliLaneError("log size must be positive")
    path = Path(path_value)
    previous = path.with_suffix(path.suffix + ".previous")
    handle = path.open("ab", buffering=0)
    size = handle.tell()
    dead_since: float | None = None
    descriptor = sys.stdin.fileno()
    try:
        while True:
            readable, _, _ = select.select([descriptor], [], [], 1.0)
            if readable:
                chunk = os.read(descriptor, 65536)
                if not chunk:
                    break
            else:
                result = tmux(
                    ["display-message", "-p", "-t", session, "#{pane_dead}"],
                    check=False,
                )
                is_dead = result.returncode != 0 or result.stdout.decode().strip() == "1"
                if is_dead:
                    dead_since = dead_since or time.monotonic()
                    if time.monotonic() - dead_since >= 0.5:
                        break
                continue
            if size + len(chunk) > max_bytes:
                handle.close()
                previous.unlink(missing_ok=True)
                os.replace(path, previous)
                handle = path.open("wb", buffering=0)
                os.chmod(path, 0o600)
                size = 0
            handle.write(chunk)
            size += len(chunk)
    finally:
        handle.close()
    return 0


def optional_int(value: str) -> int | None:
    if not value:
        return None
    try:
        return int(value)
    except ValueError:
        return None


def normalized_signal(value: str) -> str | None:
    if not value:
        return None
    upper = value.upper()
    return upper if upper.startswith("SIG") else f"SIG{upper}"


def list_tasks(timeout: float | None = None) -> list[Task]:
    fields = [
        "#{session_name}",
        "#{@agt_meta}",
        "#{@agt_committed}",
        "#{@agt_process_started}",
        "#{@agt_stop_requested}",
        "#{@agt_result}",
        "#{pane_id}",
        "#{pane_dead}",
        "#{pane_dead_status}",
        "#{pane_dead_signal}",
        "#{pane_pid}",
        "#{session_attached}",
    ]
    completed = tmux(
        ["list-panes", "-a", "-F", FIELD_SEPARATOR.join(fields)],
        check=False,
        timeout=timeout,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode(errors="replace")
        if tmux_server_absent(completed):
            return []
        raise CliLaneError(detail.strip() or f"tmux exited {completed.returncode}")
    tasks: list[Task] = []
    for line in completed.stdout.decode(errors="replace").splitlines():
        values = line.split(FIELD_SEPARATOR)
        if len(values) != len(fields):
            continue
        (
            session,
            encoded,
            committed,
            process_started,
            stopped,
            recorded,
            pane,
            dead,
            status,
            dead_signal,
            pid,
            attached,
        ) = values
        if not session.startswith(SESSION_PREFIX) or not encoded:
            continue
        meta = decode_meta(encoded)
        command = meta.get("command")
        if not isinstance(command, list) or not all(isinstance(part, str) for part in command):
            raise CliLaneError(f"corrupt task metadata in {session}")
        recorded_code: int | None = None
        recorded_signal: str | None = None
        if dead == "1" and recorded:
            code_text, _, signal_text = recorded.partition(":")
            recorded_code = optional_int(code_text)
            if recorded_code is not None:
                recorded_signal = signal_text or None
        tasks.append(
            Task(
                session=session,
                pane=pane,
                id=str(meta.get("id", "")),
                name=str(meta.get("name", "")),
                command=command,
                cwd=str(meta.get("cwd", "")),
                created=str(meta.get("created", "")),
                log=str(meta.get("log", "")),
                committed=committed == "1",
                process_started=process_started or None,
                stop_requested=stopped == "1",
                dead=dead == "1",
                exit_code=recorded_code if recorded_code is not None else optional_int(status),
                signal_name=recorded_signal
                if recorded_code is not None
                else normalized_signal(dead_signal),
                pid=optional_int(pid),
                attached=(optional_int(attached) or 0) > 0,
            )
        )
    return sorted(tasks, key=lambda task: task.created)


def fleet_error_message(value: str, limit: int = 300) -> str:
    collapsed = re.sub(r"\s+", " ", value).strip()
    cleaned = "".join(character for character in collapsed if character.isprintable())
    if len(cleaned) <= limit:
        return cleaned
    return cleaned[: limit - 1] + "…"


def fleet_error_result(host: FleetHost, kind: str, message: str) -> FleetResult:
    return FleetResult(
        name=host.name,
        status="error",
        clilane_version=None,
        tasks=[],
        error_kind=kind,
        error_message=fleet_error_message(message) or kind,
    )


def validate_fleet_task(host: FleetHost, value: object) -> dict[str, object]:
    if not isinstance(value, dict):
        raise CliLaneError(f"fleet host {host.name} returned a non-object task")
    required = set(FLEET_TASK_FIELDS)
    missing = required - set(value)
    if missing:
        raise CliLaneError(
            f"fleet host {host.name} task is missing field: {sorted(missing)[0]}"
        )
    for field in ("id", "state", "cwd", "created", "log"):
        if not isinstance(value[field], str):
            raise CliLaneError(
                f"fleet host {host.name} task field {field} has the wrong type"
            )
    if value["state"] not in FLEET_TASK_STATES:
        raise CliLaneError(f"fleet host {host.name} task state is invalid")
    try:
        created = datetime.fromisoformat(value["created"])
    except ValueError as error:
        raise CliLaneError(
            f"fleet host {host.name} task created timestamp is invalid"
        ) from error
    if created.tzinfo is None:
        raise CliLaneError(
            f"fleet host {host.name} task created timestamp has no timezone"
        )
    fleet_name(value["name"], f"fleet host {host.name} task name")
    command = value["command"]
    if not isinstance(command, list) or not command or not all(
        isinstance(part, str) for part in command
    ):
        raise CliLaneError(f"fleet host {host.name} task command is invalid")
    for field in ("pid", "exit_code"):
        item = value[field]
        if item is not None and type(item) is not int:
            raise CliLaneError(
                f"fleet host {host.name} task field {field} has the wrong type"
            )
    if type(value["attached"]) is not bool:
        raise CliLaneError(
            f"fleet host {host.name} task field attached has the wrong type"
        )
    if value["signal"] is not None and not isinstance(value["signal"], str):
        raise CliLaneError(
            f"fleet host {host.name} task field signal has the wrong type"
        )
    return {field: value[field] for field in FLEET_TASK_FIELDS}


def parse_fleet_response(host: FleetHost, output: bytes) -> FleetResult:
    if len(output) > FLEET_MAX_OUTPUT_BYTES:
        return fleet_error_result(
            host, "protocol", f"response exceeded {FLEET_OUTPUT_LIMIT_LABEL}"
        )
    try:
        text = output.decode("utf-8")
    except UnicodeDecodeError:
        return fleet_error_result(host, "protocol", "response was not UTF-8")
    sentinel = FLEET_SENTINEL_LINE.search(text)
    if not sentinel:
        return fleet_error_result(host, "protocol", "response sentinel was missing")
    position = FLEET_FRAME_WHITESPACE.match(text, sentinel.end()).end()
    version_end = text.find("\n", position)
    if version_end == -1:
        version_line = text[position:].rstrip("\r")
        payload = ""
    else:
        version_line = text[position:version_end].rstrip("\r")
        payload = text[version_end + 1 :].strip()
    if not version_line.startswith(f"{PROGRAM} "):
        return fleet_error_result(host, "protocol", "clilane version was missing")
    version = version_line[len(PROGRAM) + 1 :].strip()
    if not version:
        return fleet_error_result(host, "protocol", "clilane version was empty")
    try:
        decoded = json.loads(
            payload,
            parse_constant=reject_json_constant,
            parse_float=finite_json_float,
            parse_int=bounded_json_int,
        )
    except (json.JSONDecodeError, RecursionError, ValueError):
        return fleet_error_result(host, "protocol", "task JSON was malformed")
    if not isinstance(decoded, list):
        return fleet_error_result(host, "protocol", "task JSON was not an array")
    if len(decoded) > FLEET_MAX_TASKS_PER_HOST:
        return fleet_error_result(
            host,
            "protocol",
            f"host returned more than {FLEET_MAX_TASKS_PER_HOST} tasks",
        )
    try:
        tasks = [validate_fleet_task(host, task) for task in decoded]
    except CliLaneError as error:
        return fleet_error_result(host, "protocol", str(error))
    return FleetResult(host.name, "ok", version, tasks, None, None)


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    with suppress(ProcessLookupError):
        os.killpg(process.pid, signal.SIGKILL)
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def run_bounded_process(
    command: Sequence[str],
    timeout: float,
    max_bytes: int,
    cancel_event: threading.Event | None = None,
) -> tuple[subprocess.CompletedProcess[bytes], bool]:
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    if process.stdout is None or process.stderr is None:
        terminate_process_group(process)
        raise CliLaneError("could not capture SSH output")
    stdout_stream = process.stdout
    stderr_stream = process.stderr
    complete = False
    try:
        stdout = bytearray()
        stderr = bytearray()
        streams = {
            stdout_stream.fileno(): stdout,
            stderr_stream.fileno(): stderr,
        }
        for descriptor in streams:
            os.set_blocking(descriptor, False)
        deadline = time.monotonic() + timeout
        exceeded = False
        while streams:
            if cancel_event and cancel_event.is_set():
                raise concurrent.futures.CancelledError
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(command, timeout)
            wait_for = min(remaining, 0.1) if cancel_event else remaining
            readable, _, _ = select.select(list(streams), [], [], wait_for)
            if not readable:
                continue
            for descriptor in readable:
                try:
                    chunk = os.read(
                        descriptor,
                        min(65536, max_bytes + 1 - len(stdout) - len(stderr)),
                    )
                except BlockingIOError:
                    continue
                if not chunk:
                    streams.pop(descriptor)
                    continue
                streams[descriptor].extend(chunk)
                if len(stdout) + len(stderr) > max_bytes:
                    exceeded = True
                    break
            if exceeded:
                break
        if exceeded:
            terminate_process_group(process)
        else:
            while process.poll() is None:
                if cancel_event and cancel_event.is_set():
                    raise concurrent.futures.CancelledError
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(command, timeout)
                wait_for = min(remaining, 0.1) if cancel_event else remaining
                try:
                    process.wait(timeout=wait_for)
                except subprocess.TimeoutExpired:
                    continue
        complete = True
        return (
            subprocess.CompletedProcess(
                list(command), process.returncode, bytes(stdout), bytes(stderr)
            ),
            exceeded,
        )
    finally:
        try:
            if not complete:
                terminate_process_group(process)
        finally:
            stdout_stream.close()
            stderr_stream.close()


def collect_remote_fleet_host(
    host: FleetHost,
    ssh: str,
    timeout: float,
    cancel_event: threading.Event | None = None,
) -> FleetResult:
    if not host.destination:
        return fleet_error_result(host, "config", "SSH destination was missing")
    command = [
        ssh,
        "-T",
        "-n",
        "-a",
        "-x",
        "-o",
        "BatchMode=yes",
        "-o",
        "ClearAllForwardings=yes",
        "-o",
        "ConnectionAttempts=1",
        "-o",
        f"ConnectTimeout={math.ceil(timeout)}",
        "-o",
        "AddKeysToAgent=no",
        "-o",
        "CheckHostIP=no",
        "-o",
        "ControlMaster=no",
        "-o",
        "ControlPath=none",
        "-o",
        "ControlPersist=no",
        "-o",
        "ForkAfterAuthentication=no",
        "-o",
        "PermitLocalCommand=no",
        "-o",
        "RemoteCommand=none",
        "-o",
        "RequestTTY=no",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UpdateHostKeys=no",
        "-o",
        "LogLevel=ERROR",
        "--",
        host.destination,
        FLEET_REMOTE_COMMAND,
    ]
    try:
        completed, exceeded = run_bounded_process(
            command, timeout, FLEET_MAX_OUTPUT_BYTES, cancel_event
        )
    except subprocess.TimeoutExpired:
        return fleet_error_result(host, "timeout", f"timed out after {timeout:g} seconds")
    except OSError as error:
        return fleet_error_result(host, "ssh", str(error))
    if exceeded:
        return fleet_error_result(
            host, "protocol", f"response exceeded {FLEET_OUTPUT_LIMIT_LABEL}"
        )
    if completed.returncode != 0:
        detail = completed.stderr.decode(errors="replace").strip()
        if not detail:
            detail = completed.stdout.decode(errors="replace").strip()
        kind = "ssh" if completed.returncode == 255 else "remote"
        return fleet_error_result(
            host,
            kind,
            detail or f"remote command exited {completed.returncode}",
        )
    return parse_fleet_response(host, completed.stdout)


def collect_fleet(hosts: Sequence[FleetHost], timeout: float) -> list[FleetResult]:
    if not math.isfinite(timeout) or timeout <= 0 or timeout > FLEET_MAX_TIMEOUT:
        raise CliLaneError(
            f"fleet timeout must be greater than 0 and at most {FLEET_MAX_TIMEOUT:g} seconds"
        )
    results: dict[str, FleetResult] = {}
    local = next(host for host in hosts if host.transport == "local")
    remote = [host for host in hosts if host.transport == "ssh"]
    ssh = shutil.which("ssh") if remote else None
    cancel_event = threading.Event()
    executor: concurrent.futures.ThreadPoolExecutor | None = None
    futures: dict[concurrent.futures.Future[FleetResult], FleetHost] = {}
    previous_handlers: dict[int, signal.Handlers] = {}

    def cancel_for_signal(signum: int, _frame: object) -> None:
        cancel_event.set()
        raise FleetSignal(signum)

    try:
        if threading.current_thread() is threading.main_thread():
            for sent_signal in (signal.SIGHUP, signal.SIGTERM):
                previous_handlers[sent_signal] = signal.getsignal(sent_signal)
                signal.signal(sent_signal, cancel_for_signal)
        if ssh:
            executor = concurrent.futures.ThreadPoolExecutor(
                max_workers=min(8, len(remote))
            )
        remote_hosts = iter(remote)
        if executor and ssh:
            for _ in range(min(8, len(remote))):
                host = next(remote_hosts)
                future = executor.submit(
                    collect_remote_fleet_host,
                    host,
                    ssh,
                    timeout,
                    cancel_event,
                )
                futures[future] = host
        try:
            tasks = [task.as_dict() for task in list_tasks(timeout)]
            if len(tasks) > FLEET_MAX_TASKS_PER_HOST:
                raise CliLaneError(
                    f"local host has more than {FLEET_MAX_TASKS_PER_HOST} tasks"
                )
            encoded_tasks = json.dumps(
                tasks, separators=(",", ":"), allow_nan=False
            ).encode()
            if len(encoded_tasks) > FLEET_MAX_OUTPUT_BYTES:
                raise CliLaneError(
                    f"local task data exceeded {FLEET_OUTPUT_LIMIT_LABEL}"
                )
            results[local.name] = FleetResult(
                local.name,
                "ok",
                VERSION,
                tasks,
                None,
                None,
            )
        except (CliLaneError, OSError) as error:
            results[local.name] = fleet_error_result(local, "local", str(error))
        if remote and not ssh:
            for host in remote:
                results[host.name] = fleet_error_result(
                    host, "dependency", "ssh is required"
                )
        while futures:
            done, _ = concurrent.futures.wait(
                futures, return_when=concurrent.futures.FIRST_COMPLETED
            )
            for future in done:
                host = futures.pop(future)
                results[host.name] = future.result()
                next_host = next(remote_hosts, None)
                if next_host and executor and ssh:
                    next_future = executor.submit(
                        collect_remote_fleet_host,
                        next_host,
                        ssh,
                        timeout,
                        cancel_event,
                    )
                    futures[next_future] = next_host
    except BaseException:
        cancel_event.set()
        for future in futures:
            future.cancel()
        raise
    finally:
        try:
            if executor:
                executor.shutdown(wait=True, cancel_futures=True)
        finally:
            for sent_signal, previous_handler in previous_handlers.items():
                signal.signal(sent_signal, previous_handler)
    return [results[host.name] for host in hosts]


def resolve_task(target: str) -> Task:
    tasks = list_tasks()
    exact = [task for task in tasks if target in {task.name, task.id, task.session}]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        raise CliLaneError(f"ambiguous task name: {target}")
    prefixed = [task for task in tasks if task.id.startswith(target)]
    if len(prefixed) == 1:
        return prefixed[0]
    if len(prefixed) > 1:
        raise CliLaneError(f"ambiguous task id: {target}")
    raise CliLaneError(
        f"task not found: {target}; run '{PROGRAM} list' to see managed tasks"
    )


def set_task_environment(session: str) -> None:
    current = {
        key: value
        for key, value in os.environ.items()
        if key not in TRANSIENT_ENV and ENV_PATTERN.fullmatch(key) and "\x00" not in value
    }
    shown = tmux(["show-environment", "-t", session]).stdout.decode(errors="replace")
    existing = set()
    for line in shown.splitlines():
        key = line.lstrip("-").split("=", 1)[0]
        if key and key not in {"TMUX", "TMUX_PANE"}:
            existing.add(key)
    for key in sorted(existing - current.keys()):
        tmux(["set-environment", "-t", session, "-r", key])
    for key, value in current.items():
        tmux(["set-environment", "-t", session, key, value])


def validate_name(name: str) -> None:
    if not NAME_PATTERN.fullmatch(name):
        raise CliLaneError(
            "name must be 1-64 characters, beginning with a letter or number and "
            "using only letters, numbers, dot, dash, or underscore"
        )


def command_from_remainder(parts: Sequence[str]) -> list[str]:
    command = list(parts)
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        raise CliLaneError("missing command after --")
    return command


def positive_timeout(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as error:
        raise CliLaneError(f"--timeout requires a number: {value!r}") from error
    if not math.isfinite(parsed) or parsed <= 0:
        raise CliLaneError("--timeout must be greater than 0")
    return parsed


def run_spec(
    default_cwd: str, default_on_exit: str | None, parts: Sequence[str]
) -> RunSpec:
    cwd = default_cwd
    wait = False
    timeout: float | None = None
    on_exit = default_on_exit
    remaining = list(parts)
    while remaining and remaining[0] != "--":
        if remaining[0] in {"-C", "--cwd"}:
            if len(remaining) < 2:
                raise CliLaneError(f"{remaining[0]} requires a directory")
            cwd = remaining[1]
            remaining = remaining[2:]
            continue
        if remaining[0].startswith("--cwd="):
            cwd = remaining[0].split("=", 1)[1]
            remaining = remaining[1:]
            continue
        if remaining[0] == "--wait":
            wait = True
            remaining = remaining[1:]
            continue
        if remaining[0] == "--timeout":
            if len(remaining) < 2:
                raise CliLaneError("--timeout requires a number")
            timeout = positive_timeout(remaining[1])
            remaining = remaining[2:]
            continue
        if remaining[0].startswith("--timeout="):
            timeout = positive_timeout(remaining[0].split("=", 1)[1])
            remaining = remaining[1:]
            continue
        if remaining[0] == "--on-exit":
            if len(remaining) < 2:
                raise CliLaneError("--on-exit requires a command")
            on_exit = remaining[1]
            remaining = remaining[2:]
            continue
        if remaining[0].startswith("--on-exit="):
            on_exit = remaining[0].split("=", 1)[1]
            remaining = remaining[1:]
            continue
        break
    if timeout is not None and not wait:
        raise CliLaneError("--timeout requires --wait")
    if on_exit is not None and not on_exit.strip():
        raise CliLaneError("--on-exit requires a command")
    return RunSpec(cwd, wait, timeout, on_exit, command_from_remainder(remaining))


def bind_detach_key() -> None:
    tmux(["bind-key", "-T", "root", "C-q", "detach-client"])


def ensure_server_available() -> None:
    ensure_tmux_version()
    probe = tmux(["list-sessions"], check=False)
    if probe.returncode != 0:
        if tmux_server_absent(probe):
            return
        detail = probe.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or f"could not inspect tmux socket: {SOCKET}")
    tag = tmux(["show-options", "-gqv", "@agt_server"]).stdout.decode().strip()
    if tag != SERVER_TAG:
        raise CliLaneError(f"tmux socket is already owned by another server: {SOCKET}")


def tmux_session_absent(session: str) -> bool:
    probe = tmux(["has-session", "-t", session], check=False)
    if probe.returncode == 0:
        return False
    detail = probe.stderr.decode(errors="replace").lower()
    if tmux_server_absent(probe) or "can't find session" in detail:
        return True
    raise CliLaneError(detail.strip() or f"could not inspect tmux session: {session}")


def kill_managed_session(session: str) -> None:
    killed = tmux(["kill-session", "-t", session], check=False)
    if killed.returncode == 0:
        return
    if tmux_session_absent(session):
        return
    detail = killed.stderr.decode(errors="replace").strip()
    raise CliLaneError(detail or f"could not remove tmux session: {session}")


def run_task(
    name: str, cwd_value: str, command: list[str], on_exit: str | None = None
) -> Task:
    with registry_lock():
        ensure_server_available()
        validate_name(name)
        existing = list_tasks()
        backfill_records(existing)
        if any(task.name == name for task in existing):
            raise CliLaneError(f"task already exists: {name}")
        cwd = Path(cwd_value).expanduser().resolve()
        if not cwd.is_dir():
            raise CliLaneError(f"not a directory: {cwd}")
        task_id = str(uuid.uuid4())
        session = f"{SESSION_PREFIX}{task_id.replace('-', '')[:12]}"
        log_dir = state_root() / "logs"
        log_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(log_dir, 0o700)
        log_path = log_dir / f"{task_id}.log"
        created_stamp = datetime.now(timezone.utc).isoformat()
        write_record(
            task_id,
            name,
            command,
            str(cwd),
            created_stamp,
            str(log_path),
            session,
            RECORD_PHASE_PENDING,
        )
        log_created = False
        try:
            log_path.touch(mode=0o600, exist_ok=False)
            log_created = True
        except OSError:
            delete_record(task_id)
            raise
        meta: dict[str, object] = {
            "id": task_id,
            "name": name,
            "command": command,
            "cwd": str(cwd),
            "created": created_stamp,
            "log": str(log_path),
            "on_exit": on_exit,
        }
        script = Path(__file__).resolve()
        committed = False
        pane = ""
        started: str | None = None
        try:
            created = tmux(
                [
                    "start-server",
                    ";",
                    "set-option",
                    "-g",
                    "history-limit",
                    "50000",
                    ";",
                    "set-option",
                    "-g",
                    "@agt_server",
                    SERVER_TAG,
                    ";",
                    "new-session",
                    "-d",
                    "-P",
                    "-F",
                    "#{pane_id}",
                    "-s",
                    session,
                    "-c",
                    str(cwd),
                    "sleep",
                    "2147483647",
                    ";",
                    "set-option",
                    "-w",
                    "-t",
                    session,
                    "remain-on-exit",
                    "on",
                    ";",
                    "set-option",
                    "-t",
                    session,
                    "@agt_meta",
                    encode_meta(meta),
                    ";",
                    "set-option",
                    "-t",
                    session,
                    "@agt_committed",
                    "0",
                    ";",
                    "set-option",
                    "-t",
                    session,
                    "@agt_process_started",
                    "",
                    ";",
                    "set-option",
                    "-t",
                    session,
                    "@agt_stop_requested",
                    "0",
                ]
            )
            pane = created.stdout.decode().strip()
            set_task_environment(session)
            sink = (
                f"exec {shlex.quote(str(script))} __log "
                f"{shlex.quote(str(log_path))} {LOG_MAX_BYTES} {shlex.quote(session)}"
            )
            tmux(["pipe-pane", "-t", pane, sink])
            bind_detach_key()
            tmux(
                [
                    "respawn-pane",
                    "-k",
                    "-c",
                    str(cwd),
                    "-t",
                    pane,
                    "--",
                    str(script),
                    "__supervise",
                    encode_launcher(command, on_exit, name, task_id, str(log_path)),
                ]
            )
            deadline = time.monotonic() + 0.5
            started = None
            while True:
                process = tmux(
                    [
                        "display-message",
                        "-p",
                        "-t",
                        pane,
                        f"#{{pane_dead}}{FIELD_SEPARATOR}#{{pane_pid}}",
                    ]
                ).stdout.decode().strip().split(FIELD_SEPARATOR)
                dead = len(process) != 2 or process[0] == "1"
                pid = optional_int(process[1]) if len(process) == 2 else None
                started = process_start_time(pid) if pid is not None and not dead else None
                if dead or started:
                    break
                if time.monotonic() >= deadline:
                    raise CliLaneError("could not bind supervisor process identity")
                time.sleep(0.02)
            tmux(["set-option", "-t", session, "@agt_process_started", started or ""])
            tmux(["set-option", "-t", session, "@agt_committed", "1"])
            write_record(
                task_id,
                name,
                command,
                str(cwd),
                created_stamp,
                str(log_path),
                session,
                RECORD_PHASE_LIVE,
            )
            committed = True
            return resolve_task(task_id)
        finally:
            if not committed:
                terminate_incomplete_session(session, pane, 0.5, started)
                kill_managed_session(session)
                if log_created:
                    log_path.unlink(missing_ok=True)
                    log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
                delete_record(task_id)


def age(created: str) -> str:
    try:
        started = datetime.fromisoformat(created)
        if started.tzinfo is None:
            return "?"
    except (TypeError, ValueError):
        return "?"
    seconds = max(0, int((datetime.now(timezone.utc) - started).total_seconds()))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


def print_tasks(tasks: Sequence[Task], as_json: bool) -> None:
    if as_json:
        print(json.dumps([task.as_dict() for task in tasks], indent=2))
        return
    if not tasks:
        print("no tasks")
        return
    projects = [Path(task.cwd).name or task.cwd for task in tasks]
    name_width = max(len("NAME"), *(len(task.name) for task in tasks))
    project_width = max(len("PROJECT"), *(len(project) for project in projects))
    print(
        f"{'NAME':<{name_width}} {'STATE':<10} {'AGE':<6} "
        f"{'PID':<8} {'PROJECT':<{project_width}} COMMAND"
    )
    for task, project in zip(tasks, projects):
        pid = str(task.pid) if not task.dead and task.pid is not None else "-"
        command = shlex.join(task.command)
        print(
            f"{task.name:<{name_width}} {task.state:<10} {age(task.created):<6} "
            f"{pid:<8} {project:<{project_width}} {command}"
        )


def fleet_display_cell(value: str, limit: int | None = None) -> str:
    normalized = "".join(
        " " if character.isspace() and character != " " else character
        for character in value
    )
    cleaned = "".join(character for character in normalized if character.isprintable())
    if limit is None or len(cleaned) <= limit:
        return cleaned
    return cleaned[: limit - 1] + "…"


def print_fleet_results(results: Sequence[FleetResult], as_json: bool) -> int:
    complete = all(result.status == "ok" for result in results)
    if as_json:
        payload = {
            "schema_version": FLEET_OUTPUT_SCHEMA_VERSION,
            "complete": complete,
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "hosts": [result.as_dict() for result in results],
        }
        print(json.dumps(payload, indent=2, allow_nan=False))
        return 0 if complete else 1
    rows: list[tuple[str, str, str, str, str, str, str]] = []
    for result in results:
        if result.status != "ok":
            continue
        for task in result.tasks:
            cwd = str(task["cwd"])
            project = Path(cwd).name or cwd
            pid_value = task["pid"]
            pid = str(pid_value) if pid_value is not None else "-"
            command = shlex.join(task["command"])
            rows.append(
                (
                    result.name,
                    str(task["name"]),
                    fleet_display_cell(str(task["state"]), 32),
                    age(str(task["created"])),
                    pid,
                    fleet_display_cell(project, 64),
                    fleet_display_cell(command, 240),
                )
            )
    if rows:
        host_width = max(len("HOST"), *(len(row[0]) for row in rows))
        name_width = max(len("NAME"), *(len(row[1]) for row in rows))
        project_width = max(len("PROJECT"), *(len(row[5]) for row in rows))
        print(
            f"{'HOST':<{host_width}} {'NAME':<{name_width}} {'STATE':<10} "
            f"{'AGE':<6} {'PID':<8} {'PROJECT':<{project_width}} COMMAND"
        )
        for host, name, state, task_age, pid, project, command in rows:
            print(
                f"{host:<{host_width}} {name:<{name_width}} {state:<10} "
                f"{task_age:<6} {pid:<8} {project:<{project_width}} {command}"
            )
    else:
        healthy = sum(result.status == "ok" for result in results)
        print(f"no tasks across {healthy} healthy host{'s' if healthy != 1 else ''}")
    for result in results:
        if result.status == "error":
            print(
                f"{PROGRAM}: fleet {result.name}: {result.error_kind}: "
                f"{result.error_message}",
                file=sys.stderr,
            )
    return 0 if complete else 1


def print_status(task: Task, as_json: bool) -> None:
    if as_json:
        print(json.dumps(task.as_dict(), indent=2))
        return
    values = task.as_dict()
    keys = (
        "name",
        "id",
        "state",
        "pid",
        "exit_code",
        "signal",
        "attached",
        "created",
        "cwd",
        "log",
    )
    for key in keys:
        value = values[key]
        if value is None:
            value = "-"
        elif isinstance(value, bool):
            value = "yes" if value else "no"
        print(f"{key}: {value}")
    print(f"command: {shlex.join(task.command)}")


def attach_task(task: Task) -> int:
    bind_detach_key()
    environment = os.environ.copy()
    environment.pop("TMUX", None)
    environment.pop("TMUX_PANE", None)
    binary = tmux_binary()
    os.execvpe(
        binary,
        [binary, "-L", SOCKET, "-f", "/dev/null", "attach-session", "-t", task.session],
        environment,
    )
    return 1


def read_task(task: Task, all_history: bool) -> int:
    start = "-" if all_history else "-200"
    captured = tmux(["capture-pane", "-p", "-J", "-S", start, "-t", task.pane])
    sys.stdout.buffer.write(captured.stdout)
    return 0


def log_task(task: Task, lines: int, follow: bool) -> int:
    if lines < 0:
        raise CliLaneError("lines must be non-negative")
    tail = shutil.which("tail")
    if not tail:
        raise CliLaneError("tail is required")
    arguments = [tail, "-n", str(lines)]
    log_path = validated_log_path(task)
    if follow:
        arguments.extend(["-F", str(log_path)])
    else:
        previous = log_path.with_suffix(log_path.suffix + ".previous")
        if previous.exists():
            arguments.append(str(previous))
        arguments.append(str(log_path))
    return subprocess.call(arguments)


def live_task(target: str) -> Task:
    task = resolve_task(target)
    if task.dead:
        raise CliLaneError(f"task is not running: {task.name}")
    if not task.committed:
        raise CliLaneError(f"task is still initializing: {task.name}")
    return task


def send_task(target: str, message: str, enter: bool) -> int:
    if not message:
        raise CliLaneError(
            f"message is empty; use '{PROGRAM} key TARGET Enter' to press a key"
        )
    rejected = sorted(
        {
            character
            for character in message
            if unicodedata.category(character) in MESSAGE_REJECTED_CATEGORIES
            and character not in MESSAGE_ALLOWED_CONTROLS
        }
    )
    if rejected:
        listed = ", ".join(ascii(character) for character in rejected)
        raise CliLaneError(
            f"message contains control characters ({listed}); they would reach "
            f"the task as raw bytes, not keypresses; use '{PROGRAM} key' instead"
        )
    with registry_lock():
        task = live_task(target)
        buffer_name = f"agt_{uuid.uuid4().hex}"
        tmux(["load-buffer", "-b", buffer_name, "-"], input_data=message.encode())
        try:
            command = ["paste-buffer", "-b", buffer_name, "-d", "-t", task.pane]
            if enter:
                command.extend([";", "send-keys", "-t", task.pane, "Enter"])
            tmux(command)
        finally:
            tmux(["delete-buffer", "-b", buffer_name], check=False)
        return 0


def is_key_name(value: str) -> bool:
    return (
        value in NAMED_KEYS
        or value.lower() in {name.lower() for name in NAMED_KEYS}
        or bool(KEY_PATTERN.fullmatch(value))
    )


def validated_keys(keys: Sequence[str]) -> list[str]:
    if not keys:
        raise CliLaneError(f"missing key; run '{PROGRAM} key --list' to see keys")
    aliases = {name.lower(): name for name in NAMED_KEYS}
    validated = []
    for key in keys:
        if key in NAMED_KEYS or KEY_PATTERN.fullmatch(key):
            validated.append(key)
        elif key.lower() in aliases:
            validated.append(aliases[key.lower()])
        else:
            raise CliLaneError(
                f"unsupported key: {key!r}; run '{PROGRAM} key --list' to see keys"
            )
    return validated


def print_key_names() -> int:
    named = sorted(NAMED_KEYS, key=str.lower)
    print(" ".join(named))
    print("modifiers: C- (Ctrl), M- (Alt), applied to one printable character")
    return 0


def key_task(target: str, keys: Sequence[str]) -> int:
    validated = validated_keys(keys)
    with registry_lock():
        task = live_task(target)
        tmux(["send-keys", "-t", task.pane, "--", *validated])
    return 0


def wait_task(target: str, timeout: float | None) -> int:
    with registry_lock():
        task = resolve_task(target)
        if not task.committed:
            raise CliLaneError(f"task initialization is incomplete: {task.name}")
        lock_handle = acquire_task_lock(task.id, exclusive=False)
    task_id = task.id
    started = time.monotonic()
    try:
        while True:
            task = resolve_task(task_id)
            if task.dead:
                return task.result_code
            if timeout is not None and time.monotonic() - started >= timeout:
                print(f"{PROGRAM}: timeout waiting for {task.name}", file=sys.stderr)
                return 124
            time.sleep(0.2)
    finally:
        release_task_lock(lock_handle)


def validated_supervisor(task: Task) -> int:
    if task.pid is None:
        raise CliLaneError(f"task has no process id: {task.name}")
    if not task.process_started:
        raise CliLaneError(f"task has no process identity: {task.name}")
    try:
        session_id = os.getsid(task.pid)
    except ProcessLookupError as error:
        raise CliLaneError(f"task process disappeared: {task.name}") from error
    if session_id != task.pid:
        raise CliLaneError("refusing a task whose supervisor is not its session leader")
    if process_start_time(task.pid) != task.process_started:
        raise CliLaneError("refusing a task whose supervisor identity changed")
    server_pid = optional_int(tmux(["display-message", "-p", "#{pid}"]).stdout.decode().strip())
    if server_pid is not None and task.pid == server_pid:
        raise CliLaneError("refusing to signal the tmux server")
    return task.pid


def managed_session_empty(task: Task) -> bool:
    if task.pid is None:
        return True
    current_started = process_start_time(task.pid)
    if task.process_started and current_started and current_started != task.process_started:
        return True
    if task.dead and not task.process_started and current_started:
        return True
    return not session_pids(task.pid)


def terminate_dead_task_descendants(task: Task, grace: float) -> None:
    if managed_session_empty(task):
        return
    if task.pid is None:
        raise CliLaneError(f"dead task has unverifiable descendants: {task.name}")
    terminate_session_descendants(task.pid, grace, task.process_started)
    if not managed_session_empty(task):
        raise CliLaneError(f"dead task descendants did not stop: {task.name}")


def stop_task_locked(task: Task, grace: float) -> Task:
    if grace < 0:
        raise CliLaneError("grace must be non-negative")
    if task.dead:
        if not managed_session_empty(task):
            tmux(["set-option", "-t", task.session, "@agt_stop_requested", "1"])
            terminate_dead_task_descendants(task, grace)
            return resolve_task(task.id)
        return task
    if not task.committed:
        raise CliLaneError(f"task is still initializing: {task.name}")
    tmux(["set-option", "-t", task.session, "@agt_stop_requested", "1"])
    current = resolve_task(task.id)
    if current.dead:
        if not managed_session_empty(current):
            terminate_dead_task_descendants(current, grace)
            return resolve_task(task.id)
        return current
    supervisor = validated_supervisor(current)
    try:
        os.kill(supervisor, signal.SIGCONT)
        os.kill(supervisor, signal.SIGTERM)
    except ProcessLookupError:
        refreshed = resolve_task(task.id)
        if refreshed.dead and managed_session_empty(refreshed):
            return refreshed
        if refreshed.dead:
            terminate_dead_task_descendants(refreshed, grace)
            return resolve_task(task.id)
        raise CliLaneError(f"task process disappeared: {task.name}")
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        current = resolve_task(task.id)
        if current.dead and managed_session_empty(current):
            return current
        time.sleep(0.1)
    current = resolve_task(task.id)
    if current.dead and managed_session_empty(current):
        return current
    if not current.dead and validated_supervisor(current) != supervisor:
        raise CliLaneError("task supervisor changed while stopping; refusing SIGKILL")
    terminate_session_descendants(supervisor, 0, current.process_started)
    if process_start_time(supervisor) == current.process_started:
        with suppress(ProcessLookupError):
            if os.getsid(supervisor) == supervisor:
                os.kill(supervisor, signal.SIGKILL)
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        current = resolve_task(task.id)
        if current.dead and managed_session_empty(current):
            return current
        time.sleep(0.1)
    raise CliLaneError(f"task did not stop: {task.name}")


def stop_task(target: str, grace: float) -> Task:
    with registry_lock():
        return stop_task_locked(resolve_task(target), grace)


def remove_task_locked(task: Task, force: bool, grace: float) -> None:
    current = task
    if not current.committed:
        if not force:
            raise CliLaneError(f"task initialization is incomplete; use --force: {task.name}")
        if current.id and current.log:
            record_from_task(current, RECORD_PHASE_REMOVING)
        log_path = validated_log_path(current) if current.log else None
        terminate_incomplete_session(
            current.session,
            current.pane,
            grace,
            current.process_started,
        )
        kill_managed_session(current.session)
        if log_path:
            log_path.unlink(missing_ok=True)
            log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
        if current.id:
            delete_record(current.id)
        return
    if not current.dead:
        if not force:
            raise CliLaneError(f"task is running; use --force to stop and remove: {task.name}")
        current = stop_task_locked(current, grace)
    if not managed_session_empty(current):
        if not force:
            raise CliLaneError(f"refusing removal with live descendants: {current.name}")
        terminate_dead_task_descendants(current, grace)
    if current.id and current.log:
        record_from_task(current, RECORD_PHASE_REMOVING)
    log_path = validated_log_path(current) if current.log else None
    kill_managed_session(current.session)
    if log_path:
        log_path.unlink(missing_ok=True)
        log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
    if current.id:
        delete_record(current.id)


def remove_task(target: str, force: bool, grace: float) -> Task:
    with registry_lock():
        task = resolve_task(target)
        current = task
        if current.committed and not current.dead:
            if not force:
                raise CliLaneError(f"task is running; use --force to stop and remove: {task.name}")
            current = stop_task_locked(current, grace)
        lock_handle = acquire_task_lock(current.id, exclusive=True)
        try:
            remove_task_locked(current, force, grace)
        finally:
            release_task_lock(lock_handle)
        return current


def classify_records(
    records: Sequence[TaskRecord], tasks: Sequence[Task]
) -> dict[str, list[TaskRecord]]:
    live_ids = {task.id for task in tasks if task.id}
    classified: dict[str, list[TaskRecord]] = {
        "live": [],
        "aborted": [],
        "interrupted": [],
        "superseded": [],
        "orphan": [],
    }
    for record in records:
        if record.id in live_ids:
            classified["live"].append(record)
        elif record.phase == RECORD_PHASE_PENDING:
            classified["aborted"].append(record)
        elif record.phase == RECORD_PHASE_REMOVING:
            classified["interrupted"].append(record)
        elif not Path(record.log).expanduser().is_file():
            classified["superseded"].append(record)
        else:
            classified["orphan"].append(record)
    return classified


def confirm_server_absent(tasks: Sequence[Task], records: Sequence[TaskRecord]) -> None:
    disk_only = [record for record in records if record.id not in {task.id for task in tasks}]
    if tasks or not disk_only:
        return
    probe = tmux(["list-sessions"], check=False)
    if probe.returncode == 0 or not tmux_server_absent(probe):
        raise CliLaneError("could not confirm the tmux server is absent; not reclaiming")


def reap_record(record: TaskRecord, live_sessions: frozenset[str]) -> None:
    if record.session in live_sessions:
        raise CliLaneError(f"record session belongs to a live task: {record.name}")
    log_path = validated_record_log_path(record)
    kill_managed_session(record.session)
    log_path.unlink(missing_ok=True)
    log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
    delete_record(record.id)


def unclaimed_logs(tasks: Sequence[Task]) -> list[Path]:
    log_dir = state_root() / "logs"
    if not log_dir.is_dir():
        return []
    claimed = claimed_log_paths()
    for task in tasks:
        if task.log:
            claimed.add(Path(task.log).expanduser().resolve())
    unclaimed = []
    for path in sorted(log_dir.glob("*.log")):
        if path.resolve() not in claimed:
            unclaimed.append(path)
    return unclaimed


def clean_tasks(dry_run: bool, orphans: bool) -> int:
    failures: list[str] = []
    reclaimed = 0
    orphans_kept = 0
    reclaimed_logs = 0
    with registry_lock():
        ensure_server_available()
        tasks = list_tasks()
        if not dry_run:
            backfill_records(tasks)
        removable = [task for task in tasks if task.dead or not task.committed]
        removed = 0
        for task in removable:
            if dry_run:
                removed += 1
                continue
            lock_handle = acquire_task_lock(task.id, exclusive=True)
            try:
                remove_task_locked(task, force=True, grace=0)
                removed += 1
            except CliLaneError as error:
                failures.append(str(error))
            finally:
                release_task_lock(lock_handle)
        records, damaged = read_records()
        classified = classify_records(records, tasks)
        live_sessions = frozenset(task.session for task in tasks)
        stale = classified["aborted"] + classified["interrupted"] + classified["superseded"]
        if orphans:
            stale += classified["orphan"]
        else:
            orphans_kept = len(classified["orphan"])
        leftover = unclaimed_logs(tasks)
        reap_leftover = orphans and leftover and not tasks
        if stale or reap_leftover:
            confirm_server_absent(tasks, records)
        for record in stale:
            if dry_run:
                reclaimed += 1
                continue
            lock_handle = acquire_task_lock(record.id, exclusive=True)
            try:
                reap_record(record, live_sessions)
                reclaimed += 1
            except CliLaneError as error:
                failures.append(str(error))
            finally:
                release_task_lock(lock_handle)
        if reap_leftover:
            for path in leftover:
                if not dry_run:
                    path.unlink(missing_ok=True)
                    path.with_suffix(path.suffix + ".previous").unlink(missing_ok=True)
                reclaimed_logs += 1
            leftover = []
    verb = "would remove" if dry_run else "removed"
    print(f"{verb} {removed} task{'s' if removed != 1 else ''}")
    if reclaimed:
        print(f"{verb} {reclaimed} lost task record{'s' if reclaimed != 1 else ''}")
    if reclaimed_logs:
        print(f"{verb} {reclaimed_logs} unclaimed log{'s' if reclaimed_logs != 1 else ''}")
    if orphans_kept:
        print(
            f"{PROGRAM}: kept {orphans_kept} orphaned log{'s' if orphans_kept != 1 else ''};"
            f" run '{PROGRAM} orphans' to inspect or '{PROGRAM} clean --orphans' to delete",
            file=sys.stderr,
        )
    for path in leftover:
        print(f"{PROGRAM}: unclaimed log left in place: {path}", file=sys.stderr)
    for failure in failures:
        print(f"{PROGRAM}: {failure}", file=sys.stderr)
    for path in damaged:
        print(f"{PROGRAM}: damaged task record left in place: {path}", file=sys.stderr)
    return 1 if failures else 0


def print_orphans(as_json: bool) -> int:
    with registry_lock():
        tasks = list_tasks()
        records, damaged = read_records()
        unclaimed = unclaimed_logs(tasks)
    orphans = classify_records(records, tasks)["orphan"]
    if as_json:
        payload = {
            "schema_version": 1,
            "orphans": [
                {
                    "id": record.id,
                    "name": record.name,
                    "command": record.command,
                    "cwd": record.cwd,
                    "created": record.created,
                    "log": record.log,
                }
                for record in orphans
            ],
            "unclaimed_logs": [str(path) for path in unclaimed],
        }
        print(json.dumps(payload, indent=2, allow_nan=False))
    elif not orphans:
        print("no orphaned tasks")
    else:
        projects = [Path(record.cwd).name or record.cwd for record in orphans]
        name_width = max(len("NAME"), *(len(record.name) for record in orphans))
        project_width = max(len("PROJECT"), *(len(project) for project in projects))
        print(
            f"{'NAME':<{name_width}} {'AGE':<6} {'PROJECT':<{project_width}} COMMAND"
        )
        for record, project in zip(orphans, projects):
            print(
                f"{record.name:<{name_width}} {age(record.created):<6} "
                f"{project:<{project_width}} {shlex.join(record.command)}"
            )
    if not as_json:
        for path in unclaimed:
            print(f"{PROGRAM}: unclaimed log: {path}", file=sys.stderr)
    for path in damaged:
        print(f"{PROGRAM}: damaged task record left in place: {path}", file=sys.stderr)
    return 0


def watch_tasks(interval: float) -> int:
    if interval <= 0:
        raise CliLaneError("interval must be positive")
    while True:
        sys.stdout.write("\033[2J\033[H")
        print_tasks(list_tasks(), as_json=False)
        sys.stdout.flush()
        time.sleep(interval)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        prog=PROGRAM,
        description=(
            "Run and manage long-lived CLI tasks on one machine or across a "
            "configured fleet."
        ),
        epilog="""examples:
  clilane run codex-app -C ~/projects/sample-app -- codex
  clilane run kimi-research -C ~/projects/research -- kimi
  clilane list
  clilane fleet
  clilane status codex-app
  clilane attach codex-app

Only tasks started through clilane appear. Press Ctrl-Q to detach from a task.""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    root.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    commands = root.add_subparsers(dest="action", required=True)

    run = commands.add_parser(
        "run",
        help="start a managed task",
        description="Start a task in the background and return immediately.",
        usage="clilane run NAME [-C DIR] [--on-exit COMMAND] [--wait [--timeout SECONDS]] -- COMMAND [ARG ...]",
    )
    run.add_argument("name", help="unique task name")
    run.add_argument(
        "-C",
        "--cwd",
        metavar="DIR",
        default=os.getcwd(),
        help="task working directory (default: current directory)",
    )
    run.add_argument(
        "--wait",
        action="store_true",
        help="block until the command exits and return its exit status",
    )
    run.add_argument(
        "--on-exit",
        metavar="COMMAND",
        help="shell command to run after the task exits",
    )
    run.add_argument(
        "--timeout",
        type=float,
        help="seconds to wait with --wait before returning 124",
    )
    run.add_argument(
        "command",
        metavar="COMMAND",
        nargs=argparse.REMAINDER,
        help="command and arguments, preceded by --",
    )

    listing = commands.add_parser(
        "list", aliases=["ls", "ps"], help="list all managed tasks"
    )
    listing.add_argument("--json", action="store_true", help="emit JSON")

    fleet = commands.add_parser(
        "fleet",
        help="list managed tasks across configured SSH hosts",
        description="Read each configured host concurrently and return a fleet snapshot.",
    )
    fleet.add_argument(
        "--config",
        metavar="FILE",
        help=(
            "fleet config (default: $XDG_CONFIG_HOME/clilane/fleet.json or "
            "~/.config/clilane/fleet.json)"
        ),
    )
    fleet.add_argument(
        "--timeout",
        type=float,
        default=FLEET_DEFAULT_TIMEOUT,
        help=f"per-host timeout in seconds (default: {FLEET_DEFAULT_TIMEOUT:g})",
    )
    fleet.add_argument("--json", action="store_true", help="emit JSON")

    status = commands.add_parser("status", help="show one task in detail")
    status.add_argument("target", help="task name or ID prefix")
    status.add_argument("--json", action="store_true", help="emit JSON")

    attach = commands.add_parser("attach", help="attach to a task interactively")
    attach.add_argument("target", help="task name or ID prefix; Ctrl-Q detaches")

    read = commands.add_parser("read", help="print recent terminal output")
    read.add_argument("target", help="task name or ID prefix")
    read.add_argument("-a", "--all", action="store_true", help="print all scrollback")

    log = commands.add_parser("log", help="read the persistent task log")
    log.add_argument("target", help="task name or ID prefix")
    log.add_argument(
        "-n", "--lines", type=int, default=200, help="lines to show (default: 200)"
    )
    log.add_argument("-f", "--follow", action="store_true", help="follow new output")

    send = commands.add_parser("send", help="send text to a running task")
    send.add_argument("target", help="task name or ID prefix")
    send.add_argument("message", help="text to send")
    send.add_argument("--no-enter", action="store_true", help="do not press Enter")

    key = commands.add_parser(
        "key",
        help="press keys in a running task",
        description=(
            "Press one or more keys in a task's terminal, such as Enter, Escape, "
            "Up, Tab, BTab, or C-c."
        ),
        usage="clilane key TARGET KEY [KEY ...]",
    )
    key.add_argument("target", nargs="?", help="task name or ID prefix")
    key.add_argument("keys", metavar="KEY", nargs="*", help="key names to press in order")
    key.add_argument("--list", action="store_true", help="print supported key names")

    wait = commands.add_parser("wait", help="wait for a task to finish")
    wait.add_argument("target", help="task name or ID prefix")
    wait.add_argument("--timeout", type=float, help="timeout in seconds")

    stop = commands.add_parser("stop", help="stop a task without removing it")
    stop.add_argument("target", help="task name or ID prefix")
    stop.add_argument(
        "--grace", type=float, default=3, help="seconds before SIGKILL (default: 3)"
    )

    remove = commands.add_parser(
        "rm", aliases=["remove"], help="remove a stopped or completed task"
    )
    remove.add_argument("target", help="task name or ID prefix")
    remove.add_argument("--force", action="store_true", help="stop first if running")
    remove.add_argument(
        "--grace", type=float, default=3, help="seconds before SIGKILL (default: 3)"
    )

    clean = commands.add_parser(
        "clean",
        help="remove completed, stopped, and lost tasks",
        description=(
            "Remove completed and stopped tasks, and reclaim records left behind "
            "by an interrupted removal or a lost tmux server."
        ),
    )
    clean.add_argument(
        "--dry-run", action="store_true", help="report without removing anything"
    )
    clean.add_argument(
        "--orphans",
        action="store_true",
        help="also delete orphaned logs preserved from a lost tmux server",
    )

    orphans = commands.add_parser(
        "orphans",
        help="list tasks orphaned by a lost tmux server",
        description=(
            "List tasks whose tmux server died but whose logs survive. "
            "Read their logs with normal file tools; delete with 'clean --orphans'."
        ),
    )
    orphans.add_argument("--json", action="store_true", help="emit JSON")

    watch = commands.add_parser("watch", help="refresh the task list continuously")
    watch.add_argument(
        "--interval", type=float, default=1, help="refresh seconds (default: 1)"
    )

    return root


def execute(arguments: argparse.Namespace) -> int:
    if arguments.action == "run":
        spec = run_spec(arguments.cwd, arguments.on_exit, arguments.command)
        wait = arguments.wait or spec.wait
        timeout = spec.timeout
        if arguments.timeout is not None:
            timeout = positive_timeout(str(arguments.timeout))
        if timeout is not None and not wait:
            raise CliLaneError("--timeout requires --wait")
        task = run_task(arguments.name, spec.cwd, spec.command, spec.on_exit)
        print(f"created {task.name} {task.id[:8]}")
        if wait:
            return wait_task(task.id, timeout)
        return 0
    if arguments.action in {"list", "ls", "ps"}:
        print_tasks(list_tasks(), arguments.json)
        return 0
    if arguments.action == "fleet":
        hosts = load_fleet_hosts(arguments.config)
        return print_fleet_results(
            collect_fleet(hosts, arguments.timeout), arguments.json
        )
    if arguments.action == "status":
        print_status(resolve_task(arguments.target), arguments.json)
        return 0
    if arguments.action == "attach":
        return attach_task(resolve_task(arguments.target))
    if arguments.action == "read":
        return read_task(resolve_task(arguments.target), arguments.all)
    if arguments.action == "log":
        return log_task(resolve_task(arguments.target), arguments.lines, arguments.follow)
    if arguments.action == "send":
        return send_task(arguments.target, arguments.message, not arguments.no_enter)
    if arguments.action == "key":
        if arguments.list:
            if arguments.target or arguments.keys:
                raise CliLaneError("--list takes no other arguments")
            return print_key_names()
        if not arguments.target:
            raise CliLaneError("missing task target")
        if not arguments.keys and is_key_name(arguments.target):
            raise CliLaneError(
                f"missing task target; usage: {PROGRAM} key TARGET KEY [KEY ...]"
            )
        return key_task(arguments.target, arguments.keys)
    if arguments.action == "wait":
        return wait_task(arguments.target, arguments.timeout)
    if arguments.action == "stop":
        task = stop_task(arguments.target, arguments.grace)
        print(f"{task.state} {task.name}")
        return 0
    if arguments.action in {"rm", "remove"}:
        task = remove_task(arguments.target, arguments.force, arguments.grace)
        print(f"removed {task.name}")
        return 0
    if arguments.action == "clean":
        return clean_tasks(arguments.dry_run, arguments.orphans)
    if arguments.action == "orphans":
        return print_orphans(arguments.json)
    if arguments.action == "watch":
        return watch_tasks(arguments.interval)
    raise CliLaneError(f"unknown action: {arguments.action}")


def main() -> int:
    try:
        if len(sys.argv) == 3 and sys.argv[1] == "__supervise":
            return supervise(sys.argv[2])
        if len(sys.argv) == 5 and sys.argv[1] == "__log":
            max_bytes = optional_int(sys.argv[3])
            if max_bytes is None:
                raise CliLaneError("invalid log size")
            return sink_log(sys.argv[2], max_bytes, sys.argv[4])
        return execute(parser().parse_args())
    except CliLaneError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        return 1
    except FleetSignal as error:
        return 128 + error.signum
    except OSError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
