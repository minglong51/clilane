def fleet_remote_command(script_body: str) -> str:
    script = (
        "{ "
        f"printf \"%s\\n\" {shlex.quote(FLEET_SENTINEL)}; "
        f"clilane --version && {script_body}; }} 2>&1"
    )
    return "/bin/sh -c " + shlex.quote(
        "if command -v zsh >/dev/null 2>&1; "
        f"then exec zsh -lc {shlex.quote(script)}; "
        f"fi; exec /bin/sh -lc {shlex.quote(script)}"
    )


FLEET_REMOTE_COMMAND = fleet_remote_command("clilane list --json")
TMUX_MIN_VERSION = (3, 3)
