class CliLaneError(Exception):
    pass


class FleetSignal(Exception):
    def __init__(self, signum: int) -> None:
        self.signum = signum


@dataclass(frozen=True)
class Task:
    session: str
    pane: str
    id: str
    name: str
    command: list[str]
    cwd: str
    created: str
    log: str
    committed: bool
    process_started: str | None
    stop_requested: bool
    dead: bool
    exit_code: int | None
    signal_name: str | None
    pid: int | None
    attached: bool
    origin: str

    @property
    def state(self) -> str:
        if not self.committed:
            return TASK_STATE_INITIALIZING
        if not self.dead:
            return TASK_STATE_RUNNING
        if self.stop_requested:
            return TASK_STATE_STOPPED
        if self.signal_name:
            return TASK_STATE_FAILED
        if self.exit_code == 0:
            return TASK_STATE_SUCCEEDED
        return TASK_STATE_FAILED

    @property
    def result_code(self) -> int:
        if self.signal_name:
            number = getattr(signal, self.signal_name, None)
            if isinstance(number, int):
                return 128 + number
            return 1
        return self.exit_code if self.exit_code is not None else 1

    def as_dict(self) -> dict[str, object]:
        return {
            "id": self.id,
            "name": self.name,
            "state": self.state,
            "command": self.command,
            "cwd": self.cwd,
            "created": self.created,
            "log": self.log,
            "pid": self.pid if not self.dead else None,
            "attached": self.attached,
            "exit_code": self.exit_code if self.dead else None,
            "signal": self.signal_name if self.dead else None,
        }


@dataclass(frozen=True)
class RunRequest:
    name: str
    cwd: str | None
    cwd_explicit: bool
    wait: bool
    timeout: float | None
    on_exit: str | None
    profile: str | None
    command: tuple[str, ...] | None


@dataclass(frozen=True)
class Profile:
    name: str
    provider: str
    command: tuple[str, ...]
    cwd_mode: str
    cwd_path: str | None
    inherit: tuple[str, ...]
    env_set: tuple[tuple[str, str], ...]

    def canonical_value(self) -> dict[str, object]:
        cwd: dict[str, str] = {"mode": self.cwd_mode}
        if self.cwd_path is not None:
            cwd["path"] = self.cwd_path
        return {
            "name": self.name,
            "provider": self.provider,
            "command": list(self.command),
            "cwd": cwd,
            "env": {
                "inherit": list(self.inherit),
                "set": dict(self.env_set),
            },
        }


@dataclass(frozen=True)
class LaunchSpec:
    name: str
    cwd: str
    command: tuple[str, ...]
    wait: bool
    timeout: float | None
    on_exit: str | None
    environment: dict[str, str]
    profile: str | None
    provider: str | None


@dataclass(frozen=True)
class FleetHost:
    name: str
    transport: str
    destination: str | None


@dataclass(frozen=True)
class FleetResult:
    name: str
    status: str
    clilane_version: str | None
    tasks: list[dict[str, object]]
    error_kind: str | None
    error_message: str | None

    def as_dict(self) -> dict[str, object]:
        error = None
        if self.error_kind and self.error_message:
            error = {"kind": self.error_kind, "message": self.error_message}
        return {
            "name": self.name,
            "status": self.status,
            "clilane_version": self.clilane_version,
            "tasks": self.tasks,
            "error": error,
        }


def tmux_binary() -> str:
    if TMUX_BINARY_OVERRIDE is not None:
        return TMUX_BINARY_OVERRIDE
    binary = shutil.which("tmux")
    if not binary:
        raise CliLaneError("tmux is required")
    return binary


def tmux_socket_arguments() -> list[str]:
    socket_path = TMUX_SOCKET_OVERRIDE or SOCKET
    return ["-S", socket_path] if Path(socket_path).is_absolute() else ["-L", socket_path]


def tmux_command_argument(value: str) -> str:
    return value[:-1] + "\\;" if value.endswith(";") else value


def ensure_tmux_version() -> None:
    completed = subprocess.run(
        [tmux_binary(), "-V"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=tmux_client_environment(),
        check=False,
    )
    reported = completed.stdout.decode(errors="replace").strip()
    matched = TMUX_VERSION_PATTERN.search(reported)
    if completed.returncode != 0 or not matched:
        raise CliLaneError(f"could not determine the tmux version: {reported!r}")
    version = (int(matched.group(1)), int(matched.group(2)))
    if version < TMUX_MIN_VERSION:
        floor = ".".join(str(part) for part in TMUX_MIN_VERSION)
        raise CliLaneError(
            f"tmux {floor} or newer is required for exit-status reporting; "
            f"found {reported}"
        )


def tmux_client_environment() -> dict[str, str]:
    return {
        key: value
        for key, value in os.environ.items()
        if key in TMUX_ENV_KEYS or key.startswith("LC_")
    }


def tmux(
    arguments: Sequence[str],
    *,
    input_data: bytes | None = None,
    check: bool = True,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[bytes]:
    try:
        completed = subprocess.run(
            [tmux_binary(), *tmux_socket_arguments(), "-f", "/dev/null", *arguments],
            input=input_data,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=tmux_client_environment(),
            check=False,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise CliLaneError(f"tmux timed out after {timeout:g} seconds") from error
    if check and completed.returncode != 0:
        detail = completed.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or f"tmux exited {completed.returncode}")
    return completed


def configure_tmux_control(binary: str, socket_path: str) -> None:
    global TMUX_BINARY_OVERRIDE, TMUX_SOCKET_OVERRIDE
    if not Path(binary).is_absolute() or not Path(socket_path).is_absolute():
        raise CliLaneError("invalid managed tmux control path")
    TMUX_BINARY_OVERRIDE = binary
    TMUX_SOCKET_OVERRIDE = socket_path


def tmux_server_absent(completed: subprocess.CompletedProcess[bytes]) -> bool:
    detail = completed.stderr.decode(errors="replace").lower()
    return "no server running" in detail or (
        "error connecting to " in detail and "no such file or directory" in detail
    )


def state_root_path() -> Path:
    configured = os.environ.get("CLILANE_STATE_HOME") or os.environ.get("AGT_STATE_HOME")
    if configured:
        root = Path(configured).expanduser()
    elif os.environ.get("XDG_STATE_HOME"):
        root = Path(os.environ["XDG_STATE_HOME"]).expanduser() / PROGRAM
    else:
        root = Path.home() / ".local" / "state" / PROGRAM
    if not root.is_absolute():
        raise CliLaneError(
            "CLILANE_STATE_HOME, AGT_STATE_HOME, and XDG_STATE_HOME must be absolute"
        )
    return root.resolve()


def state_root() -> Path:
    root = state_root_path()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    return root


def config_file_path(configured: str | None, filename: str) -> Path:
    if configured:
        return Path(configured).expanduser().resolve()
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        root = Path(xdg).expanduser()
        if not root.is_absolute():
            raise CliLaneError("XDG_CONFIG_HOME must be absolute")
    else:
        root = Path.home() / ".config"
    return (root / PROGRAM / filename).resolve()


def fleet_config_path(configured: str | None) -> Path:
    return config_file_path(configured, "fleet.json")


def hub_config_path(configured: str | None) -> Path:
    return config_file_path(configured, "hub.json")


def profiles_config_path(environment: Mapping[str, str] | None = None) -> Path:
    source = os.environ if environment is None else environment
    xdg = source.get("XDG_CONFIG_HOME")
    if xdg:
        root = Path(xdg).expanduser()
        if not root.is_absolute():
            raise CliLaneError("XDG_CONFIG_HOME must be absolute")
    else:
        home = source.get("HOME")
        root = (Path(home).expanduser() if home else Path.home()) / ".config"
        if not root.is_absolute():
            raise CliLaneError("HOME must be absolute")
    return root / PROGRAM / "profiles.json"


def fleet_name(value: object, field: str) -> str:
    if not isinstance(value, str) or not NAME_PATTERN.fullmatch(value):
        raise CliLaneError(
            f"{field} must be 1-64 characters, beginning with a letter or number "
            "and using only letters, numbers, dot, dash, or underscore"
        )
    return value


def reject_json_constant(value: str) -> object:
    raise ValueError(f"invalid JSON constant: {value}")


def finite_json_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed):
        raise ValueError(f"non-finite JSON number: {value}")
    return parsed


def bounded_json_int(value: str) -> int:
    if len(value.removeprefix("-")) > FLEET_MAX_INTEGER_DIGITS:
        raise ValueError("JSON integer is too large")
    return int(value)


def unique_json_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    decoded: dict[str, object] = {}
    for key, value in pairs:
        if key in decoded:
            raise ValueError(f"duplicate JSON field: {key!r}")
        decoded[key] = value
    return decoded


def strict_json(raw: bytes, path: Path, label: str) -> object:
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise CliLaneError(f"{label} is not UTF-8: {str(path)!r}") from error
    try:
        decoded = json.loads(
            text,
            object_pairs_hook=unique_json_object,
            parse_constant=reject_json_constant,
            parse_float=finite_json_float,
            parse_int=bounded_json_int,
        )
        validate_json_strings(decoded)
        return decoded
    except (json.JSONDecodeError, RecursionError, UnicodeEncodeError, ValueError) as error:
        raise CliLaneError(f"invalid {label} JSON: {str(path)!r}: {error}") from error


def validate_json_strings(value: object) -> None:
    if isinstance(value, str):
        value.encode("utf-8")
        return
    if isinstance(value, list):
        for item in value:
            validate_json_strings(item)
        return
    if isinstance(value, dict):
        for key, item in value.items():
            key.encode("utf-8")
            validate_json_strings(item)


def secure_profile_bytes(path: Path) -> bytes:
    nofollow = getattr(os, "O_NOFOLLOW", None)
    if nofollow is None:
        raise CliLaneError("this platform cannot safely open profile files")
    flags = (
        os.O_RDONLY
        | nofollow
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        if error.errno in {errno.ELOOP, errno.EMLINK}:
            raise CliLaneError(f"profiles file must not be a symlink: {str(path)!r}") from None
        if error.errno == errno.ENOENT:
            raise CliLaneError(f"profiles file not found: {str(path)!r}") from None
        raise CliLaneError(f"could not open profiles file: {error}") from error
    try:
        details = os.fstat(descriptor)
        if not stat.S_ISREG(details.st_mode):
            raise CliLaneError(f"profiles file must be a regular file: {str(path)!r}")
        if details.st_uid != os.getuid():
            raise CliLaneError(f"profiles file must be owned by the current user: {str(path)!r}")
        if details.st_mode & 0o022:
            raise CliLaneError(
                f"profiles file must not be writable by group or others: {str(path)!r}"
            )
        if details.st_size > CONFIG_MAX_BYTES:
            raise CliLaneError(f"profiles file exceeds the 256 KiB limit: {str(path)!r}")
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            raw = handle.read(CONFIG_MAX_BYTES + 1)
    finally:
        os.close(descriptor)
    if len(raw) > CONFIG_MAX_BYTES:
        raise CliLaneError(f"profiles file exceeds the 256 KiB limit: {str(path)!r}")
    return raw


def exact_fields(value: object, expected: set[str], label: str) -> dict[str, object]:
    if not isinstance(value, dict):
        raise CliLaneError(f"{label} must be an object")
    unexpected = set(value) - expected
    if unexpected:
        raise CliLaneError(f"unexpected {label} field: {sorted(unexpected)[0]!r}")
    missing = expected - set(value)
    if missing:
        raise CliLaneError(f"missing {label} field: {sorted(missing)[0]!r}")
    return value


def validated_argv(value: object, label: str) -> tuple[str, ...]:
    if not isinstance(value, list) or not value:
        raise CliLaneError(f"{label} must be a non-empty array of strings")
    command: list[str] = []
    for part in value:
        if not isinstance(part, str) or not part or "\x00" in part:
            raise CliLaneError(f"{label} entries must be non-empty strings without NUL")
        command.append(part)
    return tuple(command)


def validated_environment_name(value: object, label: str) -> str:
    if not isinstance(value, str) or not ENV_PATTERN.fullmatch(value):
        raise CliLaneError(f"{label} is not a valid environment name")
    return value


def profile_owned_environment(name: str) -> bool:
    return name in PROFILE_OWNED_EXACT_ENV or name.startswith(
        PROFILE_OWNED_ENV_PREFIXES
    )


def validate_profile_environment_name(name: str, label: str) -> None:
    if profile_owned_environment(name):
        raise CliLaneError(f"{label} is reserved by CLI Lane: {name}")


def parse_profile(name_value: object, value: object) -> Profile:
    name = fleet_name(name_value, "profile name")
    entry = exact_fields(
        value, {"provider", "command", "cwd", "env"}, f"profile {name!r}"
    )
    provider = fleet_name(entry["provider"], f"profile {name!r} provider")
    command = validated_argv(entry["command"], f"profile {name!r} command")

    cwd_value = entry["cwd"]
    if not isinstance(cwd_value, dict):
        raise CliLaneError(f"profile {name!r} cwd must be an object")
    mode = cwd_value.get("mode")
    if mode == "explicit":
        exact_fields(cwd_value, {"mode"}, f"profile {name!r} cwd")
        cwd_path = None
    elif mode == "fixed":
        exact_fields(cwd_value, {"mode", "path"}, f"profile {name!r} cwd")
        path_value = cwd_value["path"]
        if (
            not isinstance(path_value, str)
            or not path_value
            or "\x00" in path_value
            or not Path(path_value).is_absolute()
        ):
            raise CliLaneError(f"profile {name!r} fixed cwd path must be absolute")
        cwd_path = path_value
    else:
        raise CliLaneError(f"profile {name!r} cwd mode must be 'explicit' or 'fixed'")

    env = exact_fields(entry["env"], {"inherit", "set"}, f"profile {name!r} env")
    inherit_value = env["inherit"]
    if not isinstance(inherit_value, list):
        raise CliLaneError(f"profile {name!r} env.inherit must be an array")
    inherit: list[str] = []
    seen_inherit: set[str] = set()
    for item in inherit_value:
        inherited = validated_environment_name(item, f"profile {name!r} env.inherit entry")
        validate_profile_environment_name(inherited, f"profile {name!r} env.inherit")
        if inherited in seen_inherit:
            raise CliLaneError(f"profile {name!r} env.inherit contains duplicate {inherited!r}")
        seen_inherit.add(inherited)
        inherit.append(inherited)

    set_value = env["set"]
    if not isinstance(set_value, dict):
        raise CliLaneError(f"profile {name!r} env.set must be an object")
    assignments: list[tuple[str, str]] = []
    for key, item in set_value.items():
        assigned = validated_environment_name(key, f"profile {name!r} env.set key")
        validate_profile_environment_name(assigned, f"profile {name!r} env.set")
        if assigned.upper().endswith(PROFILE_SECRET_SUFFIXES):
            raise CliLaneError(
                f"profile {name!r} env.set secret-looking key must use env.inherit: {assigned}"
            )
        if not isinstance(item, str) or "\x00" in item:
            raise CliLaneError(f"profile {name!r} env.set values must be strings without NUL")
        assignments.append((assigned, item))

    return Profile(
        name=name,
        provider=provider,
        command=command,
        cwd_mode=mode,
        cwd_path=cwd_path,
        inherit=tuple(inherit),
        env_set=tuple(assignments),
    )


def load_profiles(path: Path | None = None) -> dict[str, Profile]:
    selected_path = profiles_config_path() if path is None else path
    decoded = strict_json(secure_profile_bytes(selected_path), selected_path, "profiles file")
    root = exact_fields(decoded, {"schema_version", "profiles"}, "profiles file")
    schema_version = root["schema_version"]
    if type(schema_version) is not int or schema_version != PROFILE_CONFIG_SCHEMA_VERSION:
        raise CliLaneError(f"unsupported profiles schema_version: {schema_version!r}")
    entries = root["profiles"]
    if not isinstance(entries, dict):
        raise CliLaneError("profiles must be an object")
    profiles: dict[str, Profile] = {}
    for name, value in entries.items():
        profile = parse_profile(name, value)
        profiles[profile.name] = profile
    return profiles


def load_fleet_hosts(configured: str | None) -> list[FleetHost]:
    path = fleet_config_path(configured)
    if not path.is_file():
        raise CliLaneError(
            f"fleet config not found: {str(path)!r}; create it or pass --config FILE"
        )
    try:
        document = json.loads(
            path.read_text(encoding="utf-8"),
            parse_constant=reject_json_constant,
            parse_float=finite_json_float,
            parse_int=bounded_json_int,
        )
    except UnicodeDecodeError as error:
        raise CliLaneError(f"fleet config is not UTF-8: {str(path)!r}") from error
    except (json.JSONDecodeError, RecursionError, ValueError) as error:
        raise CliLaneError(
            f"invalid fleet config JSON: {str(path)!r}: {error}"
        ) from error
    if not isinstance(document, dict):
        raise CliLaneError("fleet config must be a JSON object")
    expected_root = {"schema_version", "hosts"}
    unexpected_root = set(document) - expected_root
    if unexpected_root:
        raise CliLaneError(
            f"unexpected fleet config field: {sorted(unexpected_root)[0]!r}"
        )
    if set(document) != expected_root:
        missing = sorted(expected_root - set(document))[0]
        raise CliLaneError(f"missing fleet config field: {missing}")
    schema_version = document["schema_version"]
    if (
        type(schema_version) is not int
        or schema_version != FLEET_CONFIG_SCHEMA_VERSION
    ):
        raise CliLaneError(
            f"unsupported fleet config schema_version: {schema_version!r}"
        )
    entries = document["hosts"]
    if not isinstance(entries, list) or not entries:
        raise CliLaneError("fleet config hosts must be a non-empty array")
    if len(entries) > FLEET_MAX_HOSTS:
        raise CliLaneError(f"fleet config supports at most {FLEET_MAX_HOSTS} hosts")
    hosts: list[FleetHost] = []
    names: set[str] = set()
    local_count = 0
    for index, entry in enumerate(entries):
        if not isinstance(entry, dict):
            raise CliLaneError(f"fleet host {index + 1} must be a JSON object")
        transport = entry.get("transport")
        expected = {"name", "transport"}
        if transport == "ssh":
            expected.add("destination")
        elif transport != "local":
            raise CliLaneError(f"unsupported fleet transport for host {index + 1}")
        unexpected = set(entry) - expected
        if unexpected:
            raise CliLaneError(
                f"unexpected field for fleet host {index + 1}: {sorted(unexpected)[0]!r}"
            )
        if set(entry) != expected:
            missing = sorted(expected - set(entry))[0]
            raise CliLaneError(f"missing field for fleet host {index + 1}: {missing}")
        name = fleet_name(entry["name"], f"fleet host {index + 1} name")
        if name in names:
            raise CliLaneError(f"duplicate fleet host name: {name}")
        names.add(name)
        destination = None
        if transport == "local":
            local_count += 1
        else:
            destination = fleet_name(
                entry["destination"], f"fleet host {index + 1} destination"
            )
        hosts.append(FleetHost(name, transport, destination))
    if local_count != 1:
        raise CliLaneError("fleet config must contain exactly one local host")
    return hosts


def legacy_state_roots() -> tuple[Path, ...]:
    roots = [Path.home() / ".local" / "state" / "agt"]
    configured = os.environ.get("AGT_STATE_HOME")
    if configured:
        candidate = Path(configured).expanduser()
        if candidate.is_absolute():
            roots.append(candidate)
    xdg = os.environ.get("XDG_STATE_HOME")
    if xdg:
        candidate = Path(xdg).expanduser()
        if candidate.is_absolute():
            roots.append(candidate / "agt")
    return tuple(root.resolve() for root in roots)


def control_root() -> Path:
    root = (state_root() / "control").resolve()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    return root


def socket_identity() -> str:
    return SOCKET


def socket_digest() -> str:
    return hashlib.sha256(socket_identity().encode()).hexdigest()[:16]


def registry_root() -> Path:
    root = (state_root() / "registry" / socket_digest()).resolve()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    return root


@dataclass(frozen=True)
class TaskRecord:
    id: str
    name: str
    command: list[str]
    cwd: str
    created: str
    log: str
    session: str
    socket: str
    phase: str
    path: str


def write_record(
    task_id: str,
    name: str,
    command: Sequence[str],
    cwd: str,
    created: str,
    log: str,
    session: str,
    phase: str,
) -> None:
    payload = {
        "schema_version": RECORD_SCHEMA_VERSION,
        "socket": socket_identity(),
        "session": session,
        "id": task_id,
        "name": name,
        "command": list(command),
        "cwd": cwd,
        "created": created,
        "log": log,
        "phase": phase,
    }
    root = registry_root()
    final = root / f"{task_id}.json"
    temp = root / f".{task_id}.{uuid.uuid4().hex}.tmp"
    descriptor = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), allow_nan=False))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, final)
    finally:
        temp.unlink(missing_ok=True)
    directory = os.open(root, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def delete_record(task_id: str) -> None:
    root = registry_root()
    (root / f"{task_id}.json").unlink(missing_ok=True)
    for leftover in root.glob(f".{task_id}.*.tmp"):
        leftover.unlink(missing_ok=True)


def read_record(path: Path) -> TaskRecord:
    try:
        decoded = json.loads(
            path.read_text(encoding="utf-8"),
            parse_constant=reject_json_constant,
            parse_float=finite_json_float,
            parse_int=bounded_json_int,
        )
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RecursionError, ValueError) as error:
        raise CliLaneError(f"damaged task record: {str(path)!r}") from error
    if not isinstance(decoded, dict) or set(decoded) != set(RECORD_FIELDS):
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    if decoded["schema_version"] != RECORD_SCHEMA_VERSION:
        raise CliLaneError(f"unsupported task record schema: {str(path)!r}")
    for field in ("socket", "session", "id", "name", "cwd", "created", "log", "phase"):
        if not isinstance(decoded[field], str):
            raise CliLaneError(f"damaged task record: {str(path)!r}")
    command = decoded["command"]
    if not isinstance(command, list) or not command or not all(
        isinstance(part, str) for part in command
    ):
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    if decoded["phase"] not in RECORD_PHASES:
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    if decoded["id"] != path.stem:
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    derived = f"{SESSION_PREFIX}{decoded['id'].replace('-', '')[:12]}"
    if decoded["session"] != derived:
        raise CliLaneError(f"damaged task record: {str(path)!r}")
    return TaskRecord(
        id=decoded["id"],
        name=decoded["name"],
        command=command,
        cwd=decoded["cwd"],
        created=decoded["created"],
        log=decoded["log"],
        session=decoded["session"],
        socket=decoded["socket"],
        phase=decoded["phase"],
        path=str(path),
    )


def read_records() -> tuple[list[TaskRecord], list[Path]]:
    records: list[TaskRecord] = []
    damaged: list[Path] = []
    for path in sorted(registry_root().glob("*.json")):
        try:
            record = read_record(path)
        except CliLaneError:
            damaged.append(path)
            continue
        if record.socket == socket_identity():
            records.append(record)
    return records, damaged


def claimed_log_paths() -> set[Path]:
    claimed: set[Path] = set()
    registry = (state_root() / "registry").resolve()
    if not registry.is_dir():
        return claimed
    for path in registry.glob("*/*.json"):
        try:
            decoded = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError, RecursionError):
            continue
        if isinstance(decoded, dict) and isinstance(decoded.get("log"), str):
            claimed.add(Path(decoded["log"]).expanduser().resolve())
    return claimed


def record_from_task(task: Task, phase: str) -> None:
    write_record(
        task.id,
        task.name,
        task.command,
        task.cwd,
        task.created,
        task.log,
        task.session,
        phase,
    )


def backfill_records(tasks: Sequence[Task]) -> None:
    on_disk = {record.id: record for record in read_records()[0]}
    for task in tasks:
        if not task.committed or not task.id or not task.log:
            continue
        existing = on_disk.get(task.id)
        if existing is None or existing.phase == RECORD_PHASE_PENDING:
            record_from_task(task, RECORD_PHASE_LIVE)


@contextmanager
def registry_lock() -> Iterator[None]:
    digest = socket_digest()
    path = control_root() / f"{digest}.lock"
    with path.open("a+b") as handle:
        os.chmod(path, 0o600)
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def acquire_task_lock(task_id: str, exclusive: bool) -> BinaryIO:
    digest = hashlib.sha256(task_id.encode()).hexdigest()
    path = control_root() / f"task-{digest}.lock"
    handle = path.open("a+b")
    os.chmod(path, 0o600)
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
    return handle


def release_task_lock(handle: BinaryIO) -> None:
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    finally:
        handle.close()


def expected_log_paths(task_id: str) -> set[Path]:
    return {
        (root / "logs" / f"{task_id}.log").resolve()
        for root in (state_root(), *legacy_state_roots())
    }


def validated_log_path(task: Task) -> Path:
    actual = Path(task.log).expanduser().resolve()
    if actual not in expected_log_paths(task.id):
        raise CliLaneError(f"refusing unexpected log path for {task.name}")
    return actual


def validated_record_log_path(record: TaskRecord) -> Path:
    actual = Path(record.log).expanduser().resolve()
    if actual not in expected_log_paths(record.id):
        raise CliLaneError(f"refusing unexpected log path for {record.name}")
    return actual


def encode_meta(meta: dict[str, object]) -> str:
    raw = json.dumps(meta, separators=(",", ":"), ensure_ascii=False).encode()
    return base64.urlsafe_b64encode(raw).decode()


def decode_meta(value: str) -> dict[str, object]:
    try:
        raw = base64.urlsafe_b64decode(value.encode())
        decoded = json.loads(raw)
    except (ValueError, json.JSONDecodeError) as error:
        raise CliLaneError("corrupt task metadata") from error
    if not isinstance(decoded, dict):
        raise CliLaneError("corrupt task metadata")
    return decoded


def encode_launcher(
    command: Sequence[str],
    on_exit: str | None,
    name: str,
    task_id: str,
    log_path: str,
    environment_keys: Sequence[str],
) -> str:
    return encode_meta(
        {
            "command": list(command),
            "on_exit": on_exit,
            "name": name,
            "id": task_id,
            "log": log_path,
            "environment_keys": list(environment_keys),
        }
    )


def decode_launcher(value: str) -> dict[str, object]:
    decoded = decode_meta(value)
    command = decoded.get("command")
    if not isinstance(command, list) or not all(isinstance(part, str) for part in command):
        raise CliLaneError("corrupt launcher command")
    if not command:
        raise CliLaneError("empty launcher command")
    on_exit = decoded.get("on_exit")
    if on_exit is not None and not isinstance(on_exit, str):
        raise CliLaneError("corrupt launcher hook")
    for key in ("name", "id", "log"):
        if not isinstance(decoded.get(key), str):
            raise CliLaneError("corrupt launcher metadata")
    environment_keys = decoded.get("environment_keys")
    if (
        not isinstance(environment_keys, list)
        or not all(isinstance(key, str) for key in environment_keys)
        or environment_keys != sorted(set(environment_keys))
    ):
        raise CliLaneError("corrupt launcher environment")
    for key in environment_keys:
        validated_environment_name(key, "launcher environment key")
    return decoded


def process_start_time(pid: int) -> str | None:
    if sys.platform == "linux":
        try:
            stat = Path(f"/proc/{pid}/stat").read_text(errors="replace")
        except OSError:
            return None
        _, separator, rest = stat.rpartition(")")
        if not separator:
            return None
        fields = rest.split()
        if len(fields) < 20:
            return None
        return fields[19]
    completed = subprocess.run(
        ["/bin/ps", "-p", str(pid), "-o", "lstart="],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=tmux_client_environment(),
        check=False,
    )
    if completed.returncode != 0:
        return None
    value = " ".join(completed.stdout.decode(errors="replace").split())
    return value or None


def process_is_zombie(pid: int) -> bool:
    if sys.platform == "linux":
        try:
            stat = Path(f"/proc/{pid}/stat").read_text(errors="replace")
        except OSError:
            return False
        _, separator, rest = stat.rpartition(")")
        if not separator:
            return False
        fields = rest.split()
        return bool(fields) and fields[0] in {"Z", "X", "x"}
    completed = subprocess.run(
        ["/bin/ps", "-p", str(pid), "-o", "state="],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=tmux_client_environment(),
        check=False,
    )
    if completed.returncode != 0:
        return False
    return completed.stdout.decode(errors="replace").strip().startswith("Z")


def all_pids() -> list[int]:
    if sys.platform == "linux":
        try:
            entries = os.listdir("/proc")
        except OSError as error:
            raise CliLaneError("unable to inspect managed process session") from error
        return [int(entry) for entry in entries if entry.isdigit()]
    completed = subprocess.run(
        ["/bin/ps", "-axo", "pid="],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=tmux_client_environment(),
        check=False,
    )
    if completed.returncode != 0:
        raise CliLaneError("unable to inspect managed process session")
    found = []
    for line in completed.stdout.decode(errors="replace").splitlines():
        pid = optional_int(line.strip())
        if pid is not None:
            found.append(pid)
    return found


def session_pids(session_id: int) -> list[int]:
    found: list[int] = []
    for pid in all_pids():
        with suppress(ProcessLookupError):
            if os.getsid(pid) == session_id and not process_is_zombie(pid):
                found.append(pid)
    return found


def signal_session(session_id: int, sent_signal: signal.Signals, include_leader: bool) -> None:
    pids = session_pids(session_id)
    pids.sort(key=lambda pid: pid == session_id)
    for pid in pids:
        if pid == session_id and not include_leader:
            continue
        with suppress(ProcessLookupError):
            if os.getsid(pid) == session_id:
                os.kill(pid, sent_signal)


def terminate_session_descendants(
    session_id: int,
    grace: float,
    leader_started: str | None = None,
) -> None:
    term_deadline = time.monotonic() + max(0, grace)
    kill_deadline = term_deadline + 2
    while True:
        descendants = [pid for pid in session_pids(session_id) if pid != session_id]
        if not descendants:
            return
        current_started = process_start_time(session_id)
        if leader_started and current_started and current_started != leader_started:
            raise CliLaneError("managed session leader changed with live descendants")
        now = time.monotonic()
        sent_signal = signal.SIGTERM if now < term_deadline else signal.SIGKILL
        if sent_signal == signal.SIGTERM:
            signal_session(session_id, signal.SIGCONT, include_leader=False)
        signal_session(session_id, sent_signal, include_leader=False)
        if now >= kill_deadline:
            raise CliLaneError("managed descendants survived SIGKILL")
        time.sleep(0.05)


def terminate_pane_process(
    pane: str,
    grace: float,
    leader_started: str | None = None,
) -> None:
    details = tmux(
        ["display-message", "-p", "-t", pane, f"#{{pane_dead}}{FIELD_SEPARATOR}#{{pane_pid}}"],
        check=False,
    )
    if details.returncode != 0:
        detail = details.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or f"could not inspect managed pane: {pane}")
    values = details.stdout.decode().strip().split(FIELD_SEPARATOR)
    if len(values) != 2:
        return
    pid = optional_int(values[1])
    if pid is None:
        raise CliLaneError("managed pane has no process id")
    if values[0] == "1":
        descendants = session_pids(pid)
        if not descendants:
            return
        current_started = process_start_time(pid)
        if current_started and not leader_started:
            return
        if leader_started and current_started and current_started != leader_started:
            return
        terminate_session_descendants(pid, grace, leader_started)
        return
    started = process_start_time(pid)
    if not started:
        return
    if leader_started and started != leader_started:
        raise CliLaneError("managed pane process identity changed")
    try:
        session_id = os.getsid(pid)
    except ProcessLookupError:
        return
    if session_id != pid:
        raise CliLaneError("refusing an unverified managed pane process")
    with suppress(ProcessLookupError):
        os.kill(pid, signal.SIGCONT)
        os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + max(0, grace)
    while time.monotonic() < deadline:
        if not session_pids(pid):
            return
        time.sleep(0.05)
    terminate_session_descendants(pid, 0, started)
    if process_start_time(pid) == started:
        with suppress(ProcessLookupError):
            if os.getsid(pid) == pid:
                os.kill(pid, signal.SIGKILL)
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        if not session_pids(pid):
            return
        time.sleep(0.05)
    raise CliLaneError("managed pane process did not terminate")


def terminate_incomplete_session(
    session: str,
    pane: str,
    grace: float,
    leader_started: str | None = None,
) -> None:
    panes = [pane] if pane else []
    if not panes:
        listed = tmux(["list-panes", "-t", session, "-F", "#{pane_id}"], check=False)
        if listed.returncode != 0:
            if tmux_session_absent(session):
                return
            detail = listed.stderr.decode(errors="replace").strip()
            raise CliLaneError(detail or f"could not inspect managed session: {session}")
        panes = listed.stdout.decode().split()
    for target in panes:
        terminate_pane_process(target, grace, leader_started)


def parse_tmux_environment_script(value: str) -> dict[str, str]:
    lexer = shlex.shlex(value, posix=True, punctuation_chars=";")
    lexer.whitespace_split = True
    lexer.commenters = ""
    try:
        tokens = list(lexer)
    except ValueError as error:
        raise CliLaneError("could not decode managed tmux environment") from error
    environment: dict[str, str] = {}
    index = 0
    while index < len(tokens):
        token = tokens[index]
        if token == "unset":
            if index + 2 >= len(tokens) or tokens[index + 2] != ";":
                raise CliLaneError("could not decode managed tmux environment")
            validated_environment_name(tokens[index + 1], "managed tmux environment key")
            index += 3
            continue
        if "=" not in token or index + 4 >= len(tokens):
            raise CliLaneError("could not decode managed tmux environment")
        key, item = token.split("=", 1)
        validated_environment_name(key, "managed tmux environment key")
        if (
            tokens[index + 1] != ";"
            or tokens[index + 2] != "export"
            or tokens[index + 3] != key
            or tokens[index + 4] != ";"
            or "\x00" in item
        ):
            raise CliLaneError("could not decode managed tmux environment")
        environment[key] = item
        index += 5
    return environment


def managed_child_environment(expected_keys: Sequence[str]) -> dict[str, str]:
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        raise CliLaneError("managed supervisor has no tmux pane")
    shown = tmux(["show-environment", "-s", "-t", pane]).stdout.decode(
        "utf-8", errors="surrogateescape"
    )
    session_environment = parse_tmux_environment_script(shown)
    environment: dict[str, str] = {}
    for key in expected_keys:
        if key not in session_environment:
            raise CliLaneError(f"managed tmux environment is missing: {key}")
        environment[key] = session_environment[key]
    for key in ("TERM", "TMUX", "TMUX_PANE"):
        value = os.environ.get(key)
        if value is not None:
            environment[key] = value
    return environment


def supervise(encoded_command: str) -> int:
    launcher = decode_launcher(encoded_command)
    command = launcher["command"]
    environment_keys = launcher["environment_keys"]
    child_environment = managed_child_environment(environment_keys)
    pending: list[signal.Signals] = []

    def remember(signum: int, _frame: object) -> None:
        pending.append(signal.Signals(signum))

    forwarded = (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM)
    for sent_signal in forwarded:
        signal.signal(sent_signal, remember)
    child = os.fork()
    if child == 0:
        for sent_signal in forwarded:
            signal.signal(sent_signal, signal.SIG_DFL)
        try:
            os.execvpe(command[0], command, child_environment)
        except OSError as error:
            print(f"{PROGRAM}: {error}", file=sys.stderr)
            os._exit(127)
    status = 0
    shutdown_deadline: float | None = None
    while True:
        while pending:
            sent_signal = pending.pop(0)
            if sent_signal == signal.SIGHUP and shutdown_deadline is None:
                shutdown_deadline = time.monotonic() + 0.5
            signal_session(os.getpid(), signal.SIGCONT, include_leader=False)
            signal_session(os.getpid(), sent_signal, include_leader=False)
        if shutdown_deadline is not None and time.monotonic() >= shutdown_deadline:
            signal_session(os.getpid(), signal.SIGKILL, include_leader=False)
        waited, status = os.waitpid(child, os.WNOHANG)
        if waited == child:
            break
        time.sleep(0.05)
    result = os.waitstatus_to_exitcode(status)
    exit_code = 128 - result if result < 0 else result
    signal_name = ""
    if result < 0:
        try:
            signal_name = signal.Signals(-result).name
        except ValueError:
            signal_name = f"SIG{-result}"
    record_result(exit_code, signal_name)
    terminate_session_descendants(os.getpid(), 0.2)
    try:
        if shutdown_deadline is None:
            run_exit_hook(
                launcher,
                exit_code,
                signal_name,
                pending,
                child_environment,
            )
    finally:
        terminate_session_descendants(os.getpid(), 0.2)
    return exit_code


def record_result(exit_code: int, signal_name: str) -> None:
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return
    tmux(
        ["set-option", "-p", "-t", pane, "@agt_result", f"{exit_code}:{signal_name}"],
        check=False,
    )


def report_hook(message: str) -> None:
    try:
        print(f"{PROGRAM}: {message}", file=sys.stderr)
    except OSError:
        pass


def run_exit_hook(
    launcher: dict[str, object],
    exit_code: int,
    signal_name: str,
    pending: list[signal.Signals],
    child_environment: Mapping[str, str],
) -> None:
    on_exit = launcher.get("on_exit")
    if not on_exit:
        return
    environment = dict(child_environment)
    environment.update(
        CLILANE_TASK_NAME=str(launcher["name"]),
        CLILANE_TASK_ID=str(launcher["id"]),
        CLILANE_LOG=str(launcher["log"]),
        CLILANE_EXIT_CODE=str(exit_code),
        CLILANE_SIGNAL=signal_name,
    )
    try:
        hook = subprocess.Popen(["/bin/sh", "-c", str(on_exit)], env=environment)
    except OSError as error:
        report_hook(f"on-exit hook failed to start: {error}")
        return
    deadline = time.monotonic() + ON_EXIT_TIMEOUT
    shutdown_deadline: float | None = None
    timed_out = False
    while True:
        while pending:
            sent_signal = pending.pop(0)
            if sent_signal == signal.SIGHUP and shutdown_deadline is None:
                shutdown_deadline = time.monotonic() + 0.5
            signal_session(os.getpid(), signal.SIGCONT, include_leader=False)
            signal_session(os.getpid(), sent_signal, include_leader=False)
        if hook.poll() is not None:
            break
        now = time.monotonic()
        if now >= deadline:
            timed_out = True
            signal_session(os.getpid(), signal.SIGKILL, include_leader=False)
        elif shutdown_deadline is not None and now >= shutdown_deadline:
            signal_session(os.getpid(), signal.SIGKILL, include_leader=False)
        time.sleep(0.05)
    if timed_out:
        report_hook(f"on-exit hook killed after {int(ON_EXIT_TIMEOUT)}s")
    elif hook.returncode != 0:
        report_hook(f"on-exit hook exited {hook.returncode}")


def sink_log(path_value: str, max_bytes: int, session: str) -> int:
    if max_bytes <= 0:
        raise CliLaneError("log size must be positive")
    path = Path(path_value)
    previous = path.with_suffix(path.suffix + ".previous")
    handle = path.open("ab", buffering=0)
    size = handle.tell()
    dead_since: float | None = None
    descriptor = sys.stdin.fileno()
    try:
        while True:
            readable, _, _ = select.select([descriptor], [], [], 1.0)
            if readable:
                chunk = os.read(descriptor, 65536)
                if not chunk:
                    break
            else:
                result = tmux(
                    ["display-message", "-p", "-t", session, "#{pane_dead}"],
                    check=False,
                )
                is_dead = result.returncode != 0 or result.stdout.decode().strip() == "1"
                if is_dead:
                    dead_since = dead_since or time.monotonic()
                    if time.monotonic() - dead_since >= 0.5:
                        break
                continue
            if size + len(chunk) > max_bytes:
                handle.close()
                previous.unlink(missing_ok=True)
                os.replace(path, previous)
                handle = path.open("wb", buffering=0)
                os.chmod(path, 0o600)
                size = 0
            handle.write(chunk)
            size += len(chunk)
    finally:
        handle.close()
    return 0


def optional_int(value: str) -> int | None:
    if not value:
        return None
    try:
        return int(value)
    except ValueError:
        return None


def normalized_signal(value: str) -> str | None:
    if not value:
        return None
    upper = value.upper()
    return upper if upper.startswith("SIG") else f"SIG{upper}"


def list_tasks(timeout: float | None = None) -> list[Task]:
    fields = [
        "#{session_name}",
        "#{@agt_meta}",
        "#{@agt_committed}",
        "#{@agt_process_started}",
        "#{@agt_stop_requested}",
        "#{@agt_result}",
        "#{pane_id}",
        "#{pane_dead}",
        "#{pane_dead_status}",
        "#{pane_dead_signal}",
        "#{pane_pid}",
        "#{session_attached}",
        "#{?#{OPENCLAW_SESSION},bot,local}",
    ]
    completed = tmux(
        ["list-panes", "-a", "-F", FIELD_SEPARATOR.join(fields)],
        check=False,
        timeout=timeout,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode(errors="replace")
        if tmux_server_absent(completed):
            return []
        raise CliLaneError(detail.strip() or f"tmux exited {completed.returncode}")
    tasks: list[Task] = []
    for line in completed.stdout.decode(errors="replace").splitlines():
        values = line.split(FIELD_SEPARATOR)
        if len(values) != len(fields):
            continue
        (
            session,
            encoded,
            committed,
            process_started,
            stopped,
            recorded,
            pane,
            dead,
            status,
            dead_signal,
            pid,
            attached,
            origin,
        ) = values
        if not session.startswith(SESSION_PREFIX) or not encoded:
            continue
        meta = decode_meta(encoded)
        command = meta.get("command")
        if not isinstance(command, list) or not all(isinstance(part, str) for part in command):
            raise CliLaneError(f"corrupt task metadata in {session}")
        recorded_code: int | None = None
        recorded_signal: str | None = None
        if dead == "1" and recorded:
            code_text, _, signal_text = recorded.partition(":")
            recorded_code = optional_int(code_text)
            if recorded_code is not None:
                recorded_signal = signal_text or None
        tasks.append(
            Task(
                session=session,
                pane=pane,
                id=str(meta.get("id", "")),
                name=str(meta.get("name", "")),
                command=command,
                cwd=str(meta.get("cwd", "")),
                created=str(meta.get("created", "")),
                log=str(meta.get("log", "")),
                committed=committed == "1",
                process_started=process_started or None,
                stop_requested=stopped == "1",
                dead=dead == "1",
                exit_code=recorded_code if recorded_code is not None else optional_int(status),
                signal_name=recorded_signal
                if recorded_code is not None
                else normalized_signal(dead_signal),
                pid=optional_int(pid),
                attached=(optional_int(attached) or 0) > 0,
                origin=origin if origin in {"bot", "local"} else "local",
            )
        )
    return sorted(tasks, key=lambda task: task.created)


def fleet_error_message(value: str, limit: int = 300) -> str:
    collapsed = re.sub(r"\s+", " ", value).strip()
    cleaned = "".join(character for character in collapsed if character.isprintable())
    if len(cleaned) <= limit:
        return cleaned
    return cleaned[: limit - 1] + "…"


def fleet_error_result(host: FleetHost, kind: str, message: str) -> FleetResult:
    return FleetResult(
        name=host.name,
        status="error",
        clilane_version=None,
        tasks=[],
        error_kind=kind,
        error_message=fleet_error_message(message) or kind,
    )


def validate_fleet_task(host: FleetHost, value: object) -> dict[str, object]:
    if not isinstance(value, dict):
        raise CliLaneError(f"fleet host {host.name} returned a non-object task")
    required = set(FLEET_TASK_FIELDS)
    missing = required - set(value)
    if missing:
        raise CliLaneError(
            f"fleet host {host.name} task is missing field: {sorted(missing)[0]}"
        )
    for field in ("id", "state", "cwd", "created", "log"):
        if not isinstance(value[field], str):
            raise CliLaneError(
                f"fleet host {host.name} task field {field} has the wrong type"
            )
    if value["state"] not in FLEET_TASK_STATES:
        raise CliLaneError(f"fleet host {host.name} task state is invalid")
    try:
        created = datetime.fromisoformat(value["created"])
    except ValueError as error:
        raise CliLaneError(
            f"fleet host {host.name} task created timestamp is invalid"
        ) from error
    if created.tzinfo is None:
        raise CliLaneError(
            f"fleet host {host.name} task created timestamp has no timezone"
        )
    fleet_name(value["name"], f"fleet host {host.name} task name")
    command = value["command"]
    if not isinstance(command, list) or not command or not all(
        isinstance(part, str) for part in command
    ):
        raise CliLaneError(f"fleet host {host.name} task command is invalid")
    for field in ("pid", "exit_code"):
        item = value[field]
        if item is not None and type(item) is not int:
            raise CliLaneError(
                f"fleet host {host.name} task field {field} has the wrong type"
            )
    if type(value["attached"]) is not bool:
        raise CliLaneError(
            f"fleet host {host.name} task field attached has the wrong type"
        )
    if value["signal"] is not None and not isinstance(value["signal"], str):
        raise CliLaneError(
            f"fleet host {host.name} task field signal has the wrong type"
        )
    return {field: value[field] for field in FLEET_TASK_FIELDS}


def fleet_frame_payload(text: str) -> str:
    sentinel = FLEET_SENTINEL_LINE.search(text)
    if not sentinel:
        return text.strip()
    position = FLEET_FRAME_WHITESPACE.match(text, sentinel.end()).end()
    if not text.startswith(f"{PROGRAM} ", position):
        return text[position:].strip()
    version_end = text.find("\n", position)
    if version_end == -1:
        return ""
    return text[version_end + 1 :].strip()


def split_fleet_frame(
    host: FleetHost, output: bytes
) -> tuple[FleetResult | None, str, str]:
    if len(output) > FLEET_MAX_OUTPUT_BYTES:
        return (
            fleet_error_result(
                host, "protocol", f"response exceeded {FLEET_OUTPUT_LIMIT_LABEL}"
            ),
            "",
            "",
        )
    try:
        text = output.decode("utf-8")
    except UnicodeDecodeError:
        return fleet_error_result(host, "protocol", "response was not UTF-8"), "", ""
    sentinel = FLEET_SENTINEL_LINE.search(text)
    if not sentinel:
        return (
            fleet_error_result(host, "protocol", "response sentinel was missing"),
            "",
            "",
        )
    position = FLEET_FRAME_WHITESPACE.match(text, sentinel.end()).end()
    version_end = text.find("\n", position)
    if version_end == -1:
        version_line = text[position:].rstrip("\r")
        payload = ""
    else:
        version_line = text[position:version_end].rstrip("\r")
        payload = text[version_end + 1 :]
    if not version_line.startswith(f"{PROGRAM} "):
        return (
            fleet_error_result(host, "protocol", "clilane version was missing"),
            "",
            "",
        )
    version = version_line[len(PROGRAM) + 1 :].strip()
    if not version:
        return (
            fleet_error_result(host, "protocol", "clilane version was empty"),
            "",
            "",
        )
    return None, version, payload


def parse_fleet_response(host: FleetHost, output: bytes) -> FleetResult:
    error, version, payload = split_fleet_frame(host, output)
    if error is not None:
        return error
    payload = payload.strip()
    try:
        decoded = json.loads(
            payload,
            parse_constant=reject_json_constant,
            parse_float=finite_json_float,
            parse_int=bounded_json_int,
        )
    except (json.JSONDecodeError, RecursionError, ValueError):
        return fleet_error_result(host, "protocol", "task JSON was malformed")
    if not isinstance(decoded, list):
        return fleet_error_result(host, "protocol", "task JSON was not an array")
    if len(decoded) > FLEET_MAX_TASKS_PER_HOST:
        return fleet_error_result(
            host,
            "protocol",
            f"host returned more than {FLEET_MAX_TASKS_PER_HOST} tasks",
        )
    try:
        tasks = [validate_fleet_task(host, task) for task in decoded]
    except CliLaneError as error:
        return fleet_error_result(host, "protocol", str(error))
    return FleetResult(host.name, "ok", version, tasks, None, None)


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    with suppress(ProcessLookupError):
        os.killpg(process.pid, signal.SIGKILL)
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def run_bounded_process(
    command: Sequence[str],
    timeout: float,
    max_bytes: int,
    cancel_event: threading.Event | None = None,
) -> tuple[subprocess.CompletedProcess[bytes], bool]:
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    if process.stdout is None or process.stderr is None:
        terminate_process_group(process)
        raise CliLaneError("could not capture SSH output")
    stdout_stream = process.stdout
    stderr_stream = process.stderr
    complete = False
    try:
        stdout = bytearray()
        stderr = bytearray()
        streams = {
            stdout_stream.fileno(): stdout,
            stderr_stream.fileno(): stderr,
        }
        for descriptor in streams:
            os.set_blocking(descriptor, False)
        deadline = time.monotonic() + timeout
        exceeded = False
        while streams:
            if cancel_event and cancel_event.is_set():
                raise concurrent.futures.CancelledError
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(command, timeout)
            wait_for = min(remaining, 0.1) if cancel_event else remaining
            readable, _, _ = select.select(list(streams), [], [], wait_for)
            if not readable:
                continue
            for descriptor in readable:
                try:
                    chunk = os.read(
                        descriptor,
                        min(65536, max_bytes + 1 - len(stdout) - len(stderr)),
                    )
                except BlockingIOError:
                    continue
                if not chunk:
                    streams.pop(descriptor)
                    continue
                streams[descriptor].extend(chunk)
                if len(stdout) + len(stderr) > max_bytes:
                    exceeded = True
                    break
            if exceeded:
                break
        if exceeded:
            terminate_process_group(process)
        else:
            while process.poll() is None:
                if cancel_event and cancel_event.is_set():
                    raise concurrent.futures.CancelledError
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(command, timeout)
                wait_for = min(remaining, 0.1) if cancel_event else remaining
                try:
                    process.wait(timeout=wait_for)
                except subprocess.TimeoutExpired:
                    continue
        complete = True
        return (
            subprocess.CompletedProcess(
                list(command), process.returncode, bytes(stdout), bytes(stderr)
            ),
            exceeded,
        )
    finally:
        try:
            if not complete:
                terminate_process_group(process)
        finally:
            stdout_stream.close()
            stderr_stream.close()


def collect_remote_fleet_host(
    host: FleetHost,
    ssh: str,
    timeout: float,
    cancel_event: threading.Event | None = None,
) -> FleetResult:
    error, output = fleet_remote_output(
        host, ssh, timeout, FLEET_REMOTE_COMMAND, cancel_event
    )
    if error is not None:
        return error
    return parse_fleet_response(host, output)


def fleet_remote_output(
    host: FleetHost,
    ssh: str,
    timeout: float,
    remote_command: str,
    cancel_event: threading.Event | None = None,
) -> tuple[FleetResult | None, bytes]:
    if not host.destination:
        return fleet_error_result(host, "config", "SSH destination was missing"), b""
    command = [
        ssh,
        "-T",
        "-n",
        "-a",
        "-x",
        "-o",
        "BatchMode=yes",
        "-o",
        "ClearAllForwardings=yes",
        "-o",
        "ConnectionAttempts=1",
        "-o",
        f"ConnectTimeout={math.ceil(timeout)}",
        "-o",
        "AddKeysToAgent=no",
        "-o",
        "CheckHostIP=no",
        "-o",
        "ControlMaster=no",
        "-o",
        "ControlPath=none",
        "-o",
        "ControlPersist=no",
        "-o",
        "ForkAfterAuthentication=no",
        "-o",
        "PermitLocalCommand=no",
        "-o",
        "RemoteCommand=none",
        "-o",
        "RequestTTY=no",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UpdateHostKeys=no",
        "-o",
        "LogLevel=ERROR",
        "--",
        host.destination,
        remote_command,
    ]
    try:
        completed, exceeded = run_bounded_process(
            command, timeout, FLEET_MAX_OUTPUT_BYTES, cancel_event
        )
    except subprocess.TimeoutExpired:
        return (
            fleet_error_result(host, "timeout", f"timed out after {timeout:g} seconds"),
            b"",
        )
    except OSError as error:
        return fleet_error_result(host, "ssh", str(error)), b""
    if exceeded:
        return (
            fleet_error_result(
                host, "protocol", f"response exceeded {FLEET_OUTPUT_LIMIT_LABEL}"
            ),
            b"",
        )
    if completed.returncode != 0:
        detail = completed.stderr.decode(errors="replace").strip()
        if not detail:
            detail = fleet_frame_payload(completed.stdout.decode(errors="replace"))
        kind = "ssh" if completed.returncode == 255 else "remote"
        return (
            fleet_error_result(
                host,
                kind,
                detail or f"remote command exited {completed.returncode}",
            ),
            b"",
        )
    return None, completed.stdout


def collect_fleet(hosts: Sequence[FleetHost], timeout: float) -> list[FleetResult]:
    if not math.isfinite(timeout) or timeout <= 0 or timeout > FLEET_MAX_TIMEOUT:
        raise CliLaneError(
            f"fleet timeout must be greater than 0 and at most {FLEET_MAX_TIMEOUT:g} seconds"
        )
    results: dict[str, FleetResult] = {}
    local = next(host for host in hosts if host.transport == "local")
    remote = [host for host in hosts if host.transport == "ssh"]
    ssh = shutil.which("ssh") if remote else None
    cancel_event = threading.Event()
    executor: concurrent.futures.ThreadPoolExecutor | None = None
    futures: dict[concurrent.futures.Future[FleetResult], FleetHost] = {}
    previous_handlers: dict[int, signal.Handlers] = {}

    def cancel_for_signal(signum: int, _frame: object) -> None:
        cancel_event.set()
        raise FleetSignal(signum)

    try:
        if threading.current_thread() is threading.main_thread():
            for sent_signal in (signal.SIGHUP, signal.SIGTERM):
                previous_handlers[sent_signal] = signal.getsignal(sent_signal)
                signal.signal(sent_signal, cancel_for_signal)
        if ssh:
            executor = concurrent.futures.ThreadPoolExecutor(
                max_workers=min(8, len(remote))
            )
        remote_hosts = iter(remote)
        if executor and ssh:
            for _ in range(min(8, len(remote))):
                host = next(remote_hosts)
                future = executor.submit(
                    collect_remote_fleet_host,
                    host,
                    ssh,
                    timeout,
                    cancel_event,
                )
                futures[future] = host
        try:
            tasks = [task.as_dict() for task in list_tasks(timeout)]
            if len(tasks) > FLEET_MAX_TASKS_PER_HOST:
                raise CliLaneError(
                    f"local host has more than {FLEET_MAX_TASKS_PER_HOST} tasks"
                )
            encoded_tasks = json.dumps(
                tasks, separators=(",", ":"), allow_nan=False
            ).encode()
            if len(encoded_tasks) > FLEET_MAX_OUTPUT_BYTES:
                raise CliLaneError(
                    f"local task data exceeded {FLEET_OUTPUT_LIMIT_LABEL}"
                )
            results[local.name] = FleetResult(
                local.name,
                "ok",
                VERSION,
                tasks,
                None,
                None,
            )
        except (CliLaneError, OSError) as error:
            results[local.name] = fleet_error_result(local, "local", str(error))
        if remote and not ssh:
            for host in remote:
                results[host.name] = fleet_error_result(
                    host, "dependency", "ssh is required"
                )
        while futures:
            done, _ = concurrent.futures.wait(
                futures, return_when=concurrent.futures.FIRST_COMPLETED
            )
            for future in done:
                host = futures.pop(future)
                results[host.name] = future.result()
                next_host = next(remote_hosts, None)
                if next_host and executor and ssh:
                    next_future = executor.submit(
                        collect_remote_fleet_host,
                        next_host,
                        ssh,
                        timeout,
                        cancel_event,
                    )
                    futures[next_future] = next_host
    except BaseException:
        cancel_event.set()
        for future in futures:
            future.cancel()
        raise
    finally:
        try:
            if executor:
                executor.shutdown(wait=True, cancel_futures=True)
        finally:
            for sent_signal, previous_handler in previous_handlers.items():
                signal.signal(sent_signal, previous_handler)
    return [results[host.name] for host in hosts]


def resolve_task(target: str) -> Task:
    tasks = list_tasks()
    exact = [task for task in tasks if target in {task.name, task.id, task.session}]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        raise CliLaneError(f"ambiguous task name: {target}")
    prefixed = [task for task in tasks if task.id.startswith(target)]
    if len(prefixed) == 1:
        return prefixed[0]
    if len(prefixed) > 1:
        raise CliLaneError(f"ambiguous task id: {target}")
    raise CliLaneError(
        f"task not found: {target}; run '{PROGRAM} list' to see managed tasks"
    )


def task_environment_queue(
    session: str,
    environment: Mapping[str, str],
    existing: set[str],
) -> list[str]:
    current = dict(environment)
    queue: list[str] = []

    def append_command(command: list[str]) -> None:
        if queue:
            queue.append(";")
        queue.extend(command)

    for key in sorted(existing - current.keys()):
        append_command(["set-environment", "-t", session, "-r", key])
    for key in sorted(current):
        append_command(
            [
                "set-environment",
                "-t",
                session,
                key,
                tmux_command_argument(current[key]),
            ]
        )
    return queue


def set_task_environment(
    session: str,
    environment: Mapping[str, str],
    existing: set[str],
) -> None:
    queue = task_environment_queue(session, environment, existing)
    if queue:
        tmux(queue)


def validate_name(name: str) -> None:
    if not NAME_PATTERN.fullmatch(name):
        raise CliLaneError(
            "name must be 1-64 characters, beginning with a letter or number and "
            "using only letters, numbers, dot, dash, or underscore"
        )


def positive_timeout(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as error:
        raise CliLaneError(f"--timeout requires a number: {value!r}") from error
    if not math.isfinite(parsed) or parsed <= 0:
        raise CliLaneError("--timeout must be greater than 0")
    return parsed


def parse_run_request(parts: Sequence[str]) -> RunRequest:
    tokens = list(parts)
    sentinel = tokens.index("--") if "--" in tokens else None
    prefix = tokens if sentinel is None else tokens[:sentinel]
    raw_command = None if sentinel is None else tokens[sentinel + 1 :]

    name: str | None = None
    cwd: str | None = None
    cwd_explicit = False
    wait = False
    timeout: float | None = None
    on_exit: str | None = None
    profile: str | None = None
    seen: set[str] = set()
    index = 0
    while index < len(prefix):
        token = prefix[index]
        if token in {"-C", "--cwd"}:
            if "cwd" in seen:
                raise CliLaneError("-C/--cwd may be supplied only once")
            if index + 1 >= len(prefix):
                raise CliLaneError(f"{token} requires a directory")
            seen.add("cwd")
            cwd = prefix[index + 1]
            cwd_explicit = True
            index += 2
            continue
        if token.startswith("--cwd="):
            if "cwd" in seen:
                raise CliLaneError("-C/--cwd may be supplied only once")
            seen.add("cwd")
            cwd = token.split("=", 1)[1]
            cwd_explicit = True
            index += 1
            continue
        if token == "--wait":
            if "wait" in seen:
                raise CliLaneError("--wait may be supplied only once")
            seen.add("wait")
            wait = True
            index += 1
            continue
        if token == "--timeout":
            if "timeout" in seen:
                raise CliLaneError("--timeout may be supplied only once")
            if index + 1 >= len(prefix):
                raise CliLaneError("--timeout requires a number")
            seen.add("timeout")
            timeout = positive_timeout(prefix[index + 1])
            index += 2
            continue
        if token.startswith("--timeout="):
            if "timeout" in seen:
                raise CliLaneError("--timeout may be supplied only once")
            seen.add("timeout")
            timeout = positive_timeout(token.split("=", 1)[1])
            index += 1
            continue
        if token == "--on-exit":
            if "on_exit" in seen:
                raise CliLaneError("--on-exit may be supplied only once")
            if index + 1 >= len(prefix):
                raise CliLaneError("--on-exit requires a command")
            seen.add("on_exit")
            on_exit = prefix[index + 1]
            index += 2
            continue
        if token.startswith("--on-exit="):
            if "on_exit" in seen:
                raise CliLaneError("--on-exit may be supplied only once")
            seen.add("on_exit")
            on_exit = token.split("=", 1)[1]
            index += 1
            continue
        if token == "--profile":
            if "profile" in seen:
                raise CliLaneError("--profile may be supplied only once")
            if index + 1 >= len(prefix):
                raise CliLaneError("--profile requires a profile name")
            seen.add("profile")
            profile = prefix[index + 1]
            index += 2
            continue
        if token.startswith("--profile="):
            if "profile" in seen:
                raise CliLaneError("--profile may be supplied only once")
            seen.add("profile")
            profile = token.split("=", 1)[1]
            index += 1
            continue
        if token.startswith("-"):
            raise CliLaneError(f"unknown run option: {token}")
        if name is not None:
            raise CliLaneError(f"unexpected run argument: {token}")
        name = token
        index += 1

    if name is None:
        raise CliLaneError("missing task name")
    validate_name(name)
    if cwd is not None and (not cwd or "\x00" in cwd):
        raise CliLaneError("-C/--cwd requires a directory without NUL")
    if profile is not None:
        fleet_name(profile, "profile name")
        if raw_command is not None:
            raise CliLaneError("--profile and a raw -- COMMAND are mutually exclusive")
        command = None
    else:
        if raw_command is None:
            raise CliLaneError("missing command after -- or --profile")
        command = validated_argv(raw_command, "raw command")
    if timeout is not None and not wait:
        raise CliLaneError("--timeout requires --wait")
    if on_exit is not None and (not on_exit.strip() or "\x00" in on_exit):
        raise CliLaneError("--on-exit requires a command")
    return RunRequest(
        name=name,
        cwd=cwd,
        cwd_explicit=cwd_explicit,
        wait=wait,
        timeout=timeout,
        on_exit=on_exit,
        profile=profile,
        command=command,
    )


def legacy_launch_environment(source: Mapping[str, str]) -> dict[str, str]:
    return {
        key: value
        for key, value in source.items()
        if key not in TRANSIENT_ENV
        and ENV_PATTERN.fullmatch(key)
        and "\x00" not in value
    }


def profile_launch_environment(
    profile: Profile, source: Mapping[str, str]
) -> dict[str, str]:
    environment: dict[str, str] = {}
    for key in PROFILE_BASELINE_ENV:
        value = source.get(key)
        if value is None:
            continue
        if "\x00" in value:
            raise CliLaneError(f"profile baseline environment contains NUL: {key}")
        environment[key] = value
    inherited: dict[str, str] = {}
    for key in profile.inherit:
        if key not in source:
            raise CliLaneError(f"profile {profile.name!r} requires missing environment key: {key}")
        value = source[key]
        if "\x00" in value:
            raise CliLaneError(f"profile {profile.name!r} inherited value contains NUL: {key}")
        inherited[key] = value
    environment.update(inherited)
    environment.update(dict(profile.env_set))
    return environment


def complete_launch_spec(
    *,
    name: str,
    cwd_value: str,
    command: Sequence[str],
    wait: bool,
    timeout: float | None,
    on_exit: str | None,
    environment: Mapping[str, str],
    profile: str | None,
    provider: str | None,
) -> LaunchSpec:
    validate_name(name)
    if type(wait) is not bool:
        raise CliLaneError("launch wait must be a boolean")
    validated_command = validated_argv(list(command), "launch command")
    if not isinstance(cwd_value, str) or not cwd_value or "\x00" in cwd_value:
        raise CliLaneError("launch cwd must be a non-empty path without NUL")
    cwd = Path(cwd_value).expanduser().resolve()
    if not cwd.is_dir():
        raise CliLaneError(f"not a directory: {cwd}")
    if timeout is not None:
        if (
            isinstance(timeout, bool)
            or not isinstance(timeout, (int, float))
            or not math.isfinite(float(timeout))
            or timeout <= 0
        ):
            raise CliLaneError("--timeout must be a finite number greater than 0")
        if not wait:
            raise CliLaneError("--timeout requires --wait")
    if on_exit is not None and (
        not isinstance(on_exit, str) or not on_exit.strip() or "\x00" in on_exit
    ):
        raise CliLaneError("--on-exit requires a command")
    if (profile is None) != (provider is None):
        raise CliLaneError("launch profile and provider must be set together")
    validated_profile = None if profile is None else fleet_name(profile, "profile name")
    validated_provider = None if provider is None else fleet_name(provider, "provider name")
    validated_environment: dict[str, str] = {}
    for key, value in environment.items():
        validated_key = validated_environment_name(key, "launch environment key")
        if validated_profile is not None and profile_owned_environment(validated_key):
            raise CliLaneError(f"launch environment key is reserved: {validated_key}")
        if not isinstance(value, str) or "\x00" in value:
            raise CliLaneError(f"launch environment value contains NUL: {validated_key}")
        validated_environment[validated_key] = value
    return LaunchSpec(
        name=name,
        cwd=str(cwd),
        command=validated_command,
        wait=wait,
        timeout=None if timeout is None else float(timeout),
        on_exit=on_exit,
        environment=validated_environment,
        profile=validated_profile,
        provider=validated_provider,
    )


def resolve_run_request(
    request: RunRequest,
    source_environment: Mapping[str, str],
    default_cwd: str,
) -> LaunchSpec:
    if request.profile is None:
        if request.command is None:
            raise CliLaneError("raw launch is missing a command")
        return complete_launch_spec(
            name=request.name,
            cwd_value=request.cwd if request.cwd_explicit else default_cwd,
            command=request.command,
            wait=request.wait,
            timeout=request.timeout,
            on_exit=request.on_exit,
            environment=legacy_launch_environment(source_environment),
            profile=None,
            provider=None,
        )

    profiles = load_profiles(profiles_config_path(source_environment))
    profile = profiles.get(request.profile)
    if profile is None:
        raise CliLaneError(f"profile not found: {request.profile}")
    if profile.cwd_mode == "explicit":
        if not request.cwd_explicit or request.cwd is None:
            raise CliLaneError(f"profile {profile.name!r} requires -C/--cwd")
        cwd_value = request.cwd
    else:
        if request.cwd_explicit:
            raise CliLaneError(f"profile {profile.name!r} has fixed cwd and forbids -C/--cwd")
        if profile.cwd_path is None:
            raise CliLaneError(f"profile {profile.name!r} has no fixed cwd path")
        cwd_value = profile.cwd_path
    return complete_launch_spec(
        name=request.name,
        cwd_value=cwd_value,
        command=profile.command,
        wait=request.wait,
        timeout=request.timeout,
        on_exit=request.on_exit,
        environment=profile_launch_environment(profile, source_environment),
        profile=profile.name,
        provider=profile.provider,
    )


def native_process_bytes(value: str, label: str) -> int:
    try:
        return len(os.fsencode(value)) + 1
    except UnicodeEncodeError as error:
        raise CliLaneError(f"{label} is not encodable for this platform") from error


def process_footprint(
    arguments: Sequence[str], environment: Mapping[str, str]
) -> int:
    strings = sum(
        native_process_bytes(argument, "process argument") for argument in arguments
    )
    strings += sum(
        native_process_bytes(f"{key}={value}", f"environment entry {key}")
        for key, value in environment.items()
    )
    return strings + (len(arguments) + len(environment) + 2) * 8


def require_portable_footprint(
    label: str,
    arguments: Sequence[str],
    environment: Mapping[str, str],
) -> None:
    size = process_footprint(arguments, environment)
    if size > EXEC_FOOTPRINT_MAX_BYTES:
        raise CliLaneError(
            f"{label} exceeds the portable {EXEC_FOOTPRINT_MAX_BYTES // 1024} KiB "
            f"launch budget ({size} bytes)"
        )


def reserved_control_socket() -> str:
    selected = TMUX_SOCKET_OVERRIDE or SOCKET
    if Path(selected).is_absolute():
        return selected
    return "/" + "s" * (CONTROL_SOCKET_RESERVE_BYTES - 2)


def preflight_runtime_environment(spec: LaunchSpec) -> tuple[dict[str, str], str, str]:
    task_id = "00000000-0000-0000-0000-000000000000"
    root = state_root_path()
    log_path = root / "logs" / f"{task_id}.log"
    environment = dict(spec.environment)
    environment.update(
        CLILANE_TMUX_SOCKET=reserved_control_socket(),
        CLILANE_STATE_HOME=str(root),
        CLILANE_TASK_NAME=spec.name,
        CLILANE_TASK_ID=task_id,
        CLILANE_LOG=str(log_path),
    )
    return environment, task_id, str(log_path)


def anticipated_tmux_environment() -> dict[str, str]:
    shown = tmux(["show-environment", "-gs"], check=False)
    if shown.returncode == 0:
        decoded = shown.stdout.decode("utf-8", errors="surrogateescape")
        return parse_tmux_environment_script(decoded)
    elif tmux_server_absent(shown):
        return tmux_client_environment()
    else:
        detail = shown.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or "could not inspect the tmux global environment")


def preflight_launch(spec: LaunchSpec, inspect_tmux: bool = True) -> set[str]:
    environment, task_id, log_path = preflight_runtime_environment(spec)
    child_environment = dict(environment)
    child_environment.update(
        TERM="x" * 64,
        TMUX="x" * (CONTROL_SOCKET_RESERVE_BYTES + 64),
        TMUX_PANE="%0000000000",
    )
    require_portable_footprint("launch command", spec.command, child_environment)
    if spec.on_exit is not None:
        hook_environment = dict(child_environment)
        hook_environment.update(CLILANE_EXIT_CODE="255", CLILANE_SIGNAL="SIGKILL")
        require_portable_footprint(
            "on-exit hook",
            ["/bin/sh", "-c", spec.on_exit],
            hook_environment,
        )

    script = str(Path(__file__).resolve())
    python_binary = str(Path(sys.executable).resolve())
    client_binary = tmux_binary()
    control_binary = str(Path(client_binary).resolve())
    client_environment = tmux_client_environment()
    require_portable_footprint(
        "tmux client environment",
        [client_binary, "-V"],
        client_environment,
    )
    control_socket = reserved_control_socket()
    session = f"{SESSION_PREFIX}{'0' * 12}"
    pane = "%0000000000"
    launcher = encode_launcher(
        spec.command,
        spec.on_exit,
        spec.name,
        task_id,
        log_path,
        sorted(environment),
    )
    supervisor_arguments = [
        python_binary,
        script,
        "__supervise",
        control_binary,
        control_socket,
        launcher,
    ]
    supervisor_environment = dict(child_environment)
    if "PATH" in client_environment:
        supervisor_environment["PATH"] = client_environment["PATH"]
    require_portable_footprint(
        "managed supervisor", supervisor_arguments, supervisor_environment
    )
    require_portable_footprint(
        "tmux replacement placeholder",
        ["sleep", "2147483647"],
        supervisor_environment,
    )

    tmux_prefix = [client_binary, *tmux_socket_arguments(), "-f", "/dev/null"]
    if inspect_tmux:
        ensure_server_available()
        global_environment = anticipated_tmux_environment()
    else:
        global_environment = {}
    existing = set(global_environment)
    environment_queue = task_environment_queue(session, environment, existing)
    require_portable_footprint(
        "tmux environment update",
        [*tmux_prefix, *environment_queue],
        client_environment,
    )
    placeholder_environment = dict(global_environment)
    placeholder_environment.update(
        TERM="x" * 64,
        TMUX="x" * (CONTROL_SOCKET_RESERVE_BYTES + 64),
        TMUX_PANE="%0000000000",
    )
    if "PATH" in client_environment:
        placeholder_environment["PATH"] = client_environment["PATH"]
    require_portable_footprint(
        "tmux placeholder",
        ["sleep", "2147483647"],
        placeholder_environment,
    )
    meta: dict[str, object] = {
        "id": task_id,
        "name": spec.name,
        "command": list(spec.command),
        "cwd": spec.cwd,
        "created": "2000-01-01T00:00:00.000000+00:00",
        "log": log_path,
        "on_exit": spec.on_exit,
    }
    require_portable_footprint(
        "tmux task creation",
        [*tmux_prefix, *initial_task_queue(session, spec.cwd, meta)],
        client_environment,
    )
    require_portable_footprint(
        "tmux supervisor launch",
        [
            *tmux_prefix,
            *respawn_task_arguments(
                pane,
                spec.cwd,
                python_binary,
                script,
                control_binary,
                control_socket,
                launcher,
            ),
        ],
        client_environment,
    )
    return existing


def ensure_server_available() -> None:
    ensure_tmux_version()
    probe = tmux(["list-sessions"], check=False)
    if probe.returncode != 0:
        if tmux_server_absent(probe):
            return
        detail = probe.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or f"could not inspect tmux socket: {SOCKET}")
    tag = tmux(["show-options", "-gqv", "@agt_server"]).stdout.decode().strip()
    if tag != SERVER_TAG:
        raise CliLaneError(f"tmux socket is already owned by another server: {SOCKET}")


def tmux_session_absent(session: str) -> bool:
    probe = tmux(["has-session", "-t", session], check=False)
    if probe.returncode == 0:
        return False
    detail = probe.stderr.decode(errors="replace").lower()
    if tmux_server_absent(probe) or "can't find session" in detail:
        return True
    raise CliLaneError(detail.strip() or f"could not inspect tmux session: {session}")


def configure_task_status(session: str) -> None:
    tmux(
        [
            "set-option",
            "-t",
            session,
            "status-left",
            " #{?#{OPENCLAW_SESSION},BOT,LOCAL} · #{window_name} ",
        ],
        check=False,
    )
    tmux(["set-option", "-t", session, "status-left-length", "50"], check=False)
    tmux(
        [
            "set-option",
            "-t",
            session,
            "status-right",
            " C-q / C-b w switcher ",
        ],
        check=False,
    )


def kill_managed_session(session: str) -> None:
    killed = tmux(["kill-session", "-t", session], check=False)
    if killed.returncode == 0:
        return
    if tmux_session_absent(session):
        return
    detail = killed.stderr.decode(errors="replace").strip()
    raise CliLaneError(detail or f"could not remove tmux session: {session}")


def initial_task_queue(session: str, cwd: str, meta: Mapping[str, object]) -> list[str]:
    return [
        "start-server",
        ";",
        "set-option",
        "-g",
        "history-limit",
        "50000",
        ";",
        "set-option",
        "-g",
        "@agt_server",
        SERVER_TAG,
        ";",
        "new-session",
        "-d",
        "-E",
        "-P",
        "-F",
        "#{pane_id}",
        "-s",
        session,
        "-c",
        tmux_command_argument(cwd),
        "sleep",
        "2147483647",
        ";",
        "set-option",
        "-w",
        "-t",
        session,
        "remain-on-exit",
        "on",
        ";",
        "set-option",
        "-t",
        session,
        "@agt_meta",
        encode_meta(dict(meta)),
        ";",
        "set-option",
        "-t",
        session,
        "@agt_committed",
        "0",
        ";",
        "set-option",
        "-t",
        session,
        "@agt_process_started",
        "",
        ";",
        "set-option",
        "-t",
        session,
        "@agt_stop_requested",
        "0",
    ]


def respawn_task_arguments(
    pane: str,
    cwd: str,
    python_binary: str,
    script: str,
    control_binary: str,
    control_socket: str,
    launcher: str,
) -> list[str]:
    return [
        "respawn-pane",
        "-k",
        "-c",
        tmux_command_argument(cwd),
        "-t",
        pane,
        "--",
        python_binary,
        script,
        "__supervise",
        control_binary,
        control_socket,
        launcher,
    ]


def run_task(spec: LaunchSpec) -> Task:
    spec = complete_launch_spec(
        name=spec.name,
        cwd_value=spec.cwd,
        command=spec.command,
        wait=spec.wait,
        timeout=spec.timeout,
        on_exit=spec.on_exit,
        environment=spec.environment,
        profile=spec.profile,
        provider=spec.provider,
    )
    preflight_launch(spec, inspect_tmux=False)
    with registry_lock():
        existing_environment = preflight_launch(spec)
        existing = list_tasks()
        backfill_records(existing)
        if any(task.name == spec.name for task in existing):
            raise CliLaneError(f"task already exists: {spec.name}")
        cwd = Path(spec.cwd)
        command = list(spec.command)
        task_id = str(uuid.uuid4())
        session = f"{SESSION_PREFIX}{task_id.replace('-', '')[:12]}"
        runtime_state_root = state_root()
        log_dir = runtime_state_root / "logs"
        log_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(log_dir, 0o700)
        log_path = log_dir / f"{task_id}.log"
        environment = dict(spec.environment)
        environment.update(
            CLILANE_TMUX_SOCKET=SOCKET,
            CLILANE_STATE_HOME=str(runtime_state_root),
            CLILANE_TASK_NAME=spec.name,
            CLILANE_TASK_ID=task_id,
            CLILANE_LOG=str(log_path),
        )
        created_stamp = datetime.now(timezone.utc).isoformat()
        write_record(
            task_id,
            spec.name,
            command,
            str(cwd),
            created_stamp,
            str(log_path),
            session,
            RECORD_PHASE_PENDING,
        )
        log_created = False
        try:
            log_path.touch(mode=0o600, exist_ok=False)
            log_created = True
        except OSError:
            delete_record(task_id)
            raise
        meta: dict[str, object] = {
            "id": task_id,
            "name": spec.name,
            "command": command,
            "cwd": str(cwd),
            "created": created_stamp,
            "log": str(log_path),
            "on_exit": spec.on_exit,
        }
        script = Path(__file__).resolve()
        python_binary = str(Path(sys.executable).resolve())
        control_binary = str(Path(tmux_binary()).resolve())
        committed = False
        pane = ""
        started: str | None = None
        try:
            created = tmux(initial_task_queue(session, str(cwd), meta))
            pane = created.stdout.decode().strip()
            control_socket = tmux(
                ["display-message", "-p", "-t", session, "#{socket_path}"]
            ).stdout.decode().strip()
            if not Path(control_socket).is_absolute():
                raise CliLaneError("could not resolve the managed tmux socket")
            environment["CLILANE_TMUX_SOCKET"] = control_socket
            placeholder_pane = pane
            set_task_environment(session, environment, existing_environment)
            replacement = tmux(
                [
                    "new-window",
                    "-d",
                    "-P",
                    "-F",
                    "#{pane_id}",
                    "-t",
                    f"{session}:",
                    "-c",
                    tmux_command_argument(str(cwd)),
                    "sleep",
                    "2147483647",
                ]
            )
            pane = replacement.stdout.decode().strip()
            tmux(["set-option", "-w", "-t", pane, "remain-on-exit", "on"])
            tmux(["kill-window", "-t", placeholder_pane])
            tmux(
                ["set-window-option", "-t", pane, "automatic-rename", "off"],
                check=False,
            )
            tmux(["rename-window", "-t", pane, spec.name], check=False)
            configure_task_status(session)
            sink = (
                f"exec {shlex.quote(python_binary)} {shlex.quote(str(script))} __log "
                f"{shlex.quote(control_binary)} {shlex.quote(control_socket)} "
                f"{shlex.quote(str(log_path))} {LOG_MAX_BYTES} {shlex.quote(session)}"
            )
            tmux(["pipe-pane", "-t", pane, sink])
            launcher = encode_launcher(
                command,
                spec.on_exit,
                spec.name,
                task_id,
                str(log_path),
                sorted(environment),
            )
            tmux(
                respawn_task_arguments(
                    pane,
                    str(cwd),
                    python_binary,
                    str(script),
                    control_binary,
                    control_socket,
                    launcher,
                )
            )
            deadline = time.monotonic() + 0.5
            started = None
            while True:
                process = tmux(
                    [
                        "display-message",
                        "-p",
                        "-t",
                        pane,
                        f"#{{pane_dead}}{FIELD_SEPARATOR}#{{pane_pid}}",
                    ]
                ).stdout.decode().strip().split(FIELD_SEPARATOR)
                dead = len(process) != 2 or process[0] == "1"
                pid = optional_int(process[1]) if len(process) == 2 else None
                started = process_start_time(pid) if pid is not None and not dead else None
                if dead or started:
                    break
                if time.monotonic() >= deadline:
                    raise CliLaneError("could not bind supervisor process identity")
                time.sleep(0.02)
            tmux(["set-option", "-t", session, "@agt_process_started", started or ""])
            tmux(["set-option", "-t", session, "@agt_committed", "1"])
            write_record(
                task_id,
                spec.name,
                command,
                str(cwd),
                created_stamp,
                str(log_path),
                session,
                RECORD_PHASE_LIVE,
            )
            committed = True
            return resolve_task(task_id)
        finally:
            if not committed:
                terminate_incomplete_session(session, pane, 0.5, started)
                kill_managed_session(session)
                if log_created:
                    log_path.unlink(missing_ok=True)
                    log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
                delete_record(task_id)


def age(created: str) -> str:
    try:
        started = datetime.fromisoformat(created)
        if started.tzinfo is None:
            return "?"
    except (TypeError, ValueError):
        return "?"
    seconds = max(0, int((datetime.now(timezone.utc) - started).total_seconds()))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


def print_tasks(tasks: Sequence[Task], as_json: bool) -> None:
    if as_json:
        print(json.dumps([task.as_dict() for task in tasks], indent=2))
        return
    if not tasks:
        print("no tasks")
        return
    projects = [Path(task.cwd).name or task.cwd for task in tasks]
    name_width = max(len("NAME"), *(len(task.name) for task in tasks))
    project_width = max(len("PROJECT"), *(len(project) for project in projects))
    print(
        f"{'NAME':<{name_width}} {'STATE':<10} {'AGE':<6} "
        f"{'PID':<8} {'PROJECT':<{project_width}} COMMAND"
    )
    for task, project in zip(tasks, projects):
        pid = str(task.pid) if not task.dead and task.pid is not None else "-"
        command = shlex.join(task.command)
        print(
            f"{task.name:<{name_width}} {task.state:<10} {age(task.created):<6} "
            f"{pid:<8} {project:<{project_width}} {command}"
        )


def fleet_display_cell(value: str, limit: int | None = None) -> str:
    normalized = "".join(
        " " if character.isspace() and character != " " else character
        for character in value
    )
    cleaned = "".join(character for character in normalized if character.isprintable())
    if limit is None or len(cleaned) <= limit:
        return cleaned
    return cleaned[: limit - 1] + "…"


def fleet_verb_target(hosts: Sequence[FleetHost], target: str) -> tuple[FleetHost, str]:
    host_name, separator, task = target.partition(":")
    if not separator or not host_name or not task:
        raise CliLaneError("fleet status/log target must look like HOST:TASK")
    if not NAME_PATTERN.fullmatch(task):
        raise CliLaneError(f"invalid task target: {task}")
    host = next((entry for entry in hosts if entry.name == host_name), None)
    if host is None:
        known = ", ".join(entry.name for entry in hosts)
        raise CliLaneError(f"unknown fleet host: {host_name}; configured hosts: {known}")
    return host, task


def sanitized_log_text(payload: str) -> str:
    kept = []
    for character in payload:
        if character in "\n\t" or character.isprintable():
            kept.append(character)
    return "".join(kept)


def fleet_verb(
    configured: str | None, verb: str, target: str, lines: int, timeout: float
) -> int:
    if lines <= 0:
        raise CliLaneError("--lines must be positive")
    hosts = load_fleet_hosts(configured)
    host, task = fleet_verb_target(hosts, target)
    if host.transport == "local":
        resolved = resolve_task(task)
        if verb == "status":
            print(json.dumps(resolved.as_dict(), indent=2, allow_nan=False))
            return 0
        return log_task(resolved, lines, False)
    ssh = shutil.which("ssh")
    if not ssh:
        raise CliLaneError("ssh is required for remote fleet hosts")
    quoted = shlex.quote(task)
    if verb == "status":
        script = f"clilane status {quoted} --json"
    else:
        script = f"clilane log {quoted} --lines {lines}"
    error, output = fleet_remote_output(
        host, ssh, timeout, fleet_remote_command(script)
    )
    if error is not None:
        detail = error.error_message or "remote command failed"
        if (
            verb == "log"
            and error.error_kind == "protocol"
            and detail.startswith("response exceeded")
        ):
            detail = f"{detail}; reduce --lines"
        raise CliLaneError(f"{host.name}: {detail}")
    frame_error, _, payload = split_fleet_frame(host, output)
    if frame_error is not None:
        raise CliLaneError(f"{host.name}: {frame_error.error_message}")
    if verb == "status":
        try:
            decoded = json.loads(
                payload.strip(),
                parse_constant=reject_json_constant,
                parse_float=finite_json_float,
                parse_int=bounded_json_int,
            )
        except (json.JSONDecodeError, RecursionError, ValueError):
            raise CliLaneError(f"{host.name}: task JSON was malformed") from None
        validated = validate_fleet_task(host, decoded)
        print(json.dumps(validated, indent=2, allow_nan=False))
        return 0
    sys.stdout.write(sanitized_log_text(payload))
    sys.stdout.flush()
    return 0


def watch_fleet(configured: str | None, timeout: float, interval: float) -> int:
    if not math.isfinite(interval) or interval <= 0:
        raise CliLaneError("interval must be positive")
    hosts = load_fleet_hosts(configured)
    while True:
        results = collect_fleet(hosts, timeout)
        sys.stdout.write("\033[2J\033[H")
        print_fleet_results(results, as_json=False)
        sys.stdout.flush()
        time.sleep(interval)


def print_fleet_results(results: Sequence[FleetResult], as_json: bool) -> int:
    complete = all(result.status == "ok" for result in results)
    if as_json:
        payload = {
            "schema_version": FLEET_OUTPUT_SCHEMA_VERSION,
            "complete": complete,
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "hosts": [result.as_dict() for result in results],
        }
        print(json.dumps(payload, indent=2, allow_nan=False))
        return 0 if complete else 1
    rows: list[tuple[str, str, str, str, str, str, str]] = []
    for result in results:
        if result.status != "ok":
            continue
        for task in result.tasks:
            cwd = str(task["cwd"])
            project = Path(cwd).name or cwd
            pid_value = task["pid"]
            pid = str(pid_value) if pid_value is not None else "-"
            command = shlex.join(task["command"])
            rows.append(
                (
                    result.name,
                    str(task["name"]),
                    fleet_display_cell(str(task["state"]), 32),
                    age(str(task["created"])),
                    pid,
                    fleet_display_cell(project, 64),
                    fleet_display_cell(command, 240),
                )
            )
    if rows:
        host_width = max(len("HOST"), *(len(row[0]) for row in rows))
        name_width = max(len("NAME"), *(len(row[1]) for row in rows))
        project_width = max(len("PROJECT"), *(len(row[5]) for row in rows))
        print(
            f"{'HOST':<{host_width}} {'NAME':<{name_width}} {'STATE':<10} "
            f"{'AGE':<6} {'PID':<8} {'PROJECT':<{project_width}} COMMAND"
        )
        for host, name, state, task_age, pid, project, command in rows:
            print(
                f"{host:<{host_width}} {name:<{name_width}} {state:<10} "
                f"{task_age:<6} {pid:<8} {project:<{project_width}} {command}"
            )
    else:
        healthy = sum(result.status == "ok" for result in results)
        print(f"no tasks across {healthy} healthy host{'s' if healthy != 1 else ''}")
    for result in results:
        if result.status == "error":
            print(
                f"{PROGRAM}: fleet {result.name}: {result.error_kind}: "
                f"{result.error_message}",
                file=sys.stderr,
            )
    return 0 if complete else 1


def print_status(task: Task, as_json: bool) -> None:
    if as_json:
        print(json.dumps(task.as_dict(), indent=2))
        return
    values = task.as_dict()
    keys = (
        "name",
        "id",
        "state",
        "pid",
        "exit_code",
        "signal",
        "attached",
        "created",
        "cwd",
        "log",
    )
    for key in keys:
        value = values[key]
        if value is None:
            value = "-"
        elif isinstance(value, bool):
            value = "yes" if value else "no"
        print(f"{key}: {value}")
    print(f"command: {shlex.join(task.command)}")


def attach_task(task: Task) -> int:
    configure_task_status(task.session)
    context = create_hub_context(None)
    bind_hub_keys()
    environment = os.environ.copy()
    environment.pop("TMUX", None)
    environment.pop("TMUX_PANE", None)
    binary = tmux_binary()
    os.execvpe(
        binary,
        [
            binary,
            *tmux_socket_arguments(),
            "-f",
            "/dev/null",
            "attach-session",
            "-E",
            "-t",
            task.session,
            ";",
            "run-shell",
            hub_register_command(context),
        ],
        environment,
    )
    return 1


def tmux_literal(text: str, expansions: int) -> str:
    return text.replace("#", "#" * (2 ** max(0, expansions)))


def tmux_quoted(text: str) -> str:
    escaped = text.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$")
    return f'"{escaped}"'


def discover_hub_presets(
    environment: dict[str, str], directory: str
) -> list[dict[str, object]]:
    path_value = environment.get("PATH")
    if not path_value:
        return []
    launch_directory = Path(directory).expanduser()
    if not launch_directory.is_absolute():
        raise CliLaneError("hub discovery directory must be absolute")
    search_roots: list[str] = []
    for value in path_value.split(os.pathsep):
        candidate = Path(value or ".")
        if not candidate.is_absolute():
            candidate = launch_directory / candidate
        search_roots.append(str(candidate))
    search_path = os.pathsep.join(search_roots)
    presets: list[dict[str, object]] = []
    for name in HUB_PROMPT_AGENT_ORDER:
        executable = shutil.which(name, path=search_path)
        if executable:
            presets.append(
                {"name": name, "command": [executable], "dir": str(launch_directory)}
            )
    return presets


def expanded_hub_directory(value: object, name: str, environment: Mapping[str, str]) -> str:
    if not isinstance(value, str) or not value or "\x00" in value:
        raise CliLaneError(f"hub preset dir must be a non-empty string: {name}")
    if value == "~" or value.startswith("~/"):
        home = environment.get("HOME")
        if not home:
            raise CliLaneError(f"hub preset dir needs HOME to expand '~': {name}")
        value = home + value[1:]
    expanded = Path(value)
    if not expanded.is_absolute():
        raise CliLaneError(f"hub preset dir must be absolute: {name}")
    return str(expanded)


def legacy_hub_directory(value: object, name: str) -> str:
    if not isinstance(value, str) or not value:
        raise CliLaneError(f"hub preset dir must be a string: {name}")
    expanded = Path(value).expanduser()
    if not expanded.is_absolute():
        raise CliLaneError(f"hub preset dir must be absolute: {name}")
    return str(expanded)


def resolved_hub_directory(value: object, name: str, environment: Mapping[str, str]) -> str:
    expanded = expanded_hub_directory(value, name, environment)
    resolved = Path(expanded).resolve()
    if not resolved.is_dir():
        raise CliLaneError(f"hub preset dir is not a directory: {name}: {resolved}")
    return str(resolved)


def selection_digest(value: object) -> str:
    canonical = json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8")
    return hashlib.sha256(canonical).hexdigest()


def load_hub_presets(
    configured: str | None,
    *,
    allow_missing: bool | None = None,
    discovery_environment: dict[str, str] | None = None,
    discovery_directory: str | None = None,
    launch_environment: Mapping[str, str] | None = None,
    profiles_file: str | None = None,
) -> list[dict[str, object]]:
    path = hub_config_path(configured)
    missing_ok = not configured if allow_missing is None else allow_missing
    try:
        with path.open("rb") as handle:
            raw = handle.read(CONFIG_MAX_BYTES + 1)
    except FileNotFoundError:
        if not missing_ok:
            raise CliLaneError(
                f"hub config not found: {str(path)!r}; create it or omit --config"
            ) from None
        if discovery_environment is not None and discovery_directory is not None:
            return discover_hub_presets(discovery_environment, discovery_directory)
        return []
    except OSError as error:
        raise CliLaneError(f"could not read hub config: {error}") from error
    if len(raw) > CONFIG_MAX_BYTES:
        raise CliLaneError(f"hub config exceeds the 256 KiB limit: {str(path)!r}")
    decoded = strict_json(raw, path, "hub config")
    root = exact_fields(decoded, {"schema_version", "agents"}, "hub config")
    schema_version = root["schema_version"]
    if type(schema_version) is not int or schema_version not in HUB_CONFIG_SCHEMA_VERSIONS:
        raise CliLaneError(f"unsupported hub config schema_version: {schema_version!r}")
    agents = root["agents"]
    if not isinstance(agents, list) or len(agents) > HUB_MAX_PRESETS:
        raise CliLaneError(
            f"hub config needs an agents list with at most {HUB_MAX_PRESETS} entries"
        )
    source_environment = os.environ if launch_environment is None else launch_environment
    profile_path = (
        Path(profiles_file)
        if profiles_file is not None
        else profiles_config_path(source_environment)
    )
    profiles: dict[str, Profile] | None = None
    presets: list[dict[str, object]] = []
    seen: set[str] = set()
    for entry in agents:
        if not isinstance(entry, dict):
            raise CliLaneError("each hub preset must be an object")
        name = fleet_name(entry.get("name"), "hub preset name")
        if name in seen:
            raise CliLaneError(f"duplicate hub preset: {name}")
        seen.add(name)
        if schema_version == 1:
            unexpected = set(entry) - {"name", "command", "dir"}
            if unexpected:
                raise CliLaneError(
                    f"unexpected hub preset field: {sorted(unexpected)[0]!r}"
                )
            if "command" not in entry:
                raise CliLaneError(f"missing hub preset field: command ({name})")
            command = validated_argv(entry["command"], f"hub preset command ({name})")
            directory = legacy_hub_directory(entry.get("dir", "~"), name)
            presets.append(
                {
                    "name": name,
                    "command": list(command),
                    "dir": directory,
                }
            )
            continue

        has_command = "command" in entry
        has_profile = "profile" in entry
        if has_command == has_profile:
            raise CliLaneError(
                f"hub v2 preset must contain exactly one of command or profile: {name}"
            )
        if has_command:
            unexpected = set(entry) - {"name", "command", "dir"}
            if unexpected:
                raise CliLaneError(
                    f"unexpected hub preset field: {sorted(unexpected)[0]!r}"
                )
            command = validated_argv(entry["command"], f"hub preset command ({name})")
            directory = resolved_hub_directory(
                entry.get("dir", "~"), name, source_environment
            )
            canonical = {
                "preset": {
                    "name": name,
                    "command": list(command),
                    "dir": directory,
                }
            }
            presets.append(
                {
                    "name": name,
                    "command": list(command),
                    "dir": directory,
                    "launch_mode": "raw",
                    "hub_schema_version": 2,
                    "selection_digest": selection_digest(canonical),
                    "provider": None,
                    "profile": None,
                }
            )
            continue

        profile_name = fleet_name(entry["profile"], f"hub preset profile ({name})")
        if profiles is None:
            profiles = load_profiles(profile_path)
        profile = profiles.get(profile_name)
        if profile is None:
            raise CliLaneError(f"hub preset profile not found: {profile_name}")
        profile_launch_environment(profile, source_environment)
        if profile.cwd_mode == "explicit":
            exact_fields(entry, {"name", "profile", "dir"}, f"hub preset {name!r}")
            directory = resolved_hub_directory(entry["dir"], name, source_environment)
        else:
            exact_fields(entry, {"name", "profile"}, f"hub preset {name!r}")
            if profile.cwd_path is None:
                raise CliLaneError(f"profile {profile.name!r} has no fixed cwd path")
            directory = resolved_hub_directory(
                profile.cwd_path, name, source_environment
            )
        canonical = {
            "preset": {
                "name": name,
                "profile": profile_name,
                **({"dir": directory} if profile.cwd_mode == "explicit" else {}),
            },
            "profile": profile.canonical_value(),
            "resolved_dir": directory,
        }
        presets.append(
            {
                "name": name,
                "command": list(profile.command),
                "dir": directory,
                "launch_mode": "profile",
                "hub_schema_version": 2,
                "selection_digest": selection_digest(canonical),
                "provider": profile.provider,
                "profile": profile.name,
                "profile_value": profile,
            }
        )
    return presets


def tmux_control_paths() -> tuple[str, str]:
    binary = str(Path(tmux_binary()).resolve())
    socket_path = tmux(
        ["display-message", "-p", "#{socket_path}"]
    ).stdout.decode().strip()
    if not Path(socket_path).is_absolute():
        raise CliLaneError("could not resolve the managed tmux socket")
    return binary, socket_path


def hub_environment_prefix() -> str:
    pairs = [
        ("CLILANE_TMUX_SOCKET", SOCKET),
        ("CLILANE_STATE_HOME", str(state_root())),
    ]
    tmpdir = os.environ.get("TMUX_TMPDIR")
    if tmpdir:
        pairs.append(("TMUX_TMPDIR", tmpdir))
    return " ".join(f"{key}={shlex.quote(value)}" for key, value in pairs)


def hub_helper_prefix(action: str) -> str:
    python_binary = str(Path(sys.executable).resolve())
    script = str(Path(__file__).resolve())
    control_binary, control_socket = tmux_control_paths()
    command = " ".join(
        (
            hub_environment_prefix(),
            shlex.quote(python_binary),
            shlex.quote(script),
            action,
            shlex.quote(control_binary),
            shlex.quote(control_socket),
        )
    )
    return tmux_literal(command + " ", 1)


def hub_open_command(context: str = "") -> str:
    prefix = hub_helper_prefix("__hub-open")
    return (
        f"{prefix}'#{{client_name}}' '#{{session_name}}' '#{{client_pid}}' "
        f"{tmux_literal(shlex.quote(context), 1)}"
    )


def hub_register_command(context: str) -> str:
    prefix = hub_helper_prefix("__hub-register")
    return (
        f"{prefix}'#{{client_name}}' '#{{client_pid}}' "
        f"{tmux_literal(shlex.quote(context), 1)}"
    )


def hub_detach_hook(context: str) -> str:
    hub_context_option(context)
    return f"client-detached[{int(context[:7], 16) + 1000}]"


def hub_forget_command(client: str, client_pid: str, context: str) -> str:
    prefix = hub_helper_prefix("__hub-forget")
    arguments = " ".join(
        tmux_literal(shlex.quote(value), 1)
        for value in (client, client_pid, context)
    )
    return f"{prefix}'#{{hook_client}}' {arguments}"


def bind_hub_keys() -> None:
    open_command = hub_open_command()
    tmux(
        [
            "bind-key",
            "-T",
            "root",
            "C-q",
            f"run-shell -b {tmux_quoted(open_command)}",
        ]
    )
    tmux(
        [
            "bind-key",
            "-T",
            "prefix",
            "w",
            f"run-shell -b {tmux_quoted(open_command)}",
        ]
    )
    tmux(["unbind-key", "-T", "root", "M-h"], check=False)
    tmux(["unbind-key", "-T", "root", "M-n"], check=False)
    tmux(["set-hook", "-gu", "client-detached[100]"], check=False)
    tmux(["set-option", "-gu", "@agt_hub_env"], check=False)
    tmux(["set-option", "-gu", "@agt_hub_config"], check=False)


def hub_client_exists(client: str, client_pid: str | None = None) -> bool:
    format_string = "#{client_name}" if client_pid is None else "#{client_name}|#{client_pid}"
    expected = client if client_pid is None else f"{client}|{client_pid}"
    listed = tmux(["list-clients", "-F", format_string], check=False)
    if listed.returncode != 0:
        return False
    return expected in listed.stdout.decode(errors="replace").splitlines()


def hub_context_option(context: str) -> str:
    if not HUB_CONTEXT_PATTERN.fullmatch(context):
        raise CliLaneError("invalid hub context")
    return f"{HUB_CONTEXT_OPTION_PREFIX}{context}"


def hub_client_context_option(client: str) -> str:
    digest = hashlib.sha256(client.encode()).hexdigest()[:32]
    return f"{HUB_CLIENT_CONTEXT_OPTION_PREFIX}{digest}"


def parse_hub_client_context(value: str) -> tuple[str, str] | None:
    matched = HUB_CLIENT_CONTEXT_PATTERN.fullmatch(value)
    return matched.groups() if matched else None


def hub_context_data(context: str) -> dict[str, object]:
    encoded = tmux(
        ["show-options", "-gqv", hub_context_option(context)]
    ).stdout.decode().strip()
    if not encoded:
        raise CliLaneError("the session switcher context has expired; reattach first")
    try:
        decoded = decode_meta(encoded)
    except CliLaneError as error:
        raise CliLaneError("corrupt session switcher context") from error
    environment = decoded.get("environment")
    if environment is not None and (
        not isinstance(environment, dict)
        or not all(
            isinstance(key, str) and isinstance(value, str)
            for key, value in environment.items()
        )
    ):
        raise CliLaneError("corrupt session switcher context")
    config = decoded.get("config")
    profiles = decoded.get("profiles")
    launch_cwd = decoded.get("launch_cwd")
    if (
        decoded.get("schema_version") != HUB_CONTEXT_SCHEMA_VERSION
        or not isinstance(config, str)
        or not Path(config).is_absolute()
        or not isinstance(profiles, str)
        or not Path(profiles).is_absolute()
        or (
            launch_cwd is not None
            and (
                not isinstance(launch_cwd, str)
                or not Path(launch_cwd).is_absolute()
            )
        )
        or not isinstance(decoded.get("config_required"), bool)
        or not isinstance(decoded.get("environment_error"), str)
    ):
        raise CliLaneError("corrupt session switcher context")
    return decoded


def create_hub_context(configured: str | None) -> str:
    environment = portable_environment()
    payload: dict[str, object] = {
        "schema_version": HUB_CONTEXT_SCHEMA_VERSION,
        "environment": environment,
        "environment_error": "",
        "config": str(hub_config_path(configured)),
        "profiles": str(profiles_config_path(environment)),
        "config_required": bool(configured),
        "launch_cwd": str(Path.cwd().resolve()),
    }
    encoded = encode_meta(payload)
    if len(encoded) > HUB_ENV_MAX_BYTES:
        size_kib = (len(encoded) + 1023) // 1024
        payload["environment"] = None
        payload["environment_error"] = (
            f"Session launches disabled: environment is too large "
            f"({size_kib} KiB; limit 256 KiB)"
        )
        encoded = encode_meta(payload)
    context = uuid.uuid4().hex
    tmux(["set-option", "-g", hub_context_option(context), encoded])
    return context


def register_hub_client(client: str, client_pid: str, context: str) -> None:
    if not HUB_CLIENT_CONTEXT_PATTERN.fullmatch(f"{client_pid}:{context}"):
        raise CliLaneError("invalid hub client context")
    if not hub_client_exists(client, client_pid):
        raise CliLaneError("the clilane client is no longer attached")
    hub_context_data(context)
    option = hub_client_context_option(client)
    previous = tmux(["show-options", "-gqv", option]).stdout.decode().strip()
    previous_entry = parse_hub_client_context(previous)
    if previous_entry is not None and previous_entry[1] != context:
        tmux(["set-hook", "-gu", hub_detach_hook(previous_entry[1])], check=False)
    tmux(["set-option", "-g", option, f"{client_pid}:{context}"])
    tmux(
        [
            "set-hook",
            "-g",
            hub_detach_hook(context),
            f"run-shell {tmux_quoted(hub_forget_command(client, client_pid, context))}",
        ]
    )
    if previous_entry is not None and previous_entry[1] != context:
        tmux(
            ["set-option", "-gu", hub_context_option(previous_entry[1])],
            check=False,
        )


def hub_client_context(client: str, client_pid: str) -> str:
    value = tmux(
        ["show-options", "-gqv", hub_client_context_option(client)]
    ).stdout.decode().strip()
    entry = parse_hub_client_context(value)
    if entry is None or entry[0] != client_pid:
        raise CliLaneError("this client has no switcher context; reattach with clilane")
    context = entry[1]
    hub_context_data(context)
    return context


def forget_hub_client(
    client: str, context: str | None = None, client_pid: str | None = None
) -> None:
    option = hub_client_context_option(client)
    current = tmux(["show-options", "-gqv", option]).stdout.decode().strip()
    entry = parse_hub_client_context(current)
    if entry is None:
        return
    mapped_pid, mapped_context = entry
    if context is not None and mapped_context != context:
        return
    if client_pid is not None and mapped_pid != client_pid:
        return
    tmux(["set-option", "-gu", option], check=False)
    tmux(["set-hook", "-gu", hub_detach_hook(mapped_context)], check=False)
    tmux(["set-option", "-gu", hub_context_option(mapped_context)], check=False)


def hub_register(client: str, client_pid: str, context: str) -> int:
    register_hub_client(client, client_pid, context)
    return 0


def hub_forget(
    detached_client: str, client: str, client_pid: str, context: str
) -> int:
    if detached_client != client:
        return 0
    forget_hub_client(client, context=context, client_pid=client_pid)
    tmux(["set-hook", "-gu", hub_detach_hook(context)], check=False)
    return 0


def hub_open(
    client: str, source: str, client_pid: str, supplied_context: str
) -> int:
    if not hub_client_exists(client, client_pid):
        raise CliLaneError("the clilane client is no longer attached")
    if supplied_context:
        register_hub_client(client, client_pid, supplied_context)
    context = hub_client_context(client, client_pid)
    data = hub_context_data(context)
    environment = data["environment"]
    load_hub_presets(
        str(data["config"]),
        allow_missing=not bool(data["config_required"]),
        launch_environment=environment if isinstance(environment, dict) else {},
        profiles_file=str(data["profiles"]),
    )
    ensure_hub_session()
    for task in list_tasks():
        configure_task_status(task.session)
    tmux(["switch-client", "-E", "-c", client, "-t", HUB_SESSION])
    tmux(["display-popup", "-c", client, "-C"], check=False)
    command = (
        f"{hub_helper_prefix('__hub-ui')}"
        f"{shlex.quote(client)} {shlex.quote(source)} {shlex.quote(context)}"
    )
    shown = tmux(
        [
            "display-popup",
            "-c",
            client,
            "-E",
            "-B",
            "-w",
            "100%",
            "-h",
            "100%",
            "-x",
            "0",
            "-y",
            "0",
            command,
        ],
        check=False,
    )
    if shown.returncode != 0:
        detail = shown.stderr.decode(errors="replace").strip()
        raise CliLaneError(detail or "could not open the session switcher")
    return 0


def next_hub_task_name(base: str, tasks: Sequence[Task]) -> str:
    names = {task.name for task in tasks}
    if base not in names:
        return base
    suffix = 2
    while True:
        ending = f"-{suffix}"
        candidate = f"{base[: 64 - len(ending)]}{ending}"
        if candidate not in names:
            return candidate
        suffix += 1


def hub_task_order(tasks: Sequence[Task]) -> list[Task]:
    newest_first = sorted(tasks, key=lambda task: task.created, reverse=True)
    return sorted(newest_first, key=lambda task: task.dead)


def hub_read_byte(descriptor: int, timeout: float) -> bytes | None:
    readable, _, _ = select.select([descriptor], [], [], timeout)
    if not readable:
        return None
    value = os.read(descriptor, 1)
    return value or None


def hub_read_bytes(descriptor: int, count: int, timeout: float) -> bytes | None:
    value = bytearray()
    while len(value) < count:
        part = hub_read_byte(descriptor, timeout)
        if part is None:
            return None
        value.extend(part)
    return bytes(value)


def hub_read_paste(descriptor: int) -> str:
    terminator = b"\x1b[201~"
    maximum = HUB_PROMPT_MAX_CHARS * 4
    value = bytearray()
    tail = bytearray()
    while True:
        part = hub_read_byte(descriptor, 5.0)
        if part is None:
            break
        if len(value) < maximum:
            value.extend(part)
        tail.extend(part)
        if len(tail) > len(terminator):
            del tail[: len(tail) - len(terminator)]
        if tail == terminator:
            if value.endswith(terminator):
                del value[-len(terminator) :]
            break
    return bytes(value).decode("utf-8", errors="replace")


def hub_key(descriptor: int) -> tuple[str, str] | None:
    first = hub_read_byte(descriptor, HUB_REFRESH_SECONDS)
    if first is None:
        return None
    if first == b"\x1b":
        introducer = hub_read_byte(descriptor, 0.03)
        if introducer is None:
            return "left", ""
        if introducer not in {b"[", b"O"}:
            return "ignore", ""
        final = hub_read_byte(descriptor, 0.03)
        if final is None:
            return "left", ""
        arrow = {
            b"A": "up",
            b"B": "down",
            b"C": "right",
            b"D": "left",
        }.get(final)
        if arrow:
            return arrow, ""
        if introducer == b"[" and final == b"Z":
            return "backtab", ""
        if introducer == b"[" and final == b"2":
            ending = hub_read_bytes(descriptor, 3, 0.03)
            if ending == b"00~":
                return "text", hub_read_paste(descriptor)
        return "ignore", ""
    controls = {
        b"\r": "enter",
        b"\n": "enter",
        b"\t": "tab",
        b"\x08": "backspace",
        b"\x7f": "backspace",
        b"\x11": "quit",
        b"\x15": "clear",
    }
    if first in controls:
        return controls[first], ""
    lead = first[0]
    length = 1
    if lead & 0b11110000 == 0b11110000:
        length = 4
    elif lead & 0b11100000 == 0b11100000:
        length = 3
    elif lead & 0b11000000 == 0b11000000:
        length = 2
    remaining = hub_read_bytes(descriptor, length - 1, 0.03) if length > 1 else b""
    if remaining is None:
        return "ignore", ""
    try:
        value = (first + remaining).decode("utf-8")
    except UnicodeDecodeError:
        return "ignore", ""
    return ("text", value) if value.isprintable() or value in "\n\t" else ("ignore", "")


def hub_preset_kind(preset: dict[str, object]) -> str | None:
    name = str(preset["name"]).lower()
    provider = str(preset.get("provider") or "").lower()
    command = list(preset["command"])
    executable = Path(str(command[0])).name.lower() if command else ""
    return next(
        (
            kind
            for kind in HUB_PROMPT_AGENT_ORDER
            if kind in {name, provider, executable}
        ),
        None,
    )


def hub_composer_presets(
    presets: Sequence[dict[str, object]],
) -> list[dict[str, object]]:
    recognized = [
        preset
        for kind in HUB_PROMPT_AGENT_ORDER
        for preset in presets
        if hub_preset_kind(preset) == kind
    ]
    generic = [preset for preset in presets if hub_preset_kind(preset) is None]
    return recognized + generic


def hub_task_name(preset: dict[str, object], tasks: Sequence[Task]) -> str:
    agent = str(preset["name"])
    project = Path(str(preset["dir"])).name
    normalized = unicodedata.normalize("NFKD", project).encode("ascii", "ignore").decode()
    project_slug = re.sub(r"[^A-Za-z0-9]+", "-", normalized).strip("-").lower()
    base = f"{agent}-{project_slug}" if project_slug else agent
    return next_hub_task_name(base[:64], tasks)


def revalidate_hub_preset(
    preset: dict[str, object],
    config: str,
    profiles_file: str,
    environment: Mapping[str, str],
) -> dict[str, object]:
    if preset.get("hub_schema_version") != 2:
        return preset
    try:
        reloaded = load_hub_presets(
            config,
            allow_missing=False,
            launch_environment=environment,
            profiles_file=profiles_file,
        )
    except CliLaneError as error:
        raise CliLaneError(f"hub configuration changed; reopen menu: {error}") from error
    selected = next(
        (item for item in reloaded if item["name"] == preset["name"]), None
    )
    if selected is None:
        raise CliLaneError("hub configuration changed; reopen menu: preset no longer exists")
    if selected.get("selection_digest") != preset.get("selection_digest"):
        raise CliLaneError("hub configuration changed; reopen menu")
    return selected


def launch_hub_preset(
    preset: dict[str, object], name: str, context: str, prompt: str = ""
) -> Task:
    if prompt:
        validate_message_text(prompt)
    data = hub_context_data(context)
    environment = hub_launch_environment(context)
    selected = revalidate_hub_preset(
        preset,
        str(data["config"]),
        str(data["profiles"]),
        environment,
    )

    if selected.get("launch_mode") == "profile":
        profile = selected.get("profile_value")
        if not isinstance(profile, Profile):
            raise CliLaneError("corrupt resolved hub profile")
        launch_environment = profile_launch_environment(profile, environment)
        profile_name: str | None = profile.name
        provider: str | None = profile.provider
    else:
        launch_environment = legacy_launch_environment(environment)
        profile_name = None
        provider = None
    spec = complete_launch_spec(
        name=name,
        cwd_value=str(selected["dir"]),
        command=list(selected["command"]),
        wait=False,
        timeout=None,
        on_exit=None,
        environment=launch_environment,
        profile=profile_name,
        provider=provider,
    )
    task = run_task(spec)
    if prompt:
        send_task(task.id, prompt, True)
    return task


def hub_task_line(task: Task) -> str:
    markers = {
        TASK_STATE_INITIALIZING: "○",
        TASK_STATE_RUNNING: "●",
        TASK_STATE_STOPPED: "■",
        TASK_STATE_SUCCEEDED: "✓",
        TASK_STATE_FAILED: "!",
    }
    marker = markers.get(task.state, "·")
    agent = Path(task.command[0]).name if task.command else "-"
    project = Path(task.cwd).name or task.cwd
    source = "BOT" if task.origin == "bot" else "LOCAL"
    attached = " open" if task.attached else ""
    return (
        f"{marker}  {task.name:<22.22} {agent:<12.12} "
        f"{task.state:<12.12} {age(task.created):>4}  {source:<5} {project}{attached}"
    )


def hub_composer_line(
    preset: dict[str, object] | None, prompt: str, cursor: int, width: int
) -> str:
    if preset:
        project = Path(str(preset["dir"])).name or str(preset["dir"])
        agent = fleet_display_cell(
            f"{preset['name']} · {project}", max(1, width - 10)
        )
    else:
        agent = "no-agent"
    prefix = f"[{agent}] > "
    room = max(1, width - len(prefix) - 2)
    before = fleet_display_cell(prompt[:cursor])
    after = fleet_display_cell(prompt[cursor:])
    left_room = min(len(before), max(room // 2, room - len(after) - 1))
    visible_before = before[-left_room:] if left_room else ""
    if len(before) > len(visible_before) and room > 1:
        visible_before = "…" + visible_before[1:]
    after_room = max(0, room - len(visible_before) - 1)
    visible_after = after[:after_room]
    return f"\033[1m[{agent}]\033[0m > {visible_before}▏{visible_after}"


def hub_no_presets_notice(
    config: str, *, config_present: bool, config_required: bool
) -> str:
    if config_required:
        return f"Add agent presets to {config}"
    if config_present:
        return f"Config disables discovery · Remove it or add agent presets to {config}"
    return f"Install Codex, Kimi, or Claude · Add agent presets to {config}"


def hub_draw(
    tasks: Sequence[Task],
    selected: int,
    presets: Sequence[dict[str, object]],
    agent_index: int,
    prompt: str,
    cursor: int,
    notice: str,
) -> None:
    width, height = shutil.get_terminal_size((80, 24))
    width = max(24, width)
    height = max(12, height)
    preset = presets[agent_index] if presets else None
    agents = " / ".join(str(item["name"]) for item in presets) or "no presets"
    rows = [hub_task_line(task) for task in tasks]
    rows.append("+  New session")
    selected = max(0, min(selected, len(rows) - 1))
    body_height = max(1, height - 9)
    start = max(0, min(selected - body_height // 2, len(rows) - body_height))
    visible = rows[start : start + body_height]
    lines = [
        "\033[1mCLI LANE\033[0m",
        fleet_display_cell(
            "This clilane server · LOCAL terminal · BOT OpenClaw/automation", width
        ),
        fleet_display_cell(
            f"   {'JOB':<22} {'AGENT':<12} {'STATE':<12} "
            f"{'AGE':>4}  {'ORIGIN':<6} PROJECT",
            width,
        ),
    ]
    for offset, row in enumerate(visible, start=start):
        cleaned = fleet_display_cell(row, max(1, width - 2))
        padded = f" {cleaned:<{max(1, width - 2)}}"
        if offset == selected:
            lines.append(f"\033[7m{padded}\033[0m")
        else:
            lines.append(padded)
    while len(lines) < height - 4:
        lines.append("")
    if notice:
        lines.append(f"\033[1m{fleet_display_cell(notice, width)}\033[0m")
    else:
        lines.append("")
    lines.extend(
        [
            hub_composer_line(preset, prompt, cursor, width),
            fleet_display_cell(
                f"type message · Tab agent ({agents}) · Enter start · ↑↓ jobs", width
            ),
            fleet_display_cell(
                "empty message: →/Enter view · ←/Ctrl-Q detach", width
            ),
        ]
    )
    sys.stdout.write("\033[H\033[2J" + "\r\n".join(lines[:height]))
    sys.stdout.flush()


def hub_ui(client: str, source: str, context: str) -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise CliLaneError("the session switcher needs an interactive terminal")
    if not hub_client_exists(client):
        raise CliLaneError("the clilane client is no longer attached")
    data = hub_context_data(context)
    config = str(data["config"])
    config_present = Path(config).exists()
    config_required = bool(data["config_required"])
    tasks = hub_task_order(list_tasks())
    source_task = next((task for task in tasks if task.session == source), None)
    configured_directory = data.get("launch_cwd")
    discovery_directory = (
        source_task.cwd
        if source_task is not None
        else configured_directory
        if isinstance(configured_directory, str)
        else str(Path.home())
    )
    context_environment = data["environment"]
    presets = hub_composer_presets(
        load_hub_presets(
            config,
            allow_missing=not config_required,
            discovery_environment=context_environment
            if isinstance(context_environment, dict)
            else None,
            discovery_directory=discovery_directory,
            launch_environment=context_environment
            if isinstance(context_environment, dict)
            else {},
            profiles_file=str(data["profiles"]),
        )
    )
    selected_key = source_task.id if source_task else (tasks[0].id if tasks else "")
    agent_index = 0
    if source_task:
        exact_indices = [
            index
            for index, preset in enumerate(presets)
            if list(preset["command"]) == source_task.command
            and Path(str(preset["dir"])).resolve() == Path(source_task.cwd).resolve()
        ]
        named_indices = [
            index
            for index in exact_indices
            if source_task.name == str(presets[index]["name"])
            or source_task.name.startswith(f"{presets[index]['name']}-")
        ]
        named_index = max(
            named_indices,
            key=lambda index: len(str(presets[index]["name"])),
            default=None,
        )
        source_kind = hub_preset_kind(
            {"name": "", "command": source_task.command, "dir": source_task.cwd}
        )
        if named_index is not None:
            agent_index = named_index
        elif exact_indices:
            agent_index = exact_indices[0]
        elif source_kind is not None:
            agent_index = next(
                (
                    index
                    for index, preset in enumerate(presets)
                    if hub_preset_kind(preset) == source_kind
                ),
                0,
            )
    prompt = ""
    cursor = 0
    notice = str(data["environment_error"])
    if not notice and not presets:
        notice = hub_no_presets_notice(
            config,
            config_present=config_present,
            config_required=config_required,
        )
    descriptor = sys.stdin.fileno()
    previous = termios.tcgetattr(descriptor)
    try:
        tty.setraw(descriptor)
        sys.stdout.write("\033[?1049h\033[?25l\033[?2004h")
        sys.stdout.flush()
        while True:
            tasks = hub_task_order(list_tasks())
            item_keys = [task.id for task in tasks] + [""]
            if selected_key not in item_keys:
                selected_key = ""
            selected = item_keys.index(selected_key)
            item_count = len(item_keys)
            preset = presets[agent_index] if presets else None
            hub_draw(tasks, selected, presets, agent_index, prompt, cursor, notice)
            event = hub_key(descriptor)
            if event is None:
                continue
            notice = ""
            key, text_value = event
            if key == "up":
                selected = (selected - 1) % max(1, item_count)
                selected_key = item_keys[selected]
                continue
            if key == "down":
                selected = (selected + 1) % max(1, item_count)
                selected_key = item_keys[selected]
                continue
            if key == "quit":
                forget_hub_client(client, context)
                tmux(["detach-client", "-t", client], check=False)
                return 0
            if key == "left":
                if prompt:
                    cursor = max(0, cursor - 1)
                    continue
                forget_hub_client(client, context)
                tmux(["detach-client", "-t", client], check=False)
                return 0
            if key == "right" and prompt:
                cursor = min(len(prompt), cursor + 1)
                continue
            if key in {"tab", "backtab"}:
                if presets:
                    direction = -1 if key == "backtab" else 1
                    agent_index = (agent_index + direction) % len(presets)
                else:
                    notice = hub_no_presets_notice(
                        config,
                        config_present=config_present,
                        config_required=config_required,
                    )
                continue
            if key == "clear":
                prompt = ""
                cursor = 0
                continue
            if key == "backspace":
                if cursor:
                    prompt = prompt[: cursor - 1] + prompt[cursor:]
                    cursor -= 1
                continue
            if key == "text":
                available = HUB_PROMPT_MAX_CHARS - len(prompt)
                inserted = text_value[:available]
                prompt = prompt[:cursor] + inserted + prompt[cursor:]
                cursor += len(inserted)
                if len(text_value) > available:
                    notice = f"Message limited to {HUB_PROMPT_MAX_CHARS} characters"
                continue
            if key not in {"enter", "right"}:
                continue
            if not prompt:
                if selected < len(tasks):
                    tmux(
                        [
                            "switch-client",
                            "-E",
                            "-c",
                            client,
                            "-t",
                            tasks[selected].session,
                        ]
                    )
                    return 0
                notice = "Type a message to start a new session"
                continue
            if preset is None:
                notice = hub_no_presets_notice(
                    config,
                    config_present=config_present,
                    config_required=config_required,
                )
                continue
            name = hub_task_name(preset, tasks)
            hub_draw(
                tasks,
                selected,
                presets,
                agent_index,
                prompt,
                cursor,
                f"Starting {name}…",
            )
            try:
                task = launch_hub_preset(preset, name, context, prompt)
            except CliLaneError as error:
                notice = str(error)
                continue
            tmux(["switch-client", "-E", "-c", client, "-t", task.session])
            return 0
    finally:
        with suppress(termios.error):
            termios.tcsetattr(descriptor, termios.TCSADRAIN, previous)
        with suppress(OSError):
            sys.stdout.write("\033[?2004l\033[?25h\033[?1049l")
            sys.stdout.flush()


def portable_environment() -> dict[str, str]:
    return legacy_launch_environment(os.environ)


def hub_launch_environment(context: str) -> dict[str, str]:
    decoded = hub_context_data(context)
    error = str(decoded["environment_error"])
    environment = decoded["environment"]
    if error or environment is None:
        raise CliLaneError(error or "the session launch environment is unavailable")
    if not isinstance(environment, dict):
        raise CliLaneError("corrupt session switcher context")
    return {
        key: value for key, value in environment.items() if isinstance(value, str)
    }


def ensure_hub_session() -> None:
    if tmux_session_absent(HUB_SESSION):
        shell = os.environ.get("SHELL") or "/bin/sh"
        tmux(
            [
                "start-server",
                ";",
                "set-option",
                "-g",
                "history-limit",
                "50000",
                ";",
                "set-option",
                "-g",
                "@agt_server",
                SERVER_TAG,
                ";",
                "new-session",
                "-d",
                "-s",
                HUB_SESSION,
                "-c",
                str(Path.home()),
                shell,
                "-l",
            ]
        )
    tmux(
        [
            "set-option",
            "-t",
            HUB_SESSION,
            "status-right",
            " C-q switcher ",
        ]
    )
    tmux(["set-option", "-t", HUB_SESSION, "status-left", " CLI LANE "])
    tmux(["set-option", "-t", HUB_SESSION, "status-left-length", "20"])


def hub_command(configured: str | None) -> int:
    load_hub_presets(configured)
    ensure_server_available()
    ensure_hub_session()
    context = create_hub_context(configured)
    bind_hub_keys()
    environment = os.environ.copy()
    environment.pop("TMUX", None)
    environment.pop("TMUX_PANE", None)
    binary = tmux_binary()
    os.execvpe(
        binary,
        [
            binary,
            *tmux_socket_arguments(),
            "-f",
            "/dev/null",
            "attach-session",
            "-E",
            "-t",
            HUB_SESSION,
            ";",
            "run-shell",
            "-b",
            hub_open_command(context),
        ],
        environment,
    )
    return 1


def read_task(task: Task, all_history: bool) -> int:
    start = "-" if all_history else "-200"
    captured = tmux(["capture-pane", "-p", "-J", "-S", start, "-t", task.pane])
    sys.stdout.buffer.write(captured.stdout)
    return 0


def log_task(task: Task, lines: int, follow: bool) -> int:
    if lines < 0:
        raise CliLaneError("lines must be non-negative")
    tail = shutil.which("tail")
    if not tail:
        raise CliLaneError("tail is required")
    arguments = [tail, "-n", str(lines)]
    log_path = validated_log_path(task)
    if follow:
        arguments.extend(["-F", str(log_path)])
    else:
        previous = log_path.with_suffix(log_path.suffix + ".previous")
        if previous.exists():
            arguments.append(str(previous))
        arguments.append(str(log_path))
    return subprocess.call(arguments)


def live_task(target: str) -> Task:
    task = resolve_task(target)
    if task.dead:
        raise CliLaneError(f"task is not running: {task.name}")
    if not task.committed:
        raise CliLaneError(f"task is still initializing: {task.name}")
    return task


def validate_message_text(message: str) -> None:
    if not message:
        raise CliLaneError(
            f"message is empty; use '{PROGRAM} key TARGET Enter' to press a key"
        )
    rejected = sorted(
        {
            character
            for character in message
            if unicodedata.category(character) in MESSAGE_REJECTED_CATEGORIES
            and character not in MESSAGE_ALLOWED_CONTROLS
        }
    )
    if rejected:
        listed = ", ".join(ascii(character) for character in rejected)
        raise CliLaneError(
            f"message contains control characters ({listed}); they would reach "
            f"the task as raw bytes, not keypresses; use '{PROGRAM} key' instead"
        )


def send_task(target: str, message: str, enter: bool) -> int:
    validate_message_text(message)
    with registry_lock():
        task = live_task(target)
        buffer_name = f"agt_{uuid.uuid4().hex}"
        tmux(["load-buffer", "-b", buffer_name, "-"], input_data=message.encode())
        try:
            command = ["paste-buffer", "-b", buffer_name, "-d", "-t", task.pane]
            if enter:
                command.extend([";", "send-keys", "-t", task.pane, "Enter"])
            tmux(command)
        finally:
            tmux(["delete-buffer", "-b", buffer_name], check=False)
        return 0


def is_key_name(value: str) -> bool:
    return (
        value in NAMED_KEYS
        or value.lower() in {name.lower() for name in NAMED_KEYS}
        or bool(KEY_PATTERN.fullmatch(value))
    )


def validated_keys(keys: Sequence[str]) -> list[str]:
    if not keys:
        raise CliLaneError(f"missing key; run '{PROGRAM} key --list' to see keys")
    aliases = {name.lower(): name for name in NAMED_KEYS}
    validated = []
    for key in keys:
        if key in NAMED_KEYS or KEY_PATTERN.fullmatch(key):
            validated.append(key)
        elif key.lower() in aliases:
            validated.append(aliases[key.lower()])
        else:
            raise CliLaneError(
                f"unsupported key: {key!r}; run '{PROGRAM} key --list' to see keys"
            )
    return validated


def print_key_names() -> int:
    named = sorted(NAMED_KEYS, key=str.lower)
    print(" ".join(named))
    print("modifiers: C- (Ctrl), M- (Alt), applied to one printable character")
    return 0


def key_task(target: str, keys: Sequence[str]) -> int:
    validated = validated_keys(keys)
    with registry_lock():
        task = live_task(target)
        tmux(["send-keys", "-t", task.pane, "--", *validated])
    return 0


def wait_task(target: str, timeout: float | None) -> int:
    with registry_lock():
        task = resolve_task(target)
        if not task.committed:
            raise CliLaneError(f"task initialization is incomplete: {task.name}")
        lock_handle = acquire_task_lock(task.id, exclusive=False)
    task_id = task.id
    started = time.monotonic()
    try:
        while True:
            task = resolve_task(task_id)
            if task.dead:
                return task.result_code
            if timeout is not None and time.monotonic() - started >= timeout:
                print(f"{PROGRAM}: timeout waiting for {task.name}", file=sys.stderr)
                return 124
            time.sleep(0.2)
    finally:
        release_task_lock(lock_handle)


def validated_supervisor(task: Task) -> int:
    if task.pid is None:
        raise CliLaneError(f"task has no process id: {task.name}")
    if not task.process_started:
        raise CliLaneError(f"task has no process identity: {task.name}")
    try:
        session_id = os.getsid(task.pid)
    except ProcessLookupError as error:
        raise CliLaneError(f"task process disappeared: {task.name}") from error
    if session_id != task.pid:
        raise CliLaneError("refusing a task whose supervisor is not its session leader")
    if process_start_time(task.pid) != task.process_started:
        raise CliLaneError("refusing a task whose supervisor identity changed")
    server_pid = optional_int(tmux(["display-message", "-p", "#{pid}"]).stdout.decode().strip())
    if server_pid is not None and task.pid == server_pid:
        raise CliLaneError("refusing to signal the tmux server")
    return task.pid


def managed_session_empty(task: Task) -> bool:
    if task.pid is None:
        return True
    current_started = process_start_time(task.pid)
    if task.process_started and current_started and current_started != task.process_started:
        return True
    if task.dead and not task.process_started and current_started:
        return True
    return not session_pids(task.pid)


def terminate_dead_task_descendants(task: Task, grace: float) -> None:
    if managed_session_empty(task):
        return
    if task.pid is None:
        raise CliLaneError(f"dead task has unverifiable descendants: {task.name}")
    terminate_session_descendants(task.pid, grace, task.process_started)
    if not managed_session_empty(task):
        raise CliLaneError(f"dead task descendants did not stop: {task.name}")


def stop_task_locked(task: Task, grace: float) -> Task:
    if grace < 0:
        raise CliLaneError("grace must be non-negative")
    if task.dead:
        if not managed_session_empty(task):
            tmux(["set-option", "-t", task.session, "@agt_stop_requested", "1"])
            terminate_dead_task_descendants(task, grace)
            return resolve_task(task.id)
        return task
    if not task.committed:
        raise CliLaneError(f"task is still initializing: {task.name}")
    tmux(["set-option", "-t", task.session, "@agt_stop_requested", "1"])
    current = resolve_task(task.id)
    if current.dead:
        if not managed_session_empty(current):
            terminate_dead_task_descendants(current, grace)
            return resolve_task(task.id)
        return current
    supervisor = validated_supervisor(current)
    try:
        os.kill(supervisor, signal.SIGCONT)
        os.kill(supervisor, signal.SIGTERM)
    except ProcessLookupError:
        refreshed = resolve_task(task.id)
        if refreshed.dead and managed_session_empty(refreshed):
            return refreshed
        if refreshed.dead:
            terminate_dead_task_descendants(refreshed, grace)
            return resolve_task(task.id)
        raise CliLaneError(f"task process disappeared: {task.name}")
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        current = resolve_task(task.id)
        if current.dead and managed_session_empty(current):
            return current
        time.sleep(0.1)
    current = resolve_task(task.id)
    if current.dead and managed_session_empty(current):
        return current
    if not current.dead and validated_supervisor(current) != supervisor:
        raise CliLaneError("task supervisor changed while stopping; refusing SIGKILL")
    terminate_session_descendants(supervisor, 0, current.process_started)
    if process_start_time(supervisor) == current.process_started:
        with suppress(ProcessLookupError):
            if os.getsid(supervisor) == supervisor:
                os.kill(supervisor, signal.SIGKILL)
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        current = resolve_task(task.id)
        if current.dead and managed_session_empty(current):
            return current
        time.sleep(0.1)
    raise CliLaneError(f"task did not stop: {task.name}")


def stop_task(target: str, grace: float) -> Task:
    with registry_lock():
        return stop_task_locked(resolve_task(target), grace)


def remove_task_locked(task: Task, force: bool, grace: float) -> None:
    current = task
    if not current.committed:
        if not force:
            raise CliLaneError(f"task initialization is incomplete; use --force: {task.name}")
        if current.id and current.log:
            record_from_task(current, RECORD_PHASE_REMOVING)
        log_path = validated_log_path(current) if current.log else None
        terminate_incomplete_session(
            current.session,
            current.pane,
            grace,
            current.process_started,
        )
        kill_managed_session(current.session)
        if log_path:
            log_path.unlink(missing_ok=True)
            log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
        if current.id:
            delete_record(current.id)
        return
    if not current.dead:
        if not force:
            raise CliLaneError(f"task is running; use --force to stop and remove: {task.name}")
        current = stop_task_locked(current, grace)
    if not managed_session_empty(current):
        if not force:
            raise CliLaneError(f"refusing removal with live descendants: {current.name}")
        terminate_dead_task_descendants(current, grace)
    if current.id and current.log:
        record_from_task(current, RECORD_PHASE_REMOVING)
    log_path = validated_log_path(current) if current.log else None
    kill_managed_session(current.session)
    if log_path:
        log_path.unlink(missing_ok=True)
        log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
    if current.id:
        delete_record(current.id)


def remove_task(target: str, force: bool, grace: float) -> Task:
    with registry_lock():
        task = resolve_task(target)
        current = task
        if current.committed and not current.dead:
            if not force:
                raise CliLaneError(f"task is running; use --force to stop and remove: {task.name}")
            current = stop_task_locked(current, grace)
        lock_handle = acquire_task_lock(current.id, exclusive=True)
        try:
            remove_task_locked(current, force, grace)
        finally:
            release_task_lock(lock_handle)
        return current


def classify_records(
    records: Sequence[TaskRecord], tasks: Sequence[Task]
) -> dict[str, list[TaskRecord]]:
    live_ids = {task.id for task in tasks if task.id}
    classified: dict[str, list[TaskRecord]] = {
        "live": [],
        "aborted": [],
        "interrupted": [],
        "superseded": [],
        "orphan": [],
    }
    for record in records:
        if record.id in live_ids:
            classified["live"].append(record)
        elif record.phase == RECORD_PHASE_PENDING:
            classified["aborted"].append(record)
        elif record.phase == RECORD_PHASE_REMOVING:
            classified["interrupted"].append(record)
        elif not Path(record.log).expanduser().is_file():
            classified["superseded"].append(record)
        else:
            classified["orphan"].append(record)
    return classified


def confirm_server_absent(tasks: Sequence[Task], records: Sequence[TaskRecord]) -> None:
    disk_only = [record for record in records if record.id not in {task.id for task in tasks}]
    if tasks or not disk_only:
        return
    probe = tmux(["list-sessions", "-F", "#{session_name}"], check=False)
    if probe.returncode != 0:
        if tmux_server_absent(probe):
            return
        raise CliLaneError("could not confirm the tmux server is absent; not reclaiming")
    names = probe.stdout.decode(errors="replace").split()
    if any(name.startswith(SESSION_PREFIX) for name in names):
        raise CliLaneError("the tmux server still holds task sessions; not reclaiming")


def reap_record(record: TaskRecord, live_sessions: frozenset[str]) -> None:
    if record.session in live_sessions:
        raise CliLaneError(f"record session belongs to a live task: {record.name}")
    log_path = validated_record_log_path(record)
    kill_managed_session(record.session)
    log_path.unlink(missing_ok=True)
    log_path.with_suffix(log_path.suffix + ".previous").unlink(missing_ok=True)
    delete_record(record.id)


def unclaimed_logs(tasks: Sequence[Task]) -> list[Path]:
    log_dir = state_root() / "logs"
    if not log_dir.is_dir():
        return []
    claimed = claimed_log_paths()
    for task in tasks:
        if task.log:
            claimed.add(Path(task.log).expanduser().resolve())
    unclaimed = []
    for path in sorted(log_dir.glob("*.log")):
        if path.resolve() not in claimed:
            unclaimed.append(path)
    return unclaimed


def clean_tasks(dry_run: bool, orphans: bool) -> int:
    failures: list[str] = []
    reclaimed = 0
    orphans_kept = 0
    reclaimed_logs = 0
    with registry_lock():
        ensure_server_available()
        tasks = list_tasks()
        if not dry_run:
            backfill_records(tasks)
        removable = [task for task in tasks if task.dead or not task.committed]
        removed = 0
        for task in removable:
            if dry_run:
                removed += 1
                continue
            lock_handle = acquire_task_lock(task.id, exclusive=True)
            try:
                remove_task_locked(task, force=True, grace=0)
                removed += 1
            except CliLaneError as error:
                failures.append(str(error))
            finally:
                release_task_lock(lock_handle)
        records, damaged = read_records()
        classified = classify_records(records, tasks)
        live_sessions = frozenset(task.session for task in tasks)
        stale = classified["aborted"] + classified["interrupted"] + classified["superseded"]
        if orphans:
            stale += classified["orphan"]
        else:
            orphans_kept = len(classified["orphan"])
        leftover = unclaimed_logs(tasks)
        reap_leftover = orphans and leftover and not tasks
        if stale or reap_leftover:
            confirm_server_absent(tasks, records)
        for record in stale:
            if dry_run:
                reclaimed += 1
                continue
            lock_handle = acquire_task_lock(record.id, exclusive=True)
            try:
                reap_record(record, live_sessions)
                reclaimed += 1
            except CliLaneError as error:
                failures.append(str(error))
            finally:
                release_task_lock(lock_handle)
        if reap_leftover:
            for path in leftover:
                if not dry_run:
                    path.unlink(missing_ok=True)
                    path.with_suffix(path.suffix + ".previous").unlink(missing_ok=True)
                reclaimed_logs += 1
            leftover = []
    verb = "would remove" if dry_run else "removed"
    print(f"{verb} {removed} task{'s' if removed != 1 else ''}")
    if reclaimed:
        print(f"{verb} {reclaimed} lost task record{'s' if reclaimed != 1 else ''}")
    if reclaimed_logs:
        print(f"{verb} {reclaimed_logs} unclaimed log{'s' if reclaimed_logs != 1 else ''}")
    if orphans_kept:
        print(
            f"{PROGRAM}: kept {orphans_kept} orphaned log{'s' if orphans_kept != 1 else ''};"
            f" run '{PROGRAM} orphans' to inspect or '{PROGRAM} clean --orphans' to delete",
            file=sys.stderr,
        )
    for path in leftover:
        print(f"{PROGRAM}: unclaimed log left in place: {path}", file=sys.stderr)
    for failure in failures:
        print(f"{PROGRAM}: {failure}", file=sys.stderr)
    for path in damaged:
        print(f"{PROGRAM}: damaged task record left in place: {path}", file=sys.stderr)
    return 1 if failures else 0


def print_orphans(as_json: bool) -> int:
    with registry_lock():
        tasks = list_tasks()
        records, damaged = read_records()
        unclaimed = unclaimed_logs(tasks)
    orphans = classify_records(records, tasks)["orphan"]
    if as_json:
        payload = {
            "schema_version": 1,
            "orphans": [
                {
                    "id": record.id,
                    "name": record.name,
                    "command": record.command,
                    "cwd": record.cwd,
                    "created": record.created,
                    "log": record.log,
                }
                for record in orphans
            ],
            "unclaimed_logs": [str(path) for path in unclaimed],
        }
        print(json.dumps(payload, indent=2, allow_nan=False))
    elif not orphans:
        print("no orphaned tasks")
    else:
        projects = [Path(record.cwd).name or record.cwd for record in orphans]
        name_width = max(len("NAME"), *(len(record.name) for record in orphans))
        project_width = max(len("PROJECT"), *(len(project) for project in projects))
        print(
            f"{'NAME':<{name_width}} {'AGE':<6} {'PROJECT':<{project_width}} COMMAND"
        )
        for record, project in zip(orphans, projects):
            print(
                f"{record.name:<{name_width}} {age(record.created):<6} "
                f"{project:<{project_width}} {shlex.join(record.command)}"
            )
    if not as_json:
        for path in unclaimed:
            print(f"{PROGRAM}: unclaimed log: {path}", file=sys.stderr)
    for path in damaged:
        print(f"{PROGRAM}: damaged task record left in place: {path}", file=sys.stderr)
    return 0


def watch_tasks(interval: float) -> int:
    if interval <= 0:
        raise CliLaneError("interval must be positive")
    while True:
        sys.stdout.write("\033[2J\033[H")
        print_tasks(list_tasks(), as_json=False)
        sys.stdout.flush()
        time.sleep(interval)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        prog=PROGRAM,
        description=(
            "Run and manage long-lived CLI tasks on one machine or across a "
            "configured fleet."
        ),
        epilog="""examples:
  clilane
  clilane run codex-app -C ~/projects/sample-app -- codex
  clilane run kimi-research -C ~/projects/research -- kimi
  clilane list
  clilane fleet
  clilane status codex-app
  clilane attach codex-app

Only tasks started through clilane appear. Press Ctrl-Q in an agent to return to
the switcher.""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    root.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    commands = root.add_subparsers(dest="action")

    run = commands.add_parser(
        "run",
        help="start a managed task",
        description="Start a task in the background and return immediately.",
        usage=(
            "clilane run [OPTIONS] NAME [OPTIONS] -- COMMAND [ARG ...]\n"
            "       clilane run [OPTIONS] NAME [OPTIONS] --profile PROFILE"
        ),
    )
    run.add_argument("-C", "--cwd", metavar="DIR", help="task working directory")
    run.add_argument("--profile", metavar="PROFILE", help="clean launch profile name")
    run.add_argument("--wait", action="store_true", help="wait for the command to exit")
    run.add_argument("--timeout", metavar="SECONDS", help="timeout used with --wait")
    run.add_argument("--on-exit", metavar="COMMAND", help="shell command run after exit")
    run.add_argument(
        "run_arguments",
        metavar="ARG",
        nargs=argparse.REMAINDER,
        help="task name and raw command preceded by --, or a profile launch",
    )

    listing = commands.add_parser(
        "list", aliases=["ls", "ps"], help="list all managed tasks"
    )
    listing.add_argument("--json", action="store_true", help="emit JSON")

    fleet = commands.add_parser(
        "fleet",
        help="list managed tasks across configured SSH hosts",
        description="Read each configured host concurrently and return a fleet snapshot.",
    )
    fleet.add_argument(
        "--config",
        metavar="FILE",
        help=(
            "fleet config (default: $XDG_CONFIG_HOME/clilane/fleet.json or "
            "~/.config/clilane/fleet.json)"
        ),
    )
    fleet.add_argument(
        "--timeout",
        type=float,
        default=FLEET_DEFAULT_TIMEOUT,
        help=f"per-host timeout in seconds (default: {FLEET_DEFAULT_TIMEOUT:g})",
    )
    fleet.add_argument("--json", action="store_true", help="emit JSON")
    fleet.add_argument(
        "verb",
        nargs="?",
        choices=("status", "log"),
        help="read one remote task: status or log",
    )
    fleet.add_argument(
        "target",
        nargs="?",
        metavar="HOST:TASK",
        help="fleet host name and task name or ID prefix",
    )
    fleet.add_argument(
        "-n",
        "--lines",
        type=int,
        help="log lines to show with the log verb (default: 200)",
    )
    fleet.add_argument(
        "--watch", action="store_true", help="refresh the fleet table continuously"
    )
    fleet.add_argument(
        "--interval",
        type=float,
        help="refresh interval for --watch in seconds (default: 2)",
    )

    status = commands.add_parser("status", help="show one task in detail")
    status.add_argument("target", help="task name or ID prefix")
    status.add_argument("--json", action="store_true", help="emit JSON")

    attach = commands.add_parser("attach", help="attach to a task interactively")
    attach.add_argument("target", help="task name or ID prefix; Ctrl-Q opens switcher")

    hub = commands.add_parser("hub", help="open the native session switcher")
    hub.add_argument(
        "--config",
        help=(
            "hub presets file (default: $XDG_CONFIG_HOME/clilane/hub.json or "
            "~/.config/clilane/hub.json)"
        ),
    )

    read = commands.add_parser("read", help="print recent terminal output")
    read.add_argument("target", help="task name or ID prefix")
    read.add_argument("-a", "--all", action="store_true", help="print all scrollback")

    log = commands.add_parser("log", help="read the persistent task log")
    log.add_argument("target", help="task name or ID prefix")
    log.add_argument(
        "-n", "--lines", type=int, default=200, help="lines to show (default: 200)"
    )
    log.add_argument("-f", "--follow", action="store_true", help="follow new output")

    send = commands.add_parser("send", help="send text to a running task")
    send.add_argument("target", help="task name or ID prefix")
    send.add_argument("message", help="text to send")
    send.add_argument("--no-enter", action="store_true", help="do not press Enter")

    key = commands.add_parser(
        "key",
        help="press keys in a running task",
        description=(
            "Press one or more keys in a task's terminal, such as Enter, Escape, "
            "Up, Tab, BTab, or C-c."
        ),
        usage="clilane key TARGET KEY [KEY ...]",
    )
    key.add_argument("target", nargs="?", help="task name or ID prefix")
    key.add_argument("keys", metavar="KEY", nargs="*", help="key names to press in order")
    key.add_argument("--list", action="store_true", help="print supported key names")

    wait = commands.add_parser("wait", help="wait for a task to finish")
    wait.add_argument("target", help="task name or ID prefix")
    wait.add_argument("--timeout", type=float, help="timeout in seconds")

    stop = commands.add_parser("stop", help="stop a task without removing it")
    stop.add_argument("target", help="task name or ID prefix")
    stop.add_argument(
        "--grace", type=float, default=3, help="seconds before SIGKILL (default: 3)"
    )

    remove = commands.add_parser(
        "rm", aliases=["remove"], help="remove a stopped or completed task"
    )
    remove.add_argument("target", help="task name or ID prefix")
    remove.add_argument("--force", action="store_true", help="stop first if running")
    remove.add_argument(
        "--grace", type=float, default=3, help="seconds before SIGKILL (default: 3)"
    )

    clean = commands.add_parser(
        "clean",
        help="remove completed, stopped, and lost tasks",
        description=(
            "Remove completed and stopped tasks, and reclaim records left behind "
            "by an interrupted removal or a lost tmux server."
        ),
    )
    clean.add_argument(
        "--dry-run", action="store_true", help="report without removing anything"
    )
    clean.add_argument(
        "--orphans",
        action="store_true",
        help="also delete orphaned logs preserved from a lost tmux server",
    )

    orphans = commands.add_parser(
        "orphans",
        help="list tasks orphaned by a lost tmux server",
        description=(
            "List tasks whose tmux server died but whose logs survive. "
            "Read their logs with normal file tools; delete with 'clean --orphans'."
        ),
    )
    orphans.add_argument("--json", action="store_true", help="emit JSON")

    watch = commands.add_parser("watch", help="refresh the task list continuously")
    watch.add_argument(
        "--interval", type=float, default=1, help="refresh seconds (default: 1)"
    )

    return root


def parse_cli_arguments(parts: Sequence[str] | None = None) -> argparse.Namespace:
    arguments = list(sys.argv[1:] if parts is None else parts)
    if arguments and arguments[0] == "run":
        run_parts = arguments[1:]
        if run_parts in (["-h"], ["--help"]):
            return parser().parse_args(arguments)
        return argparse.Namespace(action="run", run_arguments=run_parts)
    return parser().parse_args(arguments)


def execute(arguments: argparse.Namespace) -> int:
    if arguments.action is None:
        return hub_command(None)
    if arguments.action == "run":
        request = parse_run_request(arguments.run_arguments)
        spec = resolve_run_request(request, os.environ, os.getcwd())
        task = run_task(spec)
        print(f"created {task.name} {task.id[:8]}")
        if spec.wait:
            return wait_task(task.id, spec.timeout)
        return 0
    if arguments.action in {"list", "ls", "ps"}:
        print_tasks(list_tasks(), arguments.json)
        return 0
    if arguments.action == "fleet":
        if arguments.interval is not None and not arguments.watch:
            raise CliLaneError("--interval requires --watch")
        if arguments.lines is not None and arguments.verb != "log":
            raise CliLaneError("--lines requires the log verb")
        if arguments.watch:
            if arguments.verb or arguments.json:
                raise CliLaneError("--watch takes no verb and no --json")
            interval = 2.0 if arguments.interval is None else arguments.interval
            return watch_fleet(arguments.config, arguments.timeout, interval)
        if arguments.verb:
            if not arguments.target:
                raise CliLaneError(
                    f"usage: {PROGRAM} fleet {arguments.verb} HOST:TASK"
                )
            if arguments.json:
                raise CliLaneError(
                    "fleet status and fleet log take no --json; "
                    "fleet status always emits JSON"
                )
            lines = 200 if arguments.lines is None else arguments.lines
            return fleet_verb(
                arguments.config,
                arguments.verb,
                arguments.target,
                lines,
                arguments.timeout,
            )
        hosts = load_fleet_hosts(arguments.config)
        return print_fleet_results(
            collect_fleet(hosts, arguments.timeout), arguments.json
        )
    if arguments.action == "status":
        print_status(resolve_task(arguments.target), arguments.json)
        return 0
    if arguments.action == "attach":
        return attach_task(resolve_task(arguments.target))
    if arguments.action == "hub":
        return hub_command(arguments.config)
    if arguments.action == "read":
        return read_task(resolve_task(arguments.target), arguments.all)
    if arguments.action == "log":
        return log_task(resolve_task(arguments.target), arguments.lines, arguments.follow)
    if arguments.action == "send":
        return send_task(arguments.target, arguments.message, not arguments.no_enter)
    if arguments.action == "key":
        if arguments.list:
            if arguments.target or arguments.keys:
                raise CliLaneError("--list takes no other arguments")
            return print_key_names()
        if not arguments.target:
            raise CliLaneError("missing task target")
        if not arguments.keys and is_key_name(arguments.target):
            raise CliLaneError(
                f"missing task target; usage: {PROGRAM} key TARGET KEY [KEY ...]"
            )
        return key_task(arguments.target, arguments.keys)
    if arguments.action == "wait":
        return wait_task(arguments.target, arguments.timeout)
    if arguments.action == "stop":
        task = stop_task(arguments.target, arguments.grace)
        print(f"{task.state} {task.name}")
        return 0
    if arguments.action in {"rm", "remove"}:
        task = remove_task(arguments.target, arguments.force, arguments.grace)
        print(f"removed {task.name}")
        return 0
    if arguments.action == "clean":
        return clean_tasks(arguments.dry_run, arguments.orphans)
    if arguments.action == "orphans":
        return print_orphans(arguments.json)
    if arguments.action == "watch":
        return watch_tasks(arguments.interval)
    raise CliLaneError(f"unknown action: {arguments.action}")


def main() -> int:
    try:
        if len(sys.argv) == 5 and sys.argv[1] == "__supervise":
            configure_tmux_control(sys.argv[2], sys.argv[3])
            return supervise(sys.argv[4])
        if len(sys.argv) == 3 and sys.argv[1] == "__supervise":
            return supervise(sys.argv[2])
        if len(sys.argv) == 7 and sys.argv[1] == "__hub-register":
            configure_tmux_control(sys.argv[2], sys.argv[3])
            return hub_register(sys.argv[4], sys.argv[5], sys.argv[6])
        if len(sys.argv) == 5 and sys.argv[1] == "__hub-register":
            return hub_register(sys.argv[2], sys.argv[3], sys.argv[4])
        if len(sys.argv) == 8 and sys.argv[1] == "__hub-forget":
            configure_tmux_control(sys.argv[2], sys.argv[3])
            return hub_forget(sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7])
        if len(sys.argv) == 6 and sys.argv[1] == "__hub-forget":
            return hub_forget(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
        if len(sys.argv) == 8 and sys.argv[1] == "__hub-open":
            configure_tmux_control(sys.argv[2], sys.argv[3])
            return hub_open(sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7])
        if len(sys.argv) == 6 and sys.argv[1] == "__hub-open":
            return hub_open(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
        if len(sys.argv) == 7 and sys.argv[1] == "__hub-ui":
            configure_tmux_control(sys.argv[2], sys.argv[3])
            return hub_ui(sys.argv[4], sys.argv[5], sys.argv[6])
        if len(sys.argv) == 5 and sys.argv[1] == "__hub-ui":
            return hub_ui(sys.argv[2], sys.argv[3], sys.argv[4])
        if len(sys.argv) == 7 and sys.argv[1] == "__log":
            configure_tmux_control(sys.argv[2], sys.argv[3])
            max_bytes = optional_int(sys.argv[5])
            if max_bytes is None:
                raise CliLaneError("invalid log size")
            return sink_log(sys.argv[4], max_bytes, sys.argv[6])
        if len(sys.argv) == 5 and sys.argv[1] == "__log":
            max_bytes = optional_int(sys.argv[3])
            if max_bytes is None:
                raise CliLaneError("invalid log size")
            return sink_log(sys.argv[2], max_bytes, sys.argv[4])
        return execute(parse_cli_arguments())
    except CliLaneError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        return 1
    except FleetSignal as error:
        return 128 + error.signum
    except OSError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
